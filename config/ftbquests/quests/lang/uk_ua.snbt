  ]
  "quest.2FB92A24ABE5ABB2.title": "Камінь душі"
  "quest.2FB92A24ABE5ABB2.quest_desc": [
    "Отримайте складники й виконайте відповідне перетворення або ритуал зі словника духів. Звірте крейду, чаші, свічки та прив’язану книгу; результат визначається рецептом пентакля, а не лише набором предметів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3FB069E40DBDC76D.title": "Потойбічні окуляри"
  "quest.3FB069E40DBDC76D.quest_desc": [
    "Підготуйте магічний інструмент і перевірте його дію під час дослідження. Він допомагає бачити або знаходити приховані матеріали; умови використання пояснює словник духів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1FE198B806ACAE27.title": "Ієснієва руда"
  "quest.1FE198B806ACAE27.quest_desc": [
    "Отримайте складники й виконайте відповідне перетворення або ритуал зі словника духів. Звірте крейду, чаші, свічки та прив’язану книгу; результат визначається рецептом пентакля, а не лише набором предметів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3B539F0BBE8DE914.title": "Ієснієва кирка"
  "quest.3B539F0BBE8DE914.quest_desc": [
    "Цей інструмент призначений для доступу до ресурсів Іншосвіту. Перевірте необхідний рівень добування й умови зору; звичайний вигляд руди може відрізнятися від того, що бачить підготовлений маг."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.59975E3A666E7001.title": "Вимірна шахта"
  "quest.59975E3A666E7001.quest_desc": [
    "Підготуйте вимірну шахту та сумісного духа-добувача. Під’єднайте виведення, перевірте рівень духа й доступні результати. Накопичення предметів без виходу зупинить роботу. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.181F431B3FAA715E.title": "Вимірна кристалічна матриця"
  "quest.181F431B3FAA715E.quest_desc": [
    "Це частина магічної системи зберігання Occultism. Зберіть сумісну конструкцію за словником, перевірте місткість і прив’язку. Віддалений доступ та розширення потребують окремих компонентів. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5D64D9F8DF84A71E.title": "База стабілізатора вимірного зберігання"
  "quest.5D64D9F8DF84A71E.quest_desc": [
    "Це частина магічної системи зберігання Occultism. Зберіть сумісну конструкцію за словником, перевірте місткість і прив’язку. Віддалений доступ та розширення потребують окремих компонентів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1B8B70274BD2DC89.title": "Жезл ворожіння"
  "quest.1B8B70274BD2DC89.quest_desc": [
    "Підготуйте магічний інструмент і перевірте його дію під час дослідження. Він допомагає бачити або знаходити приховані матеріали; умови використання пояснює словник духів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.43AF0B4986EDFAC3.title": "Стабільна червоточина"
  "quest.43AF0B4986EDFAC3.quest_desc": [
    "Отримайте складники й виконайте відповідне перетворення або ритуал зі словника духів. Звірте крейду, чаші, свічки та прив’язану книгу; результат визначається рецептом пентакля, а не лише набором предметів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5FA2F024307D10A2.title": "Духи-фамільяри"
  "quest.5FA2F024307D10A2.quest_desc": [
    "Призвіть обраного фамільяра за словником духів і ознайомтеся з його дією. Фамільяри не є взаємозамінними з духами для виробничої роботи. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4FF75302F493FF4D.title": "Ритуал: Примарний примус Езівеуса"
  "quest.4FF75302F493FF4D.quest_desc": [
    "Підготуйте наведені складники для відповідного пентакля зі словника духів. Правильно розкладіть крейду, свічки та чаші, додайте потрібну зв’язану книгу й виконайте ритуал. Наявність складників не підтверджує його запуск."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.77DB026C7A5E8888.title": "Ніж м'ясника"
  "quest.77DB026C7A5E8888.quest_desc": [
