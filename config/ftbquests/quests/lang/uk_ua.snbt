  ]
  "quest.3D42442FBFCAEDA5.title": "Фабрики: Очищення киснем"
  "quest.3D42442FBFCAEDA5.quest_desc": [
    "Пройдіть чотири рівні фабрики послідовними комплектами оновлення або доступними рецептами. Налаштуйте сортування входів, живлення та виходи; кількість одночасних процесів зростає з рівнем."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.402F62C2650AB859.title": "Фабрики: Хімічна ін’єкція"
  "quest.402F62C2650AB859.quest_desc": [
    "Пройдіть чотири рівні фабрики послідовними комплектами оновлення або доступними рецептами. Налаштуйте сортування входів, живлення та виходи; кількість одночасних процесів зростає з рівнем."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4CD8A43F9CA2BFE2.title": "Три рівні сплавів"
  "quest.4CD8A43F9CA2BFE2.quest_desc": [
    "Підведіть FE до машини, налаштуйте боки вводу й виводу та автоматичне виштовхування. Пробний рецепт і витрати перевірте у JEI. Потужність фабрики потребує відповідного живлення й підведення ресурсів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0CC0C7EE98E08E5D.title": "Прискорення та економія енергії"
  "quest.0CC0C7EE98E08E5D.quest_desc": [
    "Підведіть FE до машини, налаштуйте боки вводу й виводу та автоматичне виштовхування. Пробний рецепт і витрати перевірте у JEI. Потужність фабрики потребує відповідного живлення й підведення ресурсів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.504F86C1D8FD8910.title": "Логістика механічного заводу"
  "quest.504F86C1D8FD8910.quest_desc": [
    "Підведіть FE до машини, налаштуйте боки вводу й виводу та автоматичне виштовхування. Пробний рецепт і витрати перевірте у JEI. Потужність фабрики потребує відповідного живлення й підведення ресурсів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4B24F1F48D1EE4AB.title": "Mekanism Tools: промислові інструменти"
  "quest.4B24F1F48D1EE4AB.quest_desc": [
    "Підведіть FE до машини, налаштуйте боки вводу й виводу та автоматичне виштовхування. Пробний рецепт і витрати перевірте у JEI. Потужність фабрики потребує відповідного живлення й підведення ресурсів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.40658012EE8B0309.title": "Камінь, гравій і пісок"
  "quest.40658012EE8B0309.quest_desc": [
    "Налаштуйте ланцюжки Material StoneWork Factory для потрібних матеріалів. Зі стабільними входами та FE ця машина створює ресурси без виснаження покладу."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6ABF646907823436.title": "Деревина та саджанці"
  "quest.6ABF646907823436.quest_desc": [
    "Висаджуйте й збирайте дерева автоматично, повертайте саджанці до сіяча. Відводьте деревину та надлишок саджанців до окремих запасів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.46D741C302332F13.title": "Відновлюваний латекс"
  "quest.46D741C302332F13.quest_desc": [
    "Поставте автоматичне підкладання колод до екстрактора. Лісова ферма поповнює колоди, екстрактор дає латекс, а Latex Processing Unit — гуму для пластику."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.03B0CFC1EB635F73.title": "Лазерна руда без виснаження"
  "quest.03B0CFC1EB635F73.quest_desc": [
    "Поставте рудну лазерну базу й спрямовані на неї бури. Налаштуйте висоту та лінзи за JEI. Машина створює рудні ресурси за енергію, а не вибирає блоки навколо."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1F7C1793B02B65CC.title": "Вибір ресурсу лінзами"
  "quest.1F7C1793B02B65CC.quest_desc": [
    "Лінзи змінюють розподіл ресурсів, а висота та біом можуть впливати на доступні результати. Перевірте саме вашу руду у вкладці лазерного добування JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.426A848F4A5E4027.title": "Кар’єр і Digital Miner — окрема гілка"
  "quest.426A848F4A5E4027.quest_desc": [
    "Цифровий шахтар і кар’єри MI ефективно збирають наявні поклади. Для тривалого потоку переносіть їх у нові зони або використовуйте лазери IF, ферми й інші генератори."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5AD516DF0A1510FD.title": "Ліміти складу та зупинка"
  "quest.5AD516DF0A1510FD.quest_desc": [
    "Зв’яжіть запас ресурсу з редстоуновим керуванням добуванкою. Перевірте поведінку при переповненому сховищі, втраті FE та відновленні подачі."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3CA15EF71EBDE167.title": "Фабрика працює без виснаження"
  "quest.3CA15EF71EBDE167.quest_desc": [
    "Запустіть ліс, латекс і лазерну руду, відведіть продукти до ME та дочекайтеся поповнення запасів. Перевірте повернення саджанців і вимкнення при досягненні ліміту. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7B161B722A273D89.title": "ExtendedAE: нескінченна комірка води"
  "quest.7B161B722A273D89.quest_desc": [
    "Виготовте комірку за її штатним рецептом і підключіть до ME. Її спеціалізація — відповідна вода або кругляк; вона не створює довільні ресурси."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.46894F6AF764890A.title": "ExtendedAE: нескінченна комірка кругляку"
  "quest.46894F6AF764890A.quest_desc": [
    "Виготовте комірку за її штатним рецептом і підключіть до ME. Її спеціалізація — відповідна вода або кругляк; вона не створює довільні ресурси."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.73D85FEFE2C9C7B2.title": "Перевірка: вода з ME без перебоїв"
  "quest.73D85FEFE2C9C7B2.quest_desc": [
    "Установіть нескінченну комірку води ExtendedAE в ME й налаштуйте виведення води шиною експорту. Перевірте безперервне постачання машини; окремий мод MEInfinityCell більше не потрібний. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3DD85CCDAA4A3BC1.title": "Перевірка: кругляк на замовлення"
  "quest.3DD85CCDAA4A3BC1.quest_desc": [
    "Установіть нескінченну комірку кругляку ExtendedAE. Замовте оброблення кругляку зовнішньою машиною та перевірте повернення результату до ME; довільні ресурси ця комірка не створює. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0F2016E1FF580027.title": "Extended Industrialization: фермерство"
  "quest.0F2016E1FF580027.quest_desc": [
    "Підведіть енергію та потрібні входи; рецепти й робочі області звірте з MI та JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7A3295F0CB2AC9C1.title": "Extended Industrialization: добування й перероблення"
  "quest.7A3295F0CB2AC9C1.quest_desc": [
    "Розвивайте електричну переробку MI паралельно з ME-логістикою. Кар’єрна гілка використовує ресурси світу."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1EF94792406F3C62.title": "Industrialization Overdrive: масиви"
  "quest.1EF94792406F3C62.quest_desc": [
    "Зберіть масив оброблення та налаштуйте його через термінал. Не перевищуйте доступну потужність енергомережі."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.33515F869B0972AD.title": "Налаштування фабрики MI"
  "quest.33515F869B0972AD.quest_desc": [
    "Використайте штатні пристрої копіювання конфігурації й з’єднання машин. Перевірте фільтри та напрямки після копіювання."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.15E746D1DE56047D.title": "MIFA: швидкість"
  "quest.15E746D1DE56047D.quest_desc": [
    "Послідовно виготовляйте сумісні модифікатори за рецептами JEI. Перевіряйте вимоги до рівня машини та зростання споживання FE."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5F66A27B7C002C43.title": "MIFA: ефективність"
  "quest.5F66A27B7C002C43.quest_desc": [
    "Послідовно виготовляйте сумісні модифікатори за рецептами JEI. Перевіряйте вимоги до рівня машини та зростання споживання FE."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3891D1046EA498C4.title": "MIFA: оброблення"
  "quest.3891D1046EA498C4.quest_desc": [
    "Послідовно виготовляйте сумісні модифікатори за рецептами JEI. Перевіряйте вимоги до рівня машини та зростання споживання FE."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1A021992DECE8D9C.title": "Mekanism Extras: схеми"
  "quest.1A021992DECE8D9C.quest_desc": [
    "Це додаткова пізня гілка. Застосовуйте штатні рецепти та вимоги до попередніх рівнів, підведіть достатню енергію й відповідні реагенти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6E94B93F84CD691A.title": "Mekanism Extras: сплави"
  "quest.6E94B93F84CD691A.quest_desc": [
    "Це додаткова пізня гілка. Застосовуйте штатні рецепти та вимоги до попередніх рівнів, підведіть достатню енергію й відповідні реагенти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6E6BA2D3D99ED631.title": "Mekanism Extras: плавильні фабрики"
  "quest.6E6BA2D3D99ED631.quest_desc": [
    "Це додаткова пізня гілка. Застосовуйте штатні рецепти та вимоги до попередніх рівнів, підведіть достатню енергію й відповідні реагенти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.15A6DD3E3436B8FD.title": "Mekanism Extras: окиснення"
  "quest.15A6DD3E3436B8FD.quest_desc": [
    "Це додаткова пізня гілка. Застосовуйте штатні рецепти та вимоги до попередніх рівнів, підведіть достатню енергію й відповідні реагенти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0017394A4411D5E2.title": "Mekanism Extras: наквадаховий реактор"
  "quest.0017394A4411D5E2.quest_desc": [
    "Це додаткова пізня гілка. Застосовуйте штатні рецепти та вимоги до попередніх рівнів, підведіть достатню енергію й відповідні реагенти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.724750D01AE7B466.title": "More Mekanism Machines: окиснення"
  "quest.724750D01AE7B466.quest_desc": [
    "Це додаткова пізня гілка. Застосовуйте штатні рецепти та вимоги до попередніх рівнів, підведіть достатню енергію й відповідні реагенти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.139AC58BE6BFCBEC.title": "More Mekanism Machines: хімічне змішування"
  "quest.139AC58BE6BFCBEC.quest_desc": [
    "Це додаткова пізня гілка. Застосовуйте штатні рецепти та вимоги до попередніх рівнів, підведіть достатню енергію й відповідні реагенти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.180F417AFD79A9C2.title": "Білий пластиковий блок"
  "quest.180F417AFD79A9C2.quest_desc": [
    "Додаткова гілка після переходу в етап 3. Використайте полімери або промислові компоненти відповідно до рецепта; налаштуйте живлення та входи."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.72B5EAB7D1D5DD27.title": "Біла куля"
  "quest.72B5EAB7D1D5DD27.quest_desc": [
    "Додаткова гілка після переходу в етап 3. Використайте полімери або промислові компоненти відповідно до рецепта; налаштуйте живлення та входи."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.217E467CE9748EC4.title": "Біла сяюча панель"
  "quest.217E467CE9748EC4.quest_desc": [
    "Додаткова гілка після переходу в етап 3. Використайте полімери або промислові компоненти відповідно до рецепта; налаштуйте живлення та входи."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2F38C4569C98BF06.title": "Ядерний реактор"
  "quest.2F38C4569C98BF06.quest_desc": [
    "Додаткова гілка після переходу в етап 3. Використайте полімери або промислові компоненти відповідно до рецепта; налаштуйте живлення та входи."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6AA3CB46E3137D1C.title": "Термоядерний реактор"
  "quest.6AA3CB46E3137D1C.quest_desc": [
    "Додаткова гілка після переходу в етап 3. Використайте полімери або промислові компоненти відповідно до рецепта; налаштуйте живлення та входи."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.375E076623132988.title": "Гравітаційний модуль: вільний політ"
  "quest.375E076623132988.quest_desc": [
    "Штатний рецепт використовує три гранули антиматерії, абсолютні постачальники індукції, зірку Незеру, атомний сплав і основу модуля. Установіть модуль у нагрудник MekaSuit через станцію модифікації та увімкніть гравітаційний режим. Потрібне живлення нагрудника."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.064B6432FBECFFB7.title": "Перевірка польоту MekaSuit"
  "quest.064B6432FBECFFB7.quest_desc": [
    "Зарядіть нагрудник, установіть модуль і ввімкніть політ у налаштуваннях спорядження. Перевірте підйом, зависання, переміщення та споживання енергії. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0617FA65912CEE96.title": "Gravitational Modulating Additional Unit"
  "quest.0617FA65912CEE96.quest_desc": [
    "Додатковий модуль доповнює базову гравітаційну систему. Застосуйте його штатний рецепт із полонієм і перевірте сумісність установлених модулів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7745B580F5917CAD.title": "Nature’s Compass: пошук біомів"
  "quest.7745B580F5917CAD.quest_desc": [
    "Відкрийте меню компаса, виберіть потрібний біом і почніть пошук. Компас показує напрямок і відстань до знайденої цілі."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0C387803F8BF9847.title": "Cognition: сховище досвіду"
  "quest.0C387803F8BF9847.quest_desc": [
    "Обеліск зберігає досвід і підбирає сфери поблизу. Перевірте внесення й отримання досвіду через його інтерфейс."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2E163280C7FFBAC4.title": "Жезл налаштування"
  "quest.2E163280C7FFBAC4.quest_desc": [
    "Жезл пов’язує й налаштовує блоки Cognition. Прив’яжіть сумісний пристрій до обеліска."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.53557F1ABC674183.title": "Бібліофаг і досвід із полиць"
  "quest.53557F1ABC674183.quest_desc": [
    "Заражайте сумісні книжкові полиці бібліофагом. Вони поступово розкладаються й дають досвід; для тривалої ферми потрібне поповнення полиць."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.771992BDDC36C8F5.title": "Молекулярний метаморфатор"
  "quest.771992BDDC36C8F5.quest_desc": [
    "Прив’яжіть машину до обеліска й виконайте пробний рецепт перетворення. Вона споживає досвід; запас обеліска слід контролювати."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.20F33356CA263021.title": "Дистанційний доступ до досвіду"
  "quest.20F33356CA263021.quest_desc": [
    "Прив’яжіть планшет до обеліска та перевірте доступ до збереженого досвіду."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.57ADCF93AE97D29D.title": "Фонтан досвіду"
  "quest.57ADCF93AE97D29D.quest_desc": [
    "Прив’яжіть фонтан до обеліска та налаштуйте швидкість видавання сфер. Передбачте збирання досвіду або вимкнення фонтану."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2932041A152BBFAA.title": "Вибіркове зняття чарів"
  "quest.2932041A152BBFAA.quest_desc": [
    "Перевірте вибіркове видалення чарів або проклять на непотрібному предметі. Прочитайте інтерфейс перед застосуванням до спорядження."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.772C1058FA6B6F27.title": "Матеріали Cognition"
  "quest.772C1058FA6B6F27.quest_desc": [
    "Використайте рецепти метаморфатора та інші доступні способи JEI. Забезпечте запас досвіду та відведення готових матеріалів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.40C72FAA3109B036.title": "Електрика для фабрики"
  "quest.40C72FAA3109B036.quest_desc": [
    "Підведіть стабільні FE з етапу 1. У цьому маршруті ви створите ME-мережу, автоматизуєте процесори та запустите відновлювану добуванку."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6B654E77F2BA3173.title": "Кварц і флюїкс"
  "quest.6B654E77F2BA3173.quest_desc": [
    "Підготуйте матеріали AE2. Налаштуйте заряджання й отримання флюїксу за доступними рецептами."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5678A6F4A4F1F9A8.title": "Перші процесори вручну"
  "quest.5678A6F4A4F1F9A8.quest_desc": [
    "Перші три процесори потрібні для початкових компонентів ME. Автоматизація буде наступним кроком, тому готова ME-фабрика для них не потрібна."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5C4456F742D6CD36.title": "ME-сховище з живленням"
  "quest.5C4456F742D6CD36.quest_desc": [
    "З’єднайте пристрої кабелем, подайте FE й переконайтеся, що термінал бачить предмети комірки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1CFB065A5BF0DA7C.title": "Автокрафт і шаблони"
  "quest.1CFB065A5BF0DA7C.quest_desc": [
    "Зберіть Crafting CPU, закодуйте простий шаблон і замовте предмет. Зовнішні машини використовуватимуть шаблони оброблення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7120AB0E5DE2B6CE.title": "П’ять висікачів для процесорів"
  "quest.7120AB0E5DE2B6CE.quest_desc": [
    "Чотири машини друкують кремній і три типи схем, п’ята складає процесор. Преси залишаються в машинах; виходи повертаються до ME."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.38C31B8E11A8BC4A.title": "Партії трьох процесорів"
  "quest.38C31B8E11A8BC4A.quest_desc": [
    "Налаштуйте шаблони друку й складання та замовте три партії. Докладна схема є в главі 2.1."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.43A3DB786A71DFE3.title": "Перевірка фабрики процесорів"
  "quest.43A3DB786A71DFE3.quest_desc": [
    "Замовте три процесори з однієї сировини в ME. Перевірте автоматичне виконання й повернення результатів без переставляння пресів. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.76D688B547CCB7E8.title": "Латекс і пластик Industrial Foregoing"
  "quest.76D688B547CCB7E8.quest_desc": [
    "Поставте екстрактор до колод, переробіть латекс із водою на гуму й виплавте пластик. Це пластик для ранніх машин IF; HDPE Mekanism буде в етапі 3."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.523EF5A13A92ABA1.title": "Розчинення та каркаси"
  "quest.523EF5A13A92ABA1.quest_desc": [
    "Налаштуйте камеру розчинення. Простий каркас виготовляється з латексом; його машини відкривають рожевий слиз і наступний рівень."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5B79FBE9466ADD0F.title": "Рожевий слиз і просунутий каркас"
  "quest.5B79FBE9466ADD0F.quest_desc": [
    "Отримайте рожевий слиз на фермі та виготовте просунутий каркас за рецептом камери розчинення. Відводьте і слиз, і рідке м’ясо."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4236D85F89629A4B.title": "Лазерне створення руд"
  "quest.4236D85F89629A4B.quest_desc": [
    "З’єднайте рудну лазерну базу з бурами, підведіть FE й відведіть продукт у ME. Перевірте висоту й доступну руду в JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4D52BCA02963EAE4.title": "Відновлюваний потік до ME"
  "quest.4D52BCA02963EAE4.quest_desc": [
    "Перевірте, що лазерна установка поповнює запас, а ME зупиняє її при досягненні ліміту. Руду створює IF; кар’єри й Digital Miner добувають скінченні поклади. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.26A4B67F915D27BE.title": "Компоненти електричного MI"
  "quest.26A4B67F915D27BE.quest_desc": [
    "Розвиньте електричне виробництво MI до електронної схеми й алюмінієвого бура. Докладна послідовність є в главі 2.3."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7A4543C00536D18E.title": "Промисловий блок Mekanism"
  "quest.7A4543C00536D18E.quest_desc": [
    "Об’єднайте електричний ключ, схеми MI, алюмінієвий бур та інженерний процесор. Цей проміжний компонент відкриває машини Mekanism усередині етапу 2."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5EDC25E7AA4B080A.title": "Механічна лінія Mekanism"
  "quest.5EDC25E7AA4B080A.quest_desc": [
    "Виділіть машини для сплавів та оброблення. Налаштуйте предметні боки, інфузійні матеріали й живлення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7150AFDAF47F69FB.title": "Збагачений, посилений та атомний сплав"
  "quest.7150AFDAF47F69FB.quest_desc": [
    "Послідовно розвивайте редстоунову, алмазну й обсидіанову гілки наповнювачів. Складні газові лінії ще не потрібні."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6E67823FD52A889F.title": "Абсолютна схема"
  "quest.6E67823FD52A889F.quest_desc": [
    "Автоматизуйте базові, просунуті, елітні й абсолютні схеми. Перевірте підзамовлення сплавів через AE2."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5A3BE9F6C8007C54.title": "Фабрика готова до хімії"
  "quest.5A3BE9F6C8007C54.quest_desc": [
    "Перевірте три процесори AE2, надходження ресурсів IF та замовлення сплавів Mekanism. Для переходу не потрібно завершувати всі додаткові моди або фабрики. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7D74A7AFFB0DF4A7.title": "Ключ до хімії"
  "quest.7D74A7AFFB0DF4A7.quest_desc": [
    "Етап 3 об’єднує хімічні лінії, поліетилен, ядерне виробництво й MekaSuit. Забезпечте окремі резервуари для кожної речовини."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2FFC3A28CDAABE8C.title": "Кисень та водень"
  "quest.2FFC3A28CDAABE8C.quest_desc": [
    "Розділіть воду та налаштуйте обидва хімічні виходи. Заповнений побічний резервуар не повинен блокувати основну лінію."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.42F924B2E522235B.title": "Поліетилен Mekanism"
  "quest.42F924B2E522235B.quest_desc": [
    "Пройдіть біопаливо → субстрат та етилен → рідкий етилен → HDPE. Налаштуйте реакційну камеру, кисень і побічні продукти."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.58957B16A080342C.title": "Підготовка ядерного палива"
  "quest.58957B16A080342C.quest_desc": [
    "Підготуйте уранову та фторну хімію й доведіть лінію до розщеплюваного палива. Рецепти та входи машин дивіться у JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.165CE84362CFB47F.title": "Захист, охолодження та відходи"
  "quest.165CE84362CFB47F.quest_desc": [
    "Підготуйте повний комплект, безперервне охолодження та зберігання відходів до запуску реактора."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6802400E80B653D9.title": "Реактор поділу і турбіна"
  "quest.6802400E80B653D9.quest_desc": [
    "Зберіть і перевірте обидві конструкції. Докладні вузли, порти й керування розкриті в главі 3.2."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.59C728F7911579A7.title": "Полоній для спорядження"
  "quest.59C728F7911579A7.quest_desc": [
    "Переробіть ядерні відходи через сонячний нейтронний активатор і завершіть виготовлення гранул."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4A9740C589F64A41.title": "Повний комплект MekaSuit"
  "quest.4A9740C589F64A41.quest_desc": [
    "Виготовте та зарядіть усі чотири частини. Політ вимагатиме гравітаційного модуля."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3E03511DC4D03847.title": "SPS і стабільне живлення"
  "quest.3E03511DC4D03847.quest_desc": [
    "Подайте полоній і енергію до правильно зібраного SPS. Термоядерна генерація — окрема потужна гілка, а не обов’язкова умова самої конструкції SPS."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.55E88A427D1A1496.title": "Три гранули антиматерії"
  "quest.55E88A427D1A1496.quest_desc": [
    "Отримайте антиматерію в SPS та сформуйте гранули реакційною камерою за рецептом JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.383072671C5D2536.title": "Гравітаційний політ"
  "quest.383072671C5D2536.quest_desc": [
    "Установіть гравітаційний модуль у нагрудник MekaSuit через станцію модифікації. Зарядіть нагрудник і ввімкніть модуль."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6081E204C6EB62AB.title": "Фінал: політ над власною фабрикою"
  "quest.6081E204C6EB62AB.quest_desc": [
    "Перевірте зависання та вільний політ, роботу живлення MekaSuit і стабільність фабрики під час відльоту. Завантажувачі чанків налаштовуються окремо. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
