  ]
  "quest.37AF190FA5D5CB4A.title": "Чаклунський том Вогню"
  "quest.37AF190FA5D5CB4A.quest_desc": [
    "Чаклунський том доповнює роботу зі стихією. Прочитайте його властивості та перевірте сумісність із вибраними заклинаннями."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.247C3E514FA4F982.title": "Мішечок аксесуарів"
  "quest.247C3E514FA4F982.quest_desc": [
    "Мішечок упорядковує магічні аксесуари. Перевірте слот, спосіб відкриття й доступ до вмісту."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6ACF9C80C7C29489.title": "Торба заклинача"
  "quest.6ACF9C80C7C29489.quest_desc": [
    "Торба допомагає зберігати інструменти чарівника. Розкладіть потрібні предмети й перевірте доступ у роботі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3BE2AA3C48F3EB01.title": "Вдосконалена чаклунська призма"
  "quest.3BE2AA3C48F3EB01.quest_desc": [
    "Налаштуйте призму та сумісні лінзи для потрібного способу застосування заклинання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.78361629FAF8D7A6.title": "Урна нескінченних вод"
  "quest.78361629FAF8D7A6.quest_desc": [
    "Перевірте спосіб роботи урни й сумісний рідинний вихід. Це допоміжна гілка майстерні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5FCA5968C5BD9BE1.title": "Фокус Некромантії"
  "quest.5FCA5968C5BD9BE1.quest_desc": [
    "Фокус відкриває спеціалізацію Еґо. Ознайомтеся з його окремими можливостями й умовами застосування в записнику."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7DA1B1CAAD95976F.title": "Рідини замість предметів"
  "quest.7DA1B1CAAD95976F.quest_desc": [
    "Навчіть старбункула працювати з рідинами за допомогою сумісного спорядження. Вкажіть джерело та приймач і перевірте перенесення невеликого обсягу."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.644B220CFAA2716C.title": "Банка для рідин"
  "quest.644B220CFAA2716C.quest_desc": [
    "Поставте рідинну банку й перевірте місткість та спосіб підключення. Це окремий резервуар, а не звичайна банка Source."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4D0D73950F3CDEB2.title": "Дозволені рідини"
  "quest.4D0D73950F3CDEB2.quest_desc": [
    "Налаштуйте список дозволених рідин для помічника. Перевірте, що стороння рідина не потрапляє до вашої виробничої лінії."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6F7A09EAC9918AE4.title": "Заборонені рідини"
  "quest.6F7A09EAC9918AE4.quest_desc": [
    "Використайте список заборон, коли слід відкинути певні рідини. Не задавайте суперечливі правила дозволу й заборони."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.41A8213F0704043F.title": "Перенесення енергії"
  "quest.41A8213F0704043F.quest_desc": [
    "Перевірте можливості енергетичного спорядження старбункула й сумісність приймача. Джерело FE та Source є різними системами, автоматичного перетворення не припускайте."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7AB27F66DB636186.title": "Старбункул-добувач"
  "quest.7AB27F66DB636186.quest_desc": [
    "Задайте робочу область і вихід ресурсів для помічника-добувача. Він працює з блоками світу; сам по собі не створює нескінченні поклади."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.79E9370DA57812BF.title": "Старбункул-будівельник"
  "quest.79E9370DA57812BF.quest_desc": [
    "Налаштуйте будівельну роботу та запас матеріалів. Спочатку випробуйте невеликий фрагмент, щоб перевірити напрямок і розміщення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.322D429DEBD1004D.title": "Бойовий помічник"
  "quest.322D429DEBD1004D.quest_desc": [
    "Спорядьте сумісного помічника для бойової роботи. Перевірте вибір цілей і місце відведення здобичі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4C50CF1A9B31ED24.title": "Прибирання надлишків"
  "quest.4C50CF1A9B31ED24.quest_desc": [
    "Організуйте контроль зайвих предметів. Перш ніж використовувати утилізацію, переконайтеся, що потрібні матеріали не потраплять до неї."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.512871418D2EA9DD.title": "Рідинний Source"
  "quest.512871418D2EA9DD.quest_desc": [
    "Ознайомтеся з конденсатором та його рідинним виходом. Подальші операції перевіряйте за рецептами й можливостями встановленого аддона."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.420B27ED0B34B005.title": "Генерація від рідин"
  "quest.420B27ED0B34B005.quest_desc": [
    "Перевірте доступні рідини та вихід Source у JEI. Налаштуйте стабільне подавання і достатньо місця для магічного запасу."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3E6A90FE9433B478.title": "Помічник кухаря"
  "quest.3E6A90FE9433B478.quest_desc": [
    "Використайте капелюх шеф-кухаря для сумісної роботи з їжею. За наявності кухонних інтеграцій перевірте потрібний пристрій і правила постачання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.52D189DB50E1BF9A.title": "Розвиток дриґмі"
  "quest.52D189DB50E1BF9A.quest_desc": [
    "Ознайомтеся з додатковим спорядженням дриґмі. Підготуйте його звичайну систему роботи та перевірте вплив аддона за посібником."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.540E861872BF89A3.title": "Подорожі з помічниками"
  "quest.540E861872BF89A3.quest_desc": [
    "Перевірте застосування сідла на сумісному помічнику. Для проходження основного маршруту транспортна гілка не обов’язкова."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1E0E48F900DF2FF7.title": "Жертовний вівтар Ars Ocultas"
  "quest.1E0E48F900DF2FF7.quest_desc": [
    "Зберіть вівтар за рецептом. Це міст між ритуалами Occultism і ресурсами Ars; конкретну підтримувану операцію перевіряйте в розділі Ars Ocultas потертої книги."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7BA6397D630B8B47.title": "Утримання духа"
  "quest.7BA6397D630B8B47.quest_desc": [
    "Підготуйте ритуал утримання та потрібного духа. Працюйте зі сумісним типом істоти й банкою Ars, звіряючи умови в записнику."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5D9C2B364F2AC075.title": "Дух у банці"
  "quest.5D9C2B364F2AC075.quest_desc": [
    "Помістіть духа Occultism у банку. Тип духа визначає можливу роботу; сама порожня банка нічого не обробляє."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3AA3D4D83EACE34B.title": "Логістика банок"
  "quest.3AA3D4D83EACE34B.quest_desc": [
    "Під’єднайте подавання матеріалів до банки помічником, лійкою або сумісним предметним каналом. Перевірте, що обраний дух виконує потрібне перетворення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.452EBBA81BB666C4.title": "Автоматичне оброблення духом"
  "quest.452EBBA81BB666C4.quest_desc": [
    "Подайте матеріал до банки із сумісним духом, дочекайтеся оброблення та відведіть результат до інвентарю. Для духа-прибиральника перевірте спеціальне виведення в інвентар зверху. Підтвердіть роботу власноруч."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2E7B634E5C45A65D.title": "Спавнер"
  "quest.2E7B634E5C45A65D.quest_desc": [
    "Підготуйте наведені складники й виконайте практичну дію з описаної гілки. Кількості та сумісність перевірте у встановленому рецепті JEI та внутрішньому посібнику мода."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.624243DC929A2EF1.title": "Руна вічних сутінків"
  "quest.624243DC929A2EF1.quest_desc": [
    "Використайте цю руну або модифікатор на сумісному спавнері. Перевірте змінюваний параметр, обмеження рівня світу та спосіб скасування ефекту в довіднику. Прямі модифікатори старих версій можуть бути замінені рунами."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.56885F1339417034.title": "Руна остовпіння"
  "quest.56885F1339417034.quest_desc": [
    "Використайте цю руну або модифікатор на сумісному спавнері. Перевірте змінюваний параметр, обмеження рівня світу та спосіб скасування ефекту в довіднику. Прямі модифікатори старих версій можуть бути замінені рунами."
