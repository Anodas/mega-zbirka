  ]
  "quest.51208E0705B4C4BD.title": "Мантія геоманта"
  "quest.51208E0705B4C4BD.quest_desc": [
    "§eКомплект: 4 предм., броня 18, твердість 6."
    "§7Частини: Капелюх геоманта, Мантія геоманта, Штани німфи, Взуття німфи."
