  "quest.325F9270965B3B22.title": "Жезл панування"
  "quest.325F9270965B3B22.quest_desc": [
    "Жезл домініону задає зв’язки й роботу помічників. Налаштуйте цільові блоки, сховище та джерело за підказками внутрішнього довідника."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.78E38FDD6F34C6D0.title": "Чарівничий меч"
  "quest.78E38FDD6F34C6D0.quest_desc": [
