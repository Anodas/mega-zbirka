  ]
  "quest.2839594CD6B98AA7.title": "Залізний ніж"
  "quest.2839594CD6B98AA7.quest_desc": [
    "Підготуйте продукти й інструменти для рецепта Farmer’s Delight. Ніж і обробна дошка дають складники, а казан або сковорода потребують нагрівання. Рецепти доступні через JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.039DDB5F4100A198.title": "Чотири преси AE2"
  "quest.039DDB5F4100A198.quest_desc": [
    "Знайдіть потрібні преси або виготовте доступним рецептом. Прес лишається у висікачі та не входить до витратного шаблону."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6E030B7DD0A70981.title": "Лінія з п’яти висікачів"
  "quest.6E030B7DD0A70981.quest_desc": [
    "Виділіть чотири висікачі для кремнію, логічної, обчислювальної та інженерної заготовок. П’ятий збирає готовий процесор. Преси залиште в призначених машинах; підведіть FE."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2A292BBF08161DDE.title": "Друкований кремній"
  "quest.2A292BBF08161DDE.quest_desc": [
    "Автоматично подавайте кремній у машину з кремнієвим пресом і повертайте результат у ME. Налаштування боків висікача залежить від його режиму й орієнтації."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.356C128A642971ED.title": "Три типи друкованих схем"
  "quest.356C128A642971ED.quest_desc": [
    "Золото, сертифікований кварц та алмаз обробляються окремими пресами. Кожній заготовці потрібен окремий шаблон оброблення AE2."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.072609F0D1F912D1.title": "Процесор автокрафту"
  "quest.072609F0D1F912D1.quest_desc": [
    "Підключіть завершений Crafting CPU до мережі. Сховище крафту визначає складність завдання; блок без сховища не запускає замовлення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.356F206C1FD4CD44.title": "Шаблони оброблення"
  "quest.356F206C1FD4CD44.quest_desc": [
    "Кодуйте окремі рецепти сировина → друкована схема та друкована схема + друкований кремній + редстоун → процесор. Не вписуйте незношувані преси як споживані складники."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.29DD06A98AE24E41.title": "Постачальники та повернення"
  "quest.29DD06A98AE24E41.quest_desc": [
    "Постачальники шаблонів подають матеріали у висікачі, а вихід повертається до ME імпортом або автоматичним виштовхуванням. Переконайтеся, що результат повертається саме в мережу, яка замовила крафт."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1925F252305326F4.title": "Замовлення логічних процесорів"
  "quest.1925F252305326F4.quest_desc": [
    "Замовте партію з 16 логічних процесорів у терміналі. За потреби перевірте блокування постачальника та фільтри буферної скрині."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.53C1A2E5C0AF99A0.title": "Замовлення обчислювальних процесорів"
  "quest.53C1A2E5C0AF99A0.quest_desc": [
    "Повторіть замовлення для кварцової гілки. Матеріали мають пройти друк і складання без ручного перекладання."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.213B062DCC47FFB0.title": "Замовлення інженерних процесорів"
  "quest.213B062DCC47FFB0.quest_desc": [
    "Перевірте алмазну гілку. Якщо замовлення зависло, подивіться, якої заготовки або повернення результату чекає Crafting CPU."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.41373D2EB3CD5A9C.title": "Три процесори на замовлення"
  "quest.41373D2EB3CD5A9C.quest_desc": [
    "Приберіть готові процесори з мережі й замовте всі три види одночасно. Перевірте, що сировина подається, преси залишаються на місці, а результат повертається автоматично. Це ручне підтвердження роботи установки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2ACA009EC31FB840.title": "Підтримання запасу процесорів"
  "quest.2ACA009EC31FB840.quest_desc": [
    "Для запасу використайте емітер рівня, шину експорту й карту крафту або окрему підмережу. Обмежте потрібний запас, щоб фабрика не витратила всі алмази на процесори."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1936F9400828174D.title": "Рідинний наповнювач"
  "quest.1936F9400828174D.quest_desc": [
    "Підведіть FE до машини, налаштуйте боки вводу й виводу та автоматичне виштовхування. Пробний рецепт і витрати перевірте у JEI. Потужність фабрики потребує відповідного живлення й підведення ресурсів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.066A57CFEDA15B08.title": "Сейсмічний вібратор"
  "quest.066A57CFEDA15B08.quest_desc": [
    "Підведіть FE до машини, налаштуйте боки вводу й виводу та автоматичне виштовхування. Пробний рецепт і витрати перевірте у JEI. Потужність фабрики потребує відповідного живлення й підведення ресурсів."
