  ]
  "quest.5828D19089812833.title": "Газорозрядний покажчик"
  "quest.5828D19089812833.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.542A9B9221117FFF.title": "Латунна воронка"
  "quest.542A9B9221117FFF.quest_desc": [
    "Фільтруйте предмети й контролюйте розмір переданих партій. Відокремте входи сировини від виходів продукції."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1DF284F9A3A0C091.title": "Розподіл продукції"
  "quest.1DF284F9A3A0C091.quest_desc": [
    "Латунні тунелі керують розподілом між конвеєрами. Спробуйте рівномірне постачання кількох однакових машин."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.22FF8CADECECA988.title": "Фільтр властивостей"
  "quest.22FF8CADECECA988.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0D13ACE4193F568C.title": "Розумний жолоб"
  "quest.0D13ACE4193F568C.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.172F067F7E08680C.title": "Керування швидкістю"
  "quest.172F067F7E08680C.quest_desc": [
    "Контролер задає швидкість підключеної передачі. Перевіряйте, чи вистачає джерелу потужності після зміни обертів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2F725C3C721D018B.title": "Редуктор"
  "quest.2F725C3C721D018B.quest_desc": [
    "Редуктор розводить обертання між горизонтальними осями. Перевірте напрямок виходів перед підключенням машин."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7DAEA24041EE80BF.title": "Послідовний перемикач передач"
  "quest.7DAEA24041EE80BF.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
