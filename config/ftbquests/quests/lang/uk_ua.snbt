  ]
  "quest.0B7B26F6E6ACE1BD.title": "Броня IV • Фінал"
  "quest.0B7B26F6E6ACE1BD.quest_desc": [
    "30+ броні, твердість 18+: очищений обсидіан, Ruinfighter і Duskfire (NightFall) — найміцніше у збірці."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.60957C7619B19CCC.quest_desc": [
    "§eКомплект (4 частини): броня 31, твердість 20, відкидання −0.8."
    "§6Заблоковано до «Сувій ключа: Іґніс» (квест П0)."
  ]
  "quest.0C5D01DA0E281869.quest_desc": [
    "§eКомплект (4 частини): броня 30, твердість 18, відкидання −0.8."
