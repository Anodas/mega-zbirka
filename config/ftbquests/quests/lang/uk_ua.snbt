  ]
  "quest.49B0C4A75297B8C8.title": "Окультний повідець Енду"
  "quest.49B0C4A75297B8C8.quest_desc": [
    "Ендерський повідець має спеціальну дію з переміщенням істот. Перевірте обмеження цієї версії й сумісні цілі перед використанням у фермі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.251FBFF603D95A5E.title": "Рівень світу: Кордон"
  "quest.251FBFF603D95A5E.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6A5F7795F0591C7B.title": "Рівень світу: Сходження"
  "quest.6A5F7795F0591C7B.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1D58FCE650240F4F.title": "Рівень світу: Вершина"
  "quest.1D58FCE650240F4F.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.60938DE6435860EB.title": "Рівень світу: Пік"
  "quest.60938DE6435860EB.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.17D545690F4CCB5D.title": "Просякнена руна породжувача"
  "quest.17D545690F4CCB5D.quest_desc": [
    "Використайте цю руну або модифікатор на сумісному спавнері. Перевірте змінюваний параметр, обмеження рівня світу та спосіб скасування ефекту в довіднику. Прямі модифікатори старих версій можуть бути замінені рунами."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.398AF70AF3DFD708.title": "Шкатулка"
  "quest.398AF70AF3DFD708.quest_desc": [
    "Футляр допомагає зберігати й упорядковувати самоцвіти. Перевірте його місткість і доступні дії; це сховище, а не заміна столу огранювання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.28C7651ACECDB2F3.title": "Шкатулка дому Фаберже"
  "quest.28C7651ACECDB2F3.quest_desc": [
    "Футляр допомагає зберігати й упорядковувати самоцвіти. Перевірте його місткість і доступні дії; це сховище, а не заміна столу огранювання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.735F5C536ED3D230.title": "Богозлита перлина"
  "quest.735F5C536ED3D230.quest_desc": [
    "Отримайте цей матеріал через доступні рецепти або перероблення спорядження. Його застосування у розвитку афіксів, самоцвітів і зачаровування перевірте у JEI та Хроніці тіней."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.44973CC6BC50C7B5.title": "Стіл зачарування Ворона"
  "quest.44973CC6BC50C7B5.quest_desc": [
    "Отримайте цей матеріал через доступні рецепти або перероблення спорядження. Його застосування у розвитку афіксів, самоцвітів і зачаровування перевірте у JEI та Хроніці тіней."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.12880093FD0397E1.title": "Як працюють книги Iron’s"
  "quest.12880093FD0397E1.quest_desc": [
    "Записуйте сувої в книгу через стіл написів. Книга має обмежену кількість слотів; записане заклинання використовує ману й час відновлення, тому тримати запас одноразових сувоїв для кожного застосування не потрібно."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.47A0A4488B0F315D.title": "Стародавній кодекс"
  "quest.47A0A4488B0F315D.quest_desc": [
    "Ця книга має власні місткість, бонуси або спорідненість із заклинаннями. Перевірте підказку предмета й спосіб отримання, потім запишіть потрібні сувої через стіл написів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3655314065EA698C.title": "Кволий журнал"
  "quest.3655314065EA698C.quest_desc": [
    "Ця книга має власні місткість, бонуси або спорідненість із заклинаннями. Перевірте підказку предмета й спосіб отримання, потім запишіть потрібні сувої через стіл написів."
