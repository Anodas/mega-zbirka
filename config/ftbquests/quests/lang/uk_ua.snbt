  "image.552E0C86180E4485.title": "§bРозділ 6"
  "image.59B3EC29788AEC1C.title": "§bРозділ 1"
  "image.1A68FEC47A7DD29E.title": "§bРозділ 1"
  "chapter.1C73559D72C90948.title": "&#8C8678М0.0 • &#E3A8FFГ&#E0A4FFо&#DC9FFFл&#D89BFFо&#D597FFв&#D292FFн&#CE8EFFи&#CA8AFFй &#C785FFм&#C481FFа&#C07CFFр&#BC78FFш&#B974FFр&#B66FFFу&#B26BFFт&#B86BFC: &#BD6CF9П&#C26CF5е&#C86CF2р&#CE6CEFш&#D36DECі &#D86DE8з&#DE6DE5а&#E46EE2к&#E96EDFл&#EE6EDCя&#F46ED8т&#FA6FD5т&#FF6FD2я"
  "quest.0BB451D5E04C6151.title": "Ласкаво просимо до магії"
  "quest.0BB451D5E04C6151.quest_desc": [
    "Магічний шлях починається з Ars Nouveau й завершується Blood Magic. Основні маршрути М0–М4 відкриваються послідовно. Докладні глави поруч пояснюють моди; бібліотеки символів і колекції спорядження не потрібно закривати повністю. Ця лінія незалежна від технологічних етапів."
    "§6Книги заклинань Iron’s Spells і Ars Nouveau заблоковані до «Сувою ключа: Наґа» — нагороди за перемогу над Наґою (глава П0 • Боси, бій у П2 • Сутінковий ліс)."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.50AB235B0D2745A6.title": "Довідник чарівника"
  "quest.50AB235B0D2745A6.quest_desc": [
    "Створіть потертий записник Ars Nouveau. Він пояснює символи, джерело, ритуали та роботу помічників. Рецепти у квестах відкриваються через JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1AC87C7AE99DF37E.title": "Кристали джерела"
  "quest.1AC87C7AE99DF37E.quest_desc": [
    "Знайдіть кристали джерела або перетворіть аметист у камері наповнення за доступним рецептом. Залишайте частину запасу для символів і пристроїв."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.51D35CC0A1FEEE80.title": "Книга новачка"
  "quest.51D35CC0A1FEEE80.quest_desc": [
    "Почніть із книги новачка. Відкрийте редактор заклять і створіть окремі набори для роботи та бою; клавіші можна перевірити в налаштуваннях керування."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.65D713DEBFC1DB60.title": "Стіл писаря"
  "quest.65D713DEBFC1DB60.quest_desc": [
    "Поставте стіл писаря та створіть перші символи. Предмети для вибраного символу подаються на стіл; умови рівня книги показані в записнику."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4E444F2E9C114FFD.title": "Перше власне закляття"
  "quest.4E444F2E9C114FFD.quest_desc": [
    "Складіть і випробуйте просте закляття: форма визначає спосіб застосування, ефект — результат, доповнення змінюють його. Оберіть доступні символи й перевірте витрату мани. Це практична вправа з ручним підтвердженням."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.60B25560A8E0E9F7.title": "Камера наповнення"
  "quest.60B25560A8E0E9F7.quest_desc": [
    "Використайте камеру наповнення для кристалів та есенцій. Рецепти можуть вимагати додаткові предмети на п’єдесталах навколо; звіряйте схему з JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2DA05B1AB1F7F3F5.title": "Банка джерела"
  "quest.2DA05B1AB1F7F3F5.quest_desc": [
    "Поставте банку біля джерела генерації. Source — окремий магічний ресурс: запас мани персонажа його не замінює."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.573A7EB341EBDA22.title": "Перше стабільне джерело"
  "quest.573A7EB341EBDA22.quest_desc": [
    "Розмістіть аграрну ланку біля рослин, які ростуть, і банку в межах її роботи. Зберіть ферму так, щоб вона регулярно поповнювала Source."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2A221CF072D4EE62.title": "Зачаровательний апарат"
  "quest.2A221CF072D4EE62.quest_desc": [
    "Зберіть апарат із ядром і п’єдесталами. Матеріали, їх кількість та вимогу Source перевірте в рецепті; апарат потрібен для подальшого спорядження й помічників."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.37144A133C1A7348.title": "М0 завершено: майстерня працює"
  "quest.37144A133C1A7348.quest_desc": [
    "Перевірте три речі: книга застосовує ваше закляття, банка поповнюється від ферми, апарат виконує доступний рецепт. Після ручного підтвердження відкриється М1 із бойовою магією Iron’s та спеціалізаціями Ars."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "chapter.31352CE737D468F7.title": "&#8C8678М1.0 • &#E3A8FFГ&#E0A4FFо&#DDA1FFл&#DA9DFFо&#D79AFFв&#D596FFн&#D292FFи&#CF8FFFй &#CC8BFFм&#C988FFа&#C684FFр&#C381FFш&#C07DFFр&#BE79FFу&#BB76FFт&#B872FF: &#B56FFFС&#B26BFFт&#B76BFCи&#BB6BFAх&#C06CF7і&#C46CF4ї &#C96CF2т&#CD6CEFа &#D26DECб&#D66DEAо&#DB6DE7й&#DF6DE5о&#E46EE2в&#E86EDFа &#ED6EDDм&#F16EDAа&#F66FD7г&#FA6FD5і&#FF6FD2я"
  "quest.109626E8E982C119.title": "М1: нові школи магії"
  "quest.109626E8E982C119.quest_desc": [
    "Тепер розвивайте Ars і Iron’s паралельно. У цьому етапі достатньо робочого помічника, першого бойового набору Iron’s і однієї вибраної стихії. Колекції всіх шкіл та комплектів залишаються додатковими."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.661833E72B5FDB21.title": "Книга підмайстра"
  "quest.661833E72B5FDB21.quest_desc": [
    "Оновіть книгу Ars Nouveau до наступного рівня. Вищий рівень відкриває нові символи; самі символи все одно слід створити й вивчити."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.18AFAEE26DD17DD9.title": "Перший старбункул"
  "quest.18AFAEE26DD17DD9.quest_desc": [
    "Викличте старбункула амулетом і налаштуйте роботу жезлом домініону. Вкажіть джерело предметів та інвентар призначення; спочатку перевірте перенесення одного матеріалу."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6B036A701FAFD1CE.title": "Ферма з помічником"
  "quest.6B036A701FAFD1CE.quest_desc": [
    "Налаштуйте збирання або переміщення врожаю помічником. Забезпечте місце для результатів і повернення потрібних матеріалів; переконайтеся, що ферма поповнює Source. Підтвердження роботи — вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.10CAD8C9AEBFB879.title": "Перша книга Iron’s"
  "quest.10CAD8C9AEBFB879.quest_desc": [
    "Створіть залізну книгу заклять Iron’s. Її заклинання записуються зі сувоїв за допомогою столу написів. Книга Iron’s і книга Ars мають різні системи заклять."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2D29620BA6E608DD.title": "Стіл написів"
  "quest.2D29620BA6E608DD.quest_desc": [
    "Покладіть книгу та сувій у стіл написів і запишіть заклинання у вільний слот. Під час застосування записаного заклинання витрачається мана, а не новий сувій."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6912EE607601BE73.title": "Власні сувої"
  "quest.6912EE607601BE73.quest_desc": [
    "Створіть кузню сувоїв. Виберіть заклинання й подайте чорнило та його складники; доступні рецепти й максимальний рівень перевірте в інтерфейсі та JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.50D20A9113066CF8.title": "Випробування бойової книги"
  "quest.50D20A9113066CF8.quest_desc": [
    "Запишіть і застосуйте бойове заклинання Iron’s. Додайте доступне захисне або допоміжне заклинання, якщо маєте відповідний сувій. Перевірте вибір слота, запас мани та час відновлення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6CB6006513656A8C.title": "Одна стихія на вибір"
  "quest.6CB6006513656A8C.quest_desc": [
    "Виберіть Повітря, Воду, Землю або Вогонь і створіть відповідний малий фокус Ars Elemental. Одягніть його у сумісний слот і випробуйте закляття цієї школи. Усі чотири фокуси для проходження не потрібні; рецепти є в главі Ars Elemental."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5B774ABF797929AD.title": "Покращення заклинань"
  "quest.5B774ABF797929AD.quest_desc": [
    "Використайте арканічне ковадло для доступного покращення сувоїв або спорядження. Перед об’єднанням перевірте сумісність заклинань і вимоги рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7C3E5A8CDAE44F7D.title": "М1 завершено: маг готовий до ритуалів"
  "quest.7C3E5A8CDAE44F7D.quest_desc": [
    "Підтвердьте, що маєте робочу ферму з помічником, застосовуєте заклинання Iron’s і випробували одну стихію Ars Elemental. Далі відкриваються духи, сховище та добування Occultism."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "chapter.301A60B6BACDE999.title": "&#8C8678М2.0 • &#E3A8FFГ&#E0A4FFо&#DC9FFFл&#D89BFFо&#D597FFв&#D292FFн&#CE8EFFи&#CA8AFFй &#C785FFм&#C481FFа&#C07CFFр&#BC78FFш&#B974FFр&#B66FFFу&#B26BFFт&#B86BFC: &#BD6CF9Д&#C26CF5у&#C86CF2х&#CE6CEFи &#D36DECт&#D86DE8а &#DE6DE5р&#E46EE2е&#E96EDFс&#EE6EDCу&#F46ED8р&#FA6FD5с&#FF6FD2и"
  "quest.10006F65127773DA.title": "М2: домовляємося з духами"
  "quest.10006F65127773DA.quest_desc": [
    "Occultism дає духів для праці, зберігання та добування. Ars Ocultas поєднує їх із банками та помічниками Ars. Основний маршрут охоплює першу робочу систему; усі види крейди та ритуалів збирати не потрібно."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4D6C05F7652DDF9E.title": "Насіння демонічного сну"
  "quest.4D6C05F7652DDF9E.quest_desc": [
    "Знайдіть насіння демонічного сну, виростіть рослину й залиште запас насіння. Воно потрібне для знайомства з Іншосвітом та створення довідника."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.12F0885480193059.title": "Словник духів"
  "quest.12F0885480193059.quest_desc": [
    "Створіть словник духів і відкрийте початкові записи. У ньому є схеми пентаклів, типи духів, складники та умови завершення ритуалів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5BAA58646C7567A2.title": "Матеріали Іншосвіту"
  "quest.5BAA58646C7567A2.quest_desc": [
    "Отримайте матеріали через духовний вогонь або дослідження з відповідним зором. Конкретні перетворення перевіряйте у JEI; не плутайте звичайні блоки з їх іншосвітніми відповідниками."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.57D0E3A4B95D8728.title": "Біла крейда й ритуальні чаші"
  "quest.57D0E3A4B95D8728.quest_desc": [
    "Підготуйте очищену крейду, центральну золоту чашу й чаші для складників. Перемалюйте перший пентакль зі словника, включно з орієнтацією та свічками."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.34943F9E4DDA9540.title": "Перший зв’язаний фоліот"
  "quest.34943F9E4DDA9540.quest_desc": [
    "Зв’яжіть ім’я фоліота в книзі. Покладіть потрібні предмети в чаші та запустіть обраний початковий ритуал; результат залежить від рецепта пентакля."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6E6EE3F9655CE896.title": "Ієсній"
  "quest.6E6EE3F9655CE896.quest_desc": [
    "Підготуйте належний зір та інструмент для ієснію в Незері або використайте доступний магічний спосіб отримання. Рецепти доступного способу перевірте в JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5CEC40E9A699A461.title": "Основа магічного сховища"
  "quest.5CEC40E9A699A461.quest_desc": [
    "Зберіть початкову систему зберігання зі словника. Матриця потребує відповідної конструкції та пов’язаних компонентів; одного предмета в інвентарі недостатньо для роботи."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1BB50BCDA589E5D4.title": "Перевірка зберігання"
  "quest.1BB50BCDA589E5D4.quest_desc": [
    "Помістіть кілька різних предметів у магічне сховище й дістаньте їх назад через його доступний інтерфейс. Перевірте місткість, прив’язку та доступ до системи."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.52DA07BCDFEDF958.title": "Магічна шахта"
  "quest.52DA07BCDFEDF958.quest_desc": [
    "Поставте вимірну шахту та налаштуйте сумісного духа-добувача. Його рівень і список результатів перевірте у словнику та JEI; передбачте вільний вихід для ресурсів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5D2B91426AFAA358.title": "Банка для духа"
  "quest.5D2B91426AFAA358.quest_desc": [
    "Використайте ритуал утримання й банку Ars для сумісного духа Occultism. У главі Ars Ocultas пояснено подавання предметів у банку та виведення результатів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3B70CBC2D6101F57.title": "М2 завершено: магічна фабрика"
  "quest.3B70CBC2D6101F57.quest_desc": [
    "Підтвердьте роботу сховища й однієї автоматичної операції духа: оброблення матеріалів у банці або добування шахтою. Забезпечте виведення результатів, щоб система не зупинялася."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "chapter.7C407823C8FAC8CF.title": "&#8C8678М3.0 • &#E3A8FFГ&#DFA3FFо&#DC9FFFл&#D89AFFо&#D496FFв&#D191FFн&#CD8DFFи&#CA88FFй &#C684FFм&#C27FFFа&#BF7BFFр&#BB76FFш&#B772FFр&#B46DFFу&#B56BFDт&#BB6BFA: &#C06CF7Ш&#C66CF3л&#CC6CF0я&#D16DEDх &#D76DE9а&#DD6DE6р&#E26EE3х&#E86EDFі&#EE6EDCм&#F46ED9а&#F96FD5г&#FF6FD2а"
  "quest.4D279D1E5B9D955B.title": "М3: майстерність і спорядження"
  "quest.4D279D1E5B9D955B.quest_desc": [
    "Розвивайте сильні закляття Ars та Iron’s і підсилюйте вибране спорядження через Apotheosis. Для переходу до Blood Magic потрібна готова бойова конфігурація, а не всі книги, фокуси й комплекти броні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.07B4E16D0A1F38C5.title": "Книга архімага Ars"
  "quest.07B4E16D0A1F38C5.quest_desc": [
    "Досягніть найвищого звичайного рівня книги Ars Nouveau. Виберіть кілька потрібних символів високого рівня, враховуючи сумарну витрату мани."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.59EEDF4DDE622788.title": "Закляття для складного завдання"
  "quest.59EEDF4DDE622788.quest_desc": [
    "Побудуйте власне складне закляття для бою, захисту або пересування. Перевірте порядок ефектів і доповнень та достатній запас мани. Підтвердіть результат після випробування."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.407087970E0283A8.title": "Епічне чорнило Iron’s"
  "quest.407087970E0283A8.quest_desc": [
    "Отримайте епічне чорнило доступним способом. Рідкість чорнила впливає на доступні можливості виготовлення сувоїв; вона не скасовує інші вимоги заклинання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.34EDB7539AFC417D.title": "Підготовлена книга Iron’s"
  "quest.34EDB7539AFC417D.quest_desc": [
    "Покращте улюблене заклинання й запишіть його в книгу з достатньою кількістю слотів. Додайте захисну або допоміжну дію. Легендарна колекція всіх заклять не потрібна."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.11AD203186839BC9.title": "Кероване зачаровування"
  "quest.11AD203186839BC9.quest_desc": [
    "Ознайомтеся з Eterna, Quanta й Arcana. Полиці змінюють параметри столу; підбирайте їх під потрібне зачаровування або наповнення, звіряючи значення в JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.329A170DC13C988F.title": "Матеріали перековки"
  "quest.329A170DC13C988F.quest_desc": [
    "Розберіть зайві предмети з афіксами. Матеріали їх рідкості та пил самоцвітів потрібні для розвитку Apotheosis; спочатку переконайтеся, що предмет вам не потрібен."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.48AC82D86CD52C67.title": "Стіл перековки"
  "quest.48AC82D86CD52C67.quest_desc": [
    "Підготуйте предмет, матеріали відповідної рідкості й самоцвіти. Виконайте перековку та оберіть корисні для свого стилю характеристики."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.284507BF261F2129.title": "Огранювання самоцвітів"
  "quest.284507BF261F2129.quest_desc": [
    "Огляньте умови поліпшення самоцвіту. Для вставлення використовуйте ковальський стіл і предмет із сумісним гніздом; значення бонусу залежать від місця встановлення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7B5C44F202E54805.title": "Випробування архімага"
  "quest.7B5C44F202E54805.quest_desc": [
    "Випробуйте підготовлене спорядження в бою з небезпечними супротивниками. Перевірте відновлення мани, захист і запас витратних матеріалів. Спеціальні боси Iron’s є в додатковій главі випробувань."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.549A997F8F285DCD.title": "М3 завершено: готовність до Blood Magic"
  "quest.549A997F8F285DCD.quest_desc": [
    "Підтвердьте, що користуєтеся покращеною книгою, маєте робочий захист та освоїли перековку або вставлення самоцвіту. Відкриється фінальна школа — магія крові."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "chapter.043E1BC889E0CDEA.title": "&#8C8678М4.0 • &#E3A8FFГ&#DFA3FFо&#DB9EFFл&#D799FFо&#D394FFв&#CF90FFн&#CB8BFFи&#C886FFй &#C481FFм&#C07CFFа&#BC77FFр&#B872FFш&#B46DFFр&#B56BFDу&#BB6BFAт&#C16CF6: &#C86CF2М&#CE6CEFа&#D46DEBг&#DA6DE8і&#E06DE4я &#E66EE0к&#ED6EDDр&#F36ED9о&#F96FD6в&#FF6FD2і"
  "quest.32D14A19DE2CEF8F.title": "М4: ціна сили"
  "quest.32D14A19DE2CEF8F.quest_desc": [
    "Фінальний етап — сучасний Blood Magic 3. Його головні ресурси: життєва есенція LP, мережа душі та демонічна воля. Це різні запаси. Квести адаптовано до встановленого порту; творча сфера й недоступні рівні не потрібні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7231ED74A2199B1A.title": "Новий посібник Blood Magic"
  "quest.7231ED74A2199B1A.quest_desc": [
    "З’єднайте звичайну книгу зі склом, щоб отримати посібник Blood Magic у Modopedia. Використовуйте саме цю книгу: стара версія Patchouli у порту не працює."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2616589E154FB57E.title": "Алтар і жертовний кинджал"
  "quest.2616589E154FB57E.quest_desc": [
    "Поставте алтар і поповніть його жертовним кинджалом. Це витрачає здоров’я персонажа; подбайте про їжу та відновлення, перш ніж виробляти велику кількість LP."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3DACD345E7DCFBE7.title": "Перша чиста пластина"
  "quest.3DACD345E7DCFBE7.quest_desc": [
    "Помістіть придатний камінь в алтар із достатньою кількістю LP. Алтар витрачає есенцію поступово; потрібний обсяг показує рецепт JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.102E41070A976494.title": "Слабка сфера крові"
  "quest.102E41070A976494.quest_desc": [
    "Створіть слабку сферу та прив’яжіть її до себе відповідною дією використання. Сфера пов’язана з мережею душі; запас алтаря не є запасом мережі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5A95D67BE1E6C7C2.title": "Контроль запасу"
  "quest.5A95D67BE1E6C7C2.quest_desc": [
    "Створіть і прив’яжіть сигіл ворожіння. Використайте його, щоб перевіряти параметри алтаря та свій запас LP у мережі душі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2CC998556E2732E2.title": "Алтар другого рівня"
  "quest.2CC998556E2732E2.quest_desc": [
    "Зберіть конструкцію другого рівня за посібником: нижнє кільце рун має бути на правильній висоті. Перевірте, що гра розпізнала новий рівень. Самі руни в інвентарі цього не доводять."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3FF3732115926540.title": "Сфера підмайстра"
  "quest.3FF3732115926540.quest_desc": [
    "Створіть сферу підмайстра на належному рівні алтаря. Переконайтеся, що вистачає не лише місткості, а й фактичного запасу LP для рецепта."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3AF1E7D8A145BBA8.title": "Демонічна воля та кузня"
  "quest.3AF1E7D8A145BBA8.quest_desc": [
    "Отримайте першу демонічну волю за допомогою пастки душ. Підготуйте кузню пекельного полум’я й камінь тартарика для зберігання волі. Воля не замінює LP алтаря."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.010673B146DBD045.title": "Алхімічний стіл"
  "quest.010673B146DBD045.quest_desc": [
    "Підготуйте стіл і власну прив’язану сферу відповідного рівня. Подавайте складники за рецептом, а витрати мережі душі контролюйте сигілом."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.66013996A395A797.title": "Алтар третього рівня"
  "quest.66013996A395A797.quest_desc": [
    "Розширте конструкцію до третього рівня за схемою Modopedia. Перевірте опори, потрібні блоки й положення рун, після чого підтвердьте розпізнаний рівень."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0A2B9111C1940F86.title": "Сфера мага"
  "quest.0A2B9111C1940F86.quest_desc": [
    "Виготовте сферу мага та перейдіть до рецептів цього рівня. Заздалегідь налагодьте поповнення LP, щоб довгі рецепти не простоювали."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.75BEFDBA1AA36A74.title": "Перший великий ритуал"
  "quest.75BEFDBA1AA36A74.quest_desc": [
    "Зберіть доступний великий ритуал за допомогою ритуального віщуна. Прив’яжіть кристал, перевірте схему та запас LP у мережі душі; активація й підтримання можуть коштувати окремо."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.21F02D77800F2928.title": "Слабкий уламок крові"
  "quest.21F02D77800F2928.quest_desc": [
    "Отримайте уламок доступним способом установленого Blood Magic. Перевірте ланцюжок слабких тау та його оброблення у JEI й посібнику; сторонні рецепти зі збірок не підходять."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6E6C33846E42F818.title": "Алтар четвертого рівня"
  "quest.6E6C33846E42F818.quest_desc": [
    "Зберіть четвертий рівень, включно з потрібними кров’яними блоками й опорами. Перевірте рівень інструментом або відображенням посібника перед складним рецептом."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.31F26ABFD515B1CB.title": "Сфера майстра"
  "quest.31F26ABFD515B1CB.quest_desc": [
    "Створіть і прив’яжіть сферу майстра. Слідкуйте за місткістю алтаря та мережею душі; для наступних кроків потрібна підготовлена інфраструктура."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3F20192EB5B761C0.title": "Жива броня"
  "quest.3F20192EB5B761C0.quest_desc": [
    "Створіть живий нагрудник алхімічним масивом за рецептом. Ознайомтеся з накопиченням досвіду броні та бюджетом покращень; інші частини комплекту й розвиток описані в окремій главі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.146898C782CA67B9.title": "Доступ до підземелля"
  "quest.146898C782CA67B9.quest_desc": [
    "Підготуйте простий ключ і знайдіть відповідний спосіб входу за посібником порту. Перед дослідженням візьміть їжу, спорядження та засіб повернення; ключ не є самостійним порталом."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.62ADD7E2F72D34F0.title": "Алтар п’ятого рівня"
  "quest.62ADD7E2F72D34F0.quest_desc": [
    "Завершіть конструкцію п’ятого рівня за схемою Modopedia, зокрема потрібні маяки та руни. Підтвердьте, що алтар справді розпізнав рівень. Шостий рівень і творчі предмети для фіналу не потрібні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.58DE88787DEC9BE3.title": "Майстер магії крові"
  "quest.58DE88787DEC9BE3.quest_desc": [
    "Завершіть практичне випробування: алтар п’ятого рівня працює, великий ритуал активовано, жива броня отримує покращення, мережа душі поповнюється. Це фінал основного магічного маршруту; решта сигілів і ритуалів лишаються додатковими."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
