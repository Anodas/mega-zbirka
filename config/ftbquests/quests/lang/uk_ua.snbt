  "chapter.2C25112106CF7FD6.title": "&#8C8678М3.6 • &#E3A8FFA&#DFA3FFp&#DC9FFFo&#D89AFFt&#D496FFh&#D191FFe&#CD8DFFo&#CA88FFs&#C684FFi&#C27FFFs&#BF7BFF: &#BB76FFр&#B772FFо&#B46DFFз&#B56BFDв&#BB6BFAи&#C06CF7т&#C66CF3о&#CC6CF0к &#D16DEDс&#D76DE9п&#DD6DE6а&#E26EE3в&#E86EDFн&#EE6EDCе&#F46ED9р&#F96FD5і&#FF6FD2в"
  "chapter.207D975C7DDF53D0.title": "&#8C8678М4.1 • &#E3A8FFB&#DFA3FFl&#DB9FFFo&#D89AFFo&#D495FFd &#D091FFM&#CC8CFFa&#C987FFg&#C582FFi&#C17EFFc&#BD79FF: &#BA74FFа&#B670FFл&#B26BFFт&#B86BFCа&#BE6CF8р&#C46CF5, &#CA6CF1с&#D06DEEф&#D66DEAе&#DB6DE7р&#E16DE3и &#E76EE0й &#ED6EDCр&#F36ED9у&#F96FD5н&#FF6FD2и"
  "chapter.3611F44655AC64D0.title": "&#8C8678М4.2 • &#E3A8FFB&#E0A4FFl&#DDA0FFo&#DA9CFFo&#D698FFd &#D394FFM&#D090FFa&#CD8CFFg&#CA89FFi&#C785FFc&#C381FF: &#C07DFFв&#BD79FFо&#BA75FFл&#B771FFя&#B46DFF, &#B46BFEа&#B96BFBл&#BE6CF8х&#C36CF5і&#C86CF2м&#CD6CEFі&#D26DECя &#D76DE9т&#DC6DE6а &#E16DE3р&#E66EE1и&#EB6EDEт&#F06EDBу&#F56ED8а&#FA6FD5л&#FF6FD2и"
  "chapter.1521F54D313CF72F.title": "&#8C8678М4.3 • &#E3A8FFB&#E0A4FFl&#DCA0FFo&#D99CFFo&#D698FFd &#D394FFM&#CF90FFa&#CC8CFFg&#C987FFi&#C683FFc&#C27FFF: &#BF7BFFж&#BC77FFи&#B973FFв&#B56FFFа &#B26BFFб&#B76BFCр&#BC6CF9о&#C16CF6н&#C76CF3я &#CC6CF0й &#D16DEDп&#D66DEAі&#DB6DE7д&#E06DE4з&#E56EE1е&#EA6EDEм&#F06EDBе&#F56ED8л&#FA6FD5л&#FF6FD2я"
  "quest.7C45501B1248978E.title": "Малий фокус Повітря"
  "quest.7C45501B1248978E.quest_desc": [
    "Малий фокус дозволяє спеціалізуватися на цій стихії. Одягніть його у сумісний слот і випробуйте дію зі своїми символами. Для основного маршруту досить одного вибраного фокуса."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3D20E059D8DA7298.title": "Фокус Повітря"
  "quest.3D20E059D8DA7298.quest_desc": [
    "Посильте вибрану стихію великим фокусом. Звірте нові ефекти, бонуси й обмеження щодо інших шкіл у записнику Ars Elemental."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.21CDD2665CA39B84.title": "Браслет Повітря"
  "quest.21CDD2665CA39B84.quest_desc": [
    "Браслет надає бонуси вибраній школі. Порівняйте його ефекти зі своїм фокусом і бойовим набором."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5E221CA943FC23CA.title": "Чаклунський том Повітря"
  "quest.5E221CA943FC23CA.quest_desc": [
    "Чаклунський том доповнює роботу зі стихією. Прочитайте його властивості та перевірте сумісність із вибраними заклинаннями."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2D9E560108D16244.title": "Малий фокус Води"
  "quest.2D9E560108D16244.quest_desc": [
    "Малий фокус дозволяє спеціалізуватися на цій стихії. Одягніть його у сумісний слот і випробуйте дію зі своїми символами. Для основного маршруту досить одного вибраного фокуса."
