  "quest.3C2C946B5DEF2806.title": "Броня III • Незерит"
  "quest.3C2C946B5DEF2806.quest_desc": [
    "20–32 броні, твердість 12–16: незерит, осмій, єті, проклята броня Маледикта, іґнієва Іґніса."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.53D628BA06B736B8.quest_desc": [
    "§eКомплект (4 частини): броня 20, твердість 12, відкидання −0.4."
  ]
  "quest.21CF9DBFE77209A9.quest_desc": [
    "§eКомплект (4 частини): броня 21, твердість 12, відкидання −0.4."
  ]
  "quest.0BC3BE5FDD52E1FD.quest_desc": [
    "§eКомплект (4 частини): броня 20, твердість 12."
