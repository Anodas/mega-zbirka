  ]
  "quest.54F9975424007731.title": "Легендарні чорнила"
  "quest.54F9975424007731.quest_desc": [
    "Чорнило цієї рідкості використовується для розвитку сувоїв. Доступні способи отримання, поєднання та перетворення перевірте у JEI; для виготовлення сувою потрібні й його власні складники."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0B22C8C9F3C70AC9.title": "Руна блискавки"
  "quest.0B22C8C9F3C70AC9.quest_desc": [
    "Руна представляє одну зі шкіл Iron’s і використовується в її рецептах. Порівняйте властивості школи зі своїми заклинаннями й бонусами спорядження."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.02F55418BFEA9214.title": "Школи заклинань"
  "quest.02F55418BFEA9214.quest_desc": [
    "Школи Iron’s мають різні ефекти й сумісні бонуси спорядження. Виберіть основну школу та допоміжні заклинання; повну колекцію рун для переходу далі збирати не потрібно."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3F67EA6F69A6D28C.title": "Сфера покращення блискавки"
  "quest.3F67EA6F69A6D28C.quest_desc": [
    "Сфера покращення пов’язана з відповідною школою. Перевірте сумісне спорядження та операцію на арканічному ковадлі; бонуси різних шкіл не підсумовуються автоматично для будь-якого заклинання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4080A62B041B98EC.title": "Руна вогню"
  "quest.4080A62B041B98EC.quest_desc": [
    "Руна представляє одну зі шкіл Iron’s і використовується в її рецептах. Порівняйте властивості школи зі своїми заклинаннями й бонусами спорядження."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
