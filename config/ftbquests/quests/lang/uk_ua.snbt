  ]
  "quest.346F9F7E192B4F92.title": "Сигіл злоби"
  "quest.346F9F7E192B4F92.quest_desc": [
    "Сигіл виконує певну дію з афіксами, гніздами або самоцвітами. Перевірте його призначення, потрібний інтерфейс і можливе руйнування матеріалів перед застосуванням."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.356D1F6B457D70DB.title": "Сигіл перевершення"
  "quest.356D1F6B457D70DB.quest_desc": [
    "Сигіл виконує певну дію з афіксами, гніздами або самоцвітами. Перевірте його призначення, потрібний інтерфейс і можливе руйнування матеріалів перед застосуванням."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5809648331B888ED.title": "Розвинене зачаровування"
  "quest.5809648331B888ED.quest_desc": [
    "Apothic Enchanting змінює роботу столу: звичайні книжкові полиці — лише початок. Підбирайте Eterna, Quanta й Arcana під потрібну операцію, а вимоги наповнення звіряйте у JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.35DF4B19DED0B560.title": "Магічне наповнення"
  "quest.35DF4B19DED0B560.quest_desc": [
    "Наповнення є окремою операцією зачарувального столу. Досягніть потрібних діапазонів Eterna, Quanta й Arcana та перевірте, що інтерфейс пропонує саме наповнення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.41E5BEAAC30BA4F6.title": "Інші рецепти наповнення"
  "quest.41E5BEAAC30BA4F6.quest_desc": [
    "Наповнювати можна не лише полиці. Виберіть доступний рецепт у JEI й налаштуйте значення столу для його виконання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4C3E31FC7CF67D7F.title": "Інертний тризуб"
  "quest.4C3E31FC7CF67D7F.quest_desc": [
    "Отримайте цей матеріал через доступні рецепти або перероблення спорядження. Його застосування у розвитку афіксів, самоцвітів і зачаровування перевірте у JEI та Хроніці тіней."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6B532870BE9E2D4F.title": "Бібліотека чар"
  "quest.6B532870BE9E2D4F.quest_desc": [
    "Бібліотека зберігає зачарування з книг і дозволяє збирати потрібний результат. Перевірте її місткість та межі рівня; перед перенесенням цінних книг ознайомтеся з правилами вилучення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4070674537B38857.title": "Александрійська бібліотека"
  "quest.4070674537B38857.quest_desc": [
    "Бібліотека зберігає зачарування з книг і дозволяє збирати потрібний результат. Перевірте її місткість та межі рівня; перед перенесенням цінних книг ознайомтеся з правилами вилучення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7F8707B9D0788D3C.title": "Бджолополиця"
  "quest.7F8707B9D0788D3C.quest_desc": [
    "Ця полиця змінює параметри зачарувального столу. Порівняйте Eterna, Quanta й Arcana до та після встановлення; рецепт наповнення може потребувати визначеного діапазону кожного значення. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
