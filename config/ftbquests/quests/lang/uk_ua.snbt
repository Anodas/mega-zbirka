  ]
  "quest.5ACAC667831F9781.title": "Книга заклинань у лусці дракона"
  "quest.5ACAC667831F9781.quest_desc": [
    "Ця книга має власні місткість, бонуси або спорідненість із заклинаннями. Перевірте підказку предмета й спосіб отримання, потім запишіть потрібні сувої через стіл написів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.76E006D1053F2E9B.title": "Стіл вписування"
  "quest.76E006D1053F2E9B.quest_desc": [
    "Стіл написів переносить заклинання зі сувоїв до книги. Перевірте вільний слот і потрібний сувій, запишіть заклинання та випробуйте вибір його слота."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6E4AADDA7283E369.title": "Магічне ковадло"
  "quest.6E4AADDA7283E369.quest_desc": [
    "Арканічне ковадло використовується для сумісних покращень сувоїв та спорядження. Перед об’єднанням прочитайте вимоги й переконайтеся, що результат справді покращує ваш набір."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7F31249606BA1F2E.title": "Кузня сувоїв"
  "quest.7F31249606BA1F2E.quest_desc": [
    "Кузня сувоїв дозволяє виготовляти заклинання зі складників. Виберіть рецепт, подайте належне чорнило й перевірте вимоги бажаного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.30179CD201435902.title": "Казан алхіміка"
  "quest.30179CD201435902.quest_desc": [
    "Алхімічний казан має власні рецепти рідин, еліксирів та матеріалів. Подавайте складники в потрібному порядку й перевіряйте умови нагрівання та вилучення продукту за посібником."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.72A7E6C1CFC3685F.title": "Звичайні чорнила"
  "quest.72A7E6C1CFC3685F.quest_desc": [
    "Чорнило цієї рідкості використовується для розвитку сувоїв. Доступні способи отримання, поєднання та перетворення перевірте у JEI; для виготовлення сувою потрібні й його власні складники."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.17A9E71DF5DFB886.title": "Незвичайні чорнила"
  "quest.17A9E71DF5DFB886.quest_desc": [
    "Чорнило цієї рідкості використовується для розвитку сувоїв. Доступні способи отримання, поєднання та перетворення перевірте у JEI; для виготовлення сувою потрібні й його власні складники."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3C0CD908A25DFC59.title": "Рідкісні чорнила"
  "quest.3C0CD908A25DFC59.quest_desc": [
    "Чорнило цієї рідкості використовується для розвитку сувоїв. Доступні способи отримання, поєднання та перетворення перевірте у JEI; для виготовлення сувою потрібні й його власні складники."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.505BA1963E929A7F.title": "Епічні чорнила"
  "quest.505BA1963E929A7F.quest_desc": [
