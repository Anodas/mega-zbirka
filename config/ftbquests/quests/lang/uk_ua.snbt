  ]
  "quest.65C43C2A34832064.title": "Броня магів Ars"
  "quest.65C43C2A34832064.quest_desc": [
    "Стихійні комплекти Ars Elemental: +мана, реген, −ціна своєї стихії. Відкриває сувій Гідри."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.18879BB5CD33C34E.quest_desc": [
    "§eКомплект (3 частини): броня 12, твердість 0."
    "Бонуси: мана, реген мани."
  ]
  "quest.3C1CCD14BAB4163D.quest_desc": [
    "§eКомплект (4 частини): броня 17, твердість 7, відкидання −0.05."
    "Бонуси: мана, реген мани, знижка ціни стихії."
  ]
  "quest.621F223D978BF7D8.quest_desc": [
    "§eКомплект (4 частини): броня 21, твердість 9, відкидання −0.1."
    "Бонуси: мана, реген мани, знижка ціни стихії."
  ]
  "quest.5802A28272DF4438.quest_desc": [
    "§eКомплект (4 частини): броня 21, твердість 9, відкидання −0.2."
    "Бонуси: мана, реген мани, знижка ціни стихії."
  ]
