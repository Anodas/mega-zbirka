  ]
  "quest.50A422CF07867AE5.title": "Фрукт Тау"
  "quest.50A422CF07867AE5.quest_desc": [
    "Розвивайте ланцюжок тау за рецептами встановленого порту. Перевірте вирощування, потрібний стан рослини та оброблення; окремі стадії відкривають матеріали для наступних рівнів алтаря."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.659AA95BAF3C789C.title": "Насичений Тау"
  "quest.659AA95BAF3C789C.quest_desc": [
    "Розвивайте ланцюжок тау за рецептами встановленого порту. Перевірте вирощування, потрібний стан рослини та оброблення; окремі стадії відкривають матеріали для наступних рівнів алтаря."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.25933EBAB01EB547.title": "Камера алхімічних реакцій"
  "quest.25933EBAB01EB547.quest_desc": [
    "Алхімічна реакційна камера виконує власні рецепти оброблення. Перевірте входи предметів, реагенти та потрібний демонічний ресурс у JEI; звільняйте всі виходи."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.170AD946038B32A1.title": "Кривава куля мага"
  "quest.170AD946038B32A1.quest_desc": [
    "Ця сфера відкриває рецепти відповідного рівня й працює з мережею душі власника. Прив’яжіть її та підтримуйте запас мережі; LP у самому алтарі обліковуються окремо."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3EF585EA120163D0.title": "Кривава куля майстра"
  "quest.3EF585EA120163D0.quest_desc": [
    "Ця сфера відкриває рецепти відповідного рівня й працює з мережею душі власника. Прив’яжіть її та підтримуйте запас мережі; LP у самому алтарі обліковуються окремо."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.65071A7751E49FB5.title": "Слабкий кров'яний уламок"
  "quest.65071A7751E49FB5.quest_desc": [
    "Розвивайте ланцюжок тау за рецептами встановленого порту. Перевірте вирощування, потрібний стан рослини та оброблення; окремі стадії відкривають матеріали для наступних рівнів алтаря. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7C3BC1758109E770.title": "Інструмент для написів: Присмерк"
  "quest.7C3BC1758109E770.quest_desc": [
    "Зберіть ритуал за допомогою віщуна або схеми Modopedia. Перевірте типи ритуальних каменів, прив’язаний кристал, рівень інструмента та запас LP у мережі душі. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.31A0CB1E20A96025.title": "Пастка душі"
  "quest.31A0CB1E20A96025.quest_desc": [
    "Влучте пасткою душ у придатну істоту й переможіть її під відповідним ефектом, щоб отримати першу волю. Далі зберігайте її в камені тартарика; не плутайте волю з LP. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.003072A8D758932E.title": "Алхімічний стіл"
  "quest.003072A8D758932E.quest_desc": [
    "Алхімічний стіл потребує власної прив’язаної сфери належного рівня та LP у мережі душі. Складники подавайте за рецептом, вихід звільняйте для наступної операції."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.437035A74CDC0E2B.title": "Руна швидкости"
  "quest.437035A74CDC0E2B.quest_desc": [
    "Руна змінює певну властивість алтаря. Встановіть її замість звичайної руни у правильному місці конструкції та перевірте ефект; швидкість, місткість і передавання LP не є одним параметром."
