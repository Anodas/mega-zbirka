  ]
  "quest.1A6665CABF2DA58B.title": "Сигіл відродження"
  "quest.1A6665CABF2DA58B.quest_desc": [
    "Сигіл виконує певну дію з афіксами, гніздами або самоцвітами. Перевірте його призначення, потрібний інтерфейс і можливе руйнування матеріалів перед застосуванням."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.09060F5073D5562F.title": "Простий стіл перекування"
  "quest.09060F5073D5562F.quest_desc": [
    "Перековка використовує матеріали рідкості та самоцвіти. Звичайний і спрощений столи мають різні межі; вибирайте запропоновані властивості під свій набір."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1AB81F8E6563D963.title": "Стіл перекування"
  "quest.1AB81F8E6563D963.quest_desc": [
    "Перековка використовує матеріали рідкості та самоцвіти. Звичайний і спрощений столи мають різні межі; вибирайте запропоновані властивості під свій набір."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.46A7CD31755BE3BD.title": "Стіл доповнення"
  "quest.46A7CD31755BE3BD.quest_desc": [
    "Стіл підсилення працює з наявними властивостями предмета. Підготуйте потрібні сигіли й перевірте вартість зміни або поліпшення конкретного афікса."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.751458E2DC40EFC7.title": "Установлення самоцвітів"
  "quest.751458E2DC40EFC7.quest_desc": [
    "Помістіть предмет із придатним гніздом та самоцвіт у ковальський стіл. Бонус залежить від типу спорядження; перед установленням прочитайте підказку самоцвіту."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.028E23EB9148FCE1.title": "Стіл огранування самоцвітів"
  "quest.028E23EB9148FCE1.quest_desc": [
    "Огранюйте сумісні самоцвіти за рецептом інтерфейсу. Якість, рідкість і додаткові матеріали впливають на результат; вставляйте самоцвіт у предмет лише після перевірки бонусу."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.13CB23D2AA5D4396.title": "Рівень світу: Притулок"
  "quest.13CB23D2AA5D4396.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.652B65526E438C39.title": "Загарбники та рівні світу"
  "quest.652B65526E438C39.quest_desc": [
    "Загарбники Apotheosis — посилені супротивники з предметами, що мають афікси. Меню рівня світу показує умови розвитку та вплив на здобич; клавішу перевірте у налаштуваннях."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.642C04AB7BB3BC1C.title": "Рівень світу: Кордон"
  "quest.642C04AB7BB3BC1C.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.56BA1AFCBC40CBCE.title": "Рівень світу: Сходження"
  "quest.56BA1AFCBC40CBCE.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.10DFD1A5821B35B8.title": "Рівень світу: Вершина"
  "quest.10DFD1A5821B35B8.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.09D9855F5936B180.title": "Рівень світу: Пік"
  "quest.09D9855F5936B180.quest_desc": [
    "Відкрийте меню рівня світу Apotheosis та виконайте показані грою умови. Квест перевіряє справжнє досягнення, а не ручну позначку. Межі здобичі, досвіду й зачаровування залежать від вибраного рівня."
