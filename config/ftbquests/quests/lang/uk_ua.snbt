  ]
  "quest.210BC7F324A51AC0.title": "Кінетичний міст"
  "quest.210BC7F324A51AC0.quest_desc": [
    "Випробуйте цей додатковий вузол на окремій кінетичній лінії. Перевірте напрямок передачі, керувальний сигнал і вплив на навантаження."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.249F78B321A64B07.title": "Механічне гальмо"
  "quest.249F78B321A64B07.quest_desc": [
    "Додайте керовану зупинку до окремої машини. Перед зміною сигналу врахуйте навантаження підключеної мережі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.355136E860263A68.title": "Захист від перевантаження"
  "quest.355136E860263A68.quest_desc": [
    "Відокремте небезпечну гілку кінетичної мережі муфтою. Випробуйте її реакцію, перш ніж підключати весь завод."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.779D2CF1993D072F.title": "Відцентрова муфта"
  "quest.779D2CF1993D072F.quest_desc": [
    "Ознайомтеся з умовами передавання обертання. Перевірте поведінку при різних швидкостях на невеликому стенді."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.123D52277E67642A.title": "Муфта вільного ходу"
  "quest.123D52277E67642A.quest_desc": [
    "Випробуйте передавання обертання в потрібному напрямку. Такі муфти допомагають розділяти джерела приводу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3CCE48CA9EB62782.title": "Бездротове керування"
  "quest.3CCE48CA9EB62782.quest_desc": [
    "Налаштуйте пару передавання сигналів та перевірте прив'язку. Це керування механізмами, а не передавання FE через Flux Networks."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.1FFB7083D845D931.title": "&#8C86781.1 • &#7FF0FFC&#78E9FFr&#71E2FFe&#6ADAFFa&#63D3FFt&#5CCCFFe&#54C5FF: &#4DBEFFN&#46B6FFe&#3FAFFFw &#38A8FFA&#38A1FFg&#379AFFe &#3793FF— &#378CFFп&#3684FFе&#367DFFр&#3676FFш&#366FFFі &#3568FFF&#3561FFE"
  "chapter.1FFB7083D845D931.chapter_subtitle": [
    "Етап 1 • Генерація FE, пневматика та автоматизація"
  ]
  "quest.174BD584B69A071E.title": "Торій"
  "quest.174BD584B69A071E.quest_desc": [
    "Отримайте торій за доступним рецептом New Age. Відкрийте JEI: у моді є власна послідовність підготовки ядерного палива."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.04FF32B4429984F0.title": "Перший заряджувач"
  "quest.04FF32B4429984F0.quest_desc": [
    "Подайте енергію до заряджувача та підготуйте матеріали для обробки. Перевірте необхідну потужність у JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.12FCDBFB31EE73E1.title": "Електрика з обертання"
  "quest.12FCDBFB31EE73E1.quest_desc": [
    "Складіть генераторну установку з котушки, щіток і потрібних магнітних блоків. Забезпечте обертання та відведення FE."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.13D61F895B5C4F7C.title": "Активований торій"
  "quest.13D61F895B5C4F7C.quest_desc": [
    "Обробіть торій за рецептом заряджання. Зберігайте проміжний матеріал окремо для паливної лінії."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.57355AA36C96951A.title": "Паливо New Age"
  "quest.57355AA36C96951A.quest_desc": [
    "Завершіть підготовку ядерного палива. Не плутайте його з паливом Extreme Reactors або Mekanism."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6CFB89C5EDF22595.title": "Сонячне тепло — додаткова гілка"
  "quest.6CFB89C5EDF22595.quest_desc": [
    "Пластина New Age збирає тепло. Підключіть теплові труби й відповідний споживач; для електрики потрібна повна система перетворення, а не лише пластина."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.6FF60EF0A2E1AF53.title": "Теплова мережа"
  "quest.6FF60EF0A2E1AF53.quest_desc": [
    "Теплові труби з'єднують джерело і споживача тепла. Перевірте з'єднання та не плутайте їх з електричними проводами."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.482DD54AEC736DA6.title": "Нагрівач"
  "quest.482DD54AEC736DA6.quest_desc": [
    "Передайте тепло до нагрівача та перевірте сумісність із потрібною установкою. Побудуйте короткий випробувальний контур."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.391DC3C123149AAF.title": "Заряджене залізо для сонячного нагрівання"
  "quest.391DC3C123149AAF.quest_desc": [
    "Спочатку зробіть перші FE генератором і зарядіть залізо в енергізаторі. Самі сонячні нагрівальні пластини передають тепло, а не виробляють FE напряму."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.74FE47379C7F91CF.title": "Поліпшене сонячне тепло"
  "quest.74FE47379C7F91CF.quest_desc": [
    "Оновіть сонячну установку та перевірте її тепловіддачу. Збережіть місце для розширення трубопроводів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0D11F03AF0769615.title": "Перезаряджене залізо"
  "quest.0D11F03AF0769615.quest_desc": [
    "Обробіть залізо заряджувачем. Матеріал потрібний для розвитку електричних і теплових пристроїв New Age."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4DEE85823517CCE1.title": "Магнетит"
  "quest.4DEE85823517CCE1.quest_desc": [
    "Підготуйте магнітні блоки для генератора. Їх розташування в установці впливає на роботу генерації."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7CAFFF433859B397.title": "Передавання FE"
  "quest.7CAFFF433859B397.quest_desc": [
    "З'єднувачі та дроти передають електрику між машинами New Age. Перевірте, чи заряджається тестовий споживач."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.23D1FE3A9A12A0A5.title": "Мідний дріт"
  "quest.23D1FE3A9A12A0A5.quest_desc": [
    "Підготуйте дріт для електричних з'єднань. Налаштуйте лінію виробництва, якщо мережа стане великою."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.728F702948EA452B.title": "Поліпшений заряджувач"
  "quest.728F702948EA452B.quest_desc": [
    "Збільште можливості заряджання та підведіть достатньо FE. Перевірте швидкість і витрати ресурсів у JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.71714514BD74B567.title": "Перезаряджене золото"
  "quest.71714514BD74B567.quest_desc": [
    "Підготуйте золото для наступних поліпшень. Вирівняйте подавання предметів із продуктивністю заряджувача."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2401B1B45D19047F.title": "Перезаряджений діамант"
  "quest.2401B1B45D19047F.quest_desc": [
    "Освойте поліпшення діамантів. Це дорога бічна гілка, тому спершу стабілізуйте енергопостачання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.391D2200EB63B00B.title": "Посилений заряджувач"
  "quest.391D2200EB63B00B.quest_desc": [
    "Зберіть найпотужніший заряджувач цієї гілки. Підключіть достатню генерацію та запас енергії."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6F654BE6B2EAF4B2.title": "Електричний привід New Age"
  "quest.6F654BE6B2EAF4B2.quest_desc": [
    "Двигун використовує FE для механічної роботи. Перевірте доступну потужність і потрібні налаштування обертання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1C5DC8BF2C9462ED.title": "Редстоуновий магніт"
  "quest.1C5DC8BF2C9462ED.quest_desc": [
    "Поліпшіть магнітну частину генератора. Порівняйте результат із попереднім варіантом за однакових обертів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.00722AF32CCE4C4D.title": "Шаруватий магніт"
  "quest.00722AF32CCE4C4D.quest_desc": [
    "Підготуйте наступний рівень магнітних блоків. Повторюйте перевірку генератора після кожного оновлення."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.41A818F7D90F3F1F.title": "Поліпшений магнетит"
  "quest.41A818F7D90F3F1F.quest_desc": [
    "Освойте складніший магнітний матеріал. Не витрачайте його на повну заміну установки без перевірки рецепта і приросту генерації."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.54BFCBC703CE8683.title": "Незеритовий магніт"
  "quest.54BFCBC703CE8683.quest_desc": [
    "Дороге поліпшення для розвиненої генераторної установки. Ця гілка залишається додатковою для переходу до етапу 1."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.462BF4BBBA2A4158.title": "Заряджений залізний кабель"
  "quest.462BF4BBBA2A4158.quest_desc": [
    "Підготуйте матеріал або пристрій для розвитку New Age. Перевірте потрібну операцію, кількість FE та умови обробки через JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0CC184B7805EC1FB.title": "Заряджений золотий кабель"
  "quest.0CC184B7805EC1FB.quest_desc": [
    "Підготуйте матеріал або пристрій для розвитку New Age. Перевірте потрібну операцію, кількість FE та умови обробки через JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.75F91F9610DC3688.title": "Заряджений діамантовий кабель"
  "quest.75F91F9610DC3688.quest_desc": [
    "Підготуйте матеріал або пристрій для розвитку New Age. Перевірте потрібну операцію, кількість FE та умови обробки через JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1F325D7D845FBF98.title": "Поліпшений електродвигун"
  "quest.1F325D7D845FBF98.quest_desc": [
    "Оновіть привід після збільшення виробництва FE. Перевірте, чи не перевантажує він механічну мережу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.01E015B7A58169A5.title": "Камінь для технологій"
  "quest.01E015B7A58169A5.quest_desc": [
    "Підготуйте камінь як сировину для рецептів. Це допоміжний ресурс, а не окремий технологічний перехід."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.060FE557F394A823.title": "Глина"
  "quest.060FE557F394A823.quest_desc": [
    "Підготуйте глину для виробничих рецептів. Спосіб її застосування перевірте через JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6B880FF9F29CD24F.title": "Міксер і чаша"
  "quest.6B880FF9F29CD24F.quest_desc": [
    "Міксер працює над чашею. Для частини рецептів потрібні достатня швидкість і нагрівання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.22091C25ACFA13CE.title": "Тепловий насос"
  "quest.22091C25ACFA13CE.quest_desc": [
    "Налаштуйте кероване передавання тепла. Перед запуском реакторної гілки випробуйте його на безпечному джерелі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2AA4CB4C6F9EE4C7.title": "Корпус реактора New Age"
  "quest.2AA4CB4C6F9EE4C7.quest_desc": [
    "Підготуйте корпуси для власного реактора цього аддона. Схему складання дивіться в ігрових підказках та Ponder."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.08328B5233DA1981.title": "Реакторні секції"
  "quest.08328B5233DA1981.quest_desc": [
    "Підготуйте скло та стрижні реактора. Заздалегідь визначте розташування палива й тепловідведення."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.66CEC7BF7FE2F047.title": "Андезитовий передавач"
  "quest.66CEC7BF7FE2F047.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.52F5C02E8968DB1A.title": "Паливо і відведення тепла"
  "quest.52F5C02E8968DB1A.quest_desc": [
    "Встановіть паливний приймач та тепловий вихід. Спочатку забезпечте відведення тепла, потім подавайте паливо."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.050CDCB0B5BF5A74.title": "Перевірка реактора New Age"
  "quest.050CDCB0B5BF5A74.quest_desc": [
    "Перед запуском перевірте паливо, відведення тепла та керування. Це ручне підтвердження, а не автоматичний датчик. Ядерна гілка New Age не потрібна для завершення головного маршруту етапу 1."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "chapter.587BCBE3BF9D4BBC.title": "&#8C86781.7 • &#7FF0FFC&#7CEDFFr&#78E9FFe&#75E6FFa&#71E2FFt&#6EDFFFe &#6BDBFFC&#67D8FFr&#64D5FFa&#61D1FFf&#5DCEFFt&#5ACAFFs &#56C7FFa&#53C3FFn&#50C0FFd &#4CBDFFA&#49B9FFd&#46B6FFd&#42B2FFi&#3FAFFFt&#3BABFFi&#38A8FFo&#38A5FFn&#38A1FFs &#389EFF— &#379AFFд&#3797FFо&#3794FFд&#3790FFа&#378DFFт&#378AFFк&#3786FFо&#3683FFв&#367FFFа &#367CFFг&#3679FFе&#3675FFн&#3672FFе&#366FFFр&#356BFFа&#3568FFц&#3564FFі&#3561FFя"
  "chapter.587BCBE3BF9D4BBC.chapter_subtitle": [
    "Етап 1 • Генерація FE, пневматика та автоматизація"
  ]
  "quest.00704510A54E7DF0.title": "Генератор FE"
  "quest.00704510A54E7DF0.quest_desc": [
    "Генератор перетворює обертання Create на FE. Підключіть джерело обертання, а електричний вихід спрямуйте до накопичувача або Flux Plug."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.33EEB3D725C53BE6.title": "Електродвигун"
  "quest.33EEB3D725C53BE6.quest_desc": [
    "Електродвигун перетворює FE на обертання. Не замикайте двигун і генератор у спробі створити нескінченну енергію."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.78F10EC46B8120E3.title": "Електричні з'єднувачі"
  "quest.78F10EC46B8120E3.quest_desc": [
    "Закріпіть з'єднувачі та протягніть між ними дріт зі шпулі. Перевірте з'єднання з накопичувачем і споживачем."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4C4D218D94F1A863.title": "Шпуля дроту"
  "quest.4C4D218D94F1A863.quest_desc": [
    "Шпулею з'єднують електричні точки Crafts and Additions. Дотримуйтеся допустимої довжини окремого з'єднання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1C1558A30887211D.title": "Прокатний стан"
  "quest.1C1558A30887211D.quest_desc": [
    "Виготовляйте дріт і стрижні механічним прокатуванням. Підведіть обертання й звірте доступні рецепти в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.14E877A80201B230.title": "Котушка Тесли"
  "quest.14E877A80201B230.quest_desc": [
    "Подайте FE та перевірте застосування котушки у підказках і JEI. Відведіть окреме місце для її роботи."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2069DD7BA2721DD5.title": "Модульний акумулятор"
  "quest.2069DD7BA2721DD5.quest_desc": [
    "Поставте накопичувач між генератором і споживачами. Запас FE згладжує короткі піки навантаження."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1235FE69FD6C910C.title": "Живлення рухомої конструкції"
  "quest.1235FE69FD6C910C.quest_desc": [
    "Сумістіть нерухомий і рухомий енергетичні інтерфейси. Перевірте передавання FE на тестовій конструкції."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.30DDFD67D82C6428.title": "Конденсатор"
  "quest.30DDFD67D82C6428.quest_desc": [
    "Підготуйте конденсатори для електричних машин. Налагодьте постачання листів і дроту."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6558DFB334EE49B2.title": "Рідке паливо для пальника"
  "quest.6558DFB334EE49B2.quest_desc": [
    "Модифікація пальника дозволяє працювати з відповідними рідкими паливами. Перевірте сумісність палива в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.23B804BB03172052.title": "&#8C86780.5 • &#7FF0FFC&#79EAFFr&#74E4FFe&#6EDFFFa&#68D9FFt&#63D3FFe&#5DCDFF: &#57C8FFE&#52C2FFn&#4CBCFFc&#46B6FFh&#41B1FFa&#3BABFFn&#38A5FFt&#389FFFm&#379AFFe&#3794FFn&#378EFFt &#3789FFI&#3683FFn&#367DFFd&#3678FFu&#3672FFs&#356CFFt&#3567FFr&#3561FFy"
  "chapter.23B804BB03172052.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.6D9C074B419B0D39.title": "Шматочок досвіду"
  "quest.6D9C074B419B0D39.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.776C6F7D1A810DB1.title": "Механічне точило"
  "quest.776C6F7D1A810DB1.quest_desc": [
    "Знімайте досвід із відповідних предметів механічною обробкою. Підготуйте злив і резервуар для рідкого досвіду."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0D25F0D38FE6572A.title": "Блок досвіду"
  "quest.0D25F0D38FE6572A.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.67D408EF9244F549.title": "Люк досвіду"
  "quest.67D408EF9244F549.quest_desc": [
    "Люк пов'язує досвід гравця з виробничою системою. Підключіть його до сховища та перевірте напрямок передавання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.354635C98B7AB854.title": "Ліхтар досвіду"
  "quest.354635C98B7AB854.quest_desc": [
    "Підготуйте пристрій для роботи з досвідом. Використовуйте підказки блока, щоб правильно підключити його до мережі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.627009467A3FB616.title": "Мідні компоненти"
  "quest.627009467A3FB616.quest_desc": [
    "Підготуйте громовідвід як компонент рецепта. Його подальші застосування в аддоні дивіться в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.035A5B1C85A75222.title": "Наддосвід"
  "quest.035A5B1C85A75222.quest_desc": [
    "Освойте перетворення досвіду на поліпшений ресурс. Повну послідовність і умови обробки дивіться в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.04B05A72F0276D94.title": "Торт досвіду"
  "quest.04B05A72F0276D94.quest_desc": [
    "Виготовте спеціальний торт за рецептом аддона. Залиште достатній запас досвіду для основної лінії зачарувань."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.744599E7C08A46C3.title": "Коваль і зачаровувач"
  "quest.744599E7C08A46C3.quest_desc": [
    "Підготуйте автоматизацію зачарувань та обробки спорядження. Окремо організуйте подавання предметів і потрібних ресурсів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.78AC40226F08E069.title": "Друк зачарувань"
  "quest.78AC40226F08E069.quest_desc": [
    "Налаштуйте друкарську лінію та постачання досвіду. Перевірте рецепт потрібної книги й умови копіювання в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.160D0BFB66F1846F.title": "&#8C86780.6 • &#7FF0FFA&#78E9FFe&#71E2FFr&#6BDBFFo&#64D5FFn&#5DCEFFa&#56C7FFu&#50C0FFt&#49B9FFi&#42B2FFc&#3BABFFs &#38A5FFт&#389EFFа &#3797FFS&#3790FFi&#378AFFm&#3683FFu&#367CFFl&#3675FFa&#366FFFt&#3568FFe&#3561FFd"
  "chapter.160D0BFB66F1846F.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.340BB533188663AC.title": "Андезитовий корпус"
  "quest.340BB533188663AC.quest_desc": [
    "Обробіть обтесану колоду андезитовим сплавом. Корпуси потрібні більшості ранніх машин Create."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.17DF4EE3EB7612D7.title": "Клей для фізичних конструкцій"
  "quest.17DF4EE3EB7612D7.quest_desc": [
    "Цей клей використовується для збирання фізичних конструкцій Simulated. Перевірте межі склеювання на невеликій платформі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.34F4B5D96AACBC2C.title": "Мед для клею"
  "quest.34F4B5D96AACBC2C.quest_desc": [
    "Збирайте мед у пляшки для виготовлення клею. Автоматична пасіка допоможе забезпечити серійне складання конструкцій."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.47F85DA12F2C3AF6.title": "Складання двигуна"
  "quest.47F85DA12F2C3AF6.quest_desc": [
    "Підготуйте основні вузли для переносного двигуна. Звірте доступні рецепти та етапи обробки в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1E83FF330B6CA620.title": "Переносний двигун"
  "quest.1E83FF330B6CA620.quest_desc": [
    "Створіть білий переносний двигун та перевірте його підключення до конструкції. У цій адаптації колір зафіксований, щоб не вимагати FTB Filter System."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0E97147184C995B1.title": "Фізична конструкція"
  "quest.0E97147184C995B1.quest_desc": [
    "Збирач перетворює підготовлені блоки на фізичну конструкцію. Почніть з маленької платформи без дорогих машин."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.34F1B081273D181F.title": "Тросові з'єднання"
  "quest.34F1B081273D181F.quest_desc": [
    "З'єднайте сумісні тросові деталі та перевірте рух. Не починайте випробування з важкого вантажу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1EA2D98A60FBB9C9.title": "Ручне керування"
  "quest.1EA2D98A60FBB9C9.quest_desc": [
    "Додайте руків'я для взаємодії з фізичною конструкцією. Перевірте його дію на нерухомому прототипі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3DA5AEC9D53435CD.title": "Схема конструкції"
  "quest.3DA5AEC9D53435CD.quest_desc": [
    "Підготуйте інструмент роботи з конструкціями. Перед використанням збережіть матеріали для відновлення прототипу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.618A5F1F97B43EEE.title": "Шнекова передача"
  "quest.618A5F1F97B43EEE.quest_desc": [
    "Підготуйте вал і зубчасту деталь шнека. Випробуйте передавання руху між сумісними фізичними вузлами."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.64976CC3D755B6A0.title": "Стикування"
  "quest.64976CC3D755B6A0.quest_desc": [
    "Стикувальний вузол допомагає поєднувати конструкції. Перед зближенням зменшіть швидкість і перевірте орієнтацію."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.12182087891641AE.title": "Оптичний датчик"
  "quest.12182087891641AE.quest_desc": [
    "Поставте датчик та перевірте його сигнал у простій схемі. Використовуйте результат для керування конструкцією."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.59ACC9542FB521B6.title": "Прилади керування"
  "quest.59ACC9542FB521B6.quest_desc": [
    "Зберіть датчики висоти, швидкості й орієнтації та органи керування. Перевірте кожен канал окремо до випробування транспорту."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.59239B38F0A336B7.title": "Поворотний вузол"
  "quest.59239B38F0A336B7.quest_desc": [
    "Підшипник дозволяє частинам конструкції повертатися одна відносно одної. Перевірте межі руху без навантаження."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.25B6CF8DF07B75F1.title": "Тросова лебідка"
  "quest.25B6CF8DF07B75F1.quest_desc": [
    "Підготуйте лебідку для піднімання та утримання вантажу. Почніть з короткого троса і легкої платформи."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7EE4728F4E22D86F.title": "Аналогова передача"
  "quest.7EE4728F4E22D86F.quest_desc": [
    "Випробуйте керування передаванням обертання. Звірте налаштування вузла з його ігровими підказками."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.219B30EBFD50954A.title": "Керований магніт"
  "quest.219B30EBFD50954A.quest_desc": [
    "Перевірте магнітну взаємодію та реакцію на редстоун. Тримайте рухомі частини подалі від основних виробничих ліній."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.10FE409FCE05E272.title": "Важіль тяги"
  "quest.10FE409FCE05E272.quest_desc": [
    "Додайте керування потужністю приводу. Випробовуйте транспорт від мінімальної тяги та поступово підвищуйте її."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.32B03E2F31EF9592.title": "Бездротові приймачі"
  "quest.32B03E2F31EF9592.quest_desc": [
    "Налаштуйте канали та частоти керування. Перевірте правильність напрямку й величини сигналу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.440955425D931992.title": "Лазерні датчики"
  "quest.440955425D931992.quest_desc": [
    "Сумістіть джерело променя з приймачем. Перевірте, як схема реагує на зміщення або перекриття променя."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.188A34A9984B70DF.title": "Гіроскопічна механіка"
  "quest.188A34A9984B70DF.quest_desc": [
    "Підготуйте гіроскопічний механізм для стабілізаційних вузлів. Остаточний рецепт дивіться в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.07C3A3E4F82545AE.title": "Електричні вузли Simulated"
  "quest.07C3A3E4F82545AE.quest_desc": [
    "Зберіть індуктор та акумулятор. Перевірте сумісне підключення до приладів фізичної конструкції."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3424AAC35D70C7D9.title": "Торсіонна пружина"
  "quest.3424AAC35D70C7D9.quest_desc": [
    "При поданні обертання знизу пружина повертається на заданий кут. Після зняття приводу вона повертається до початкового положення."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3EEB16B4C1B7688A.title": "Дистанційний ввід"
  "quest.3EEB16B4C1B7688A.quest_desc": [
    "Підключіть пристрій до сумісного приймача та перевірте передавання вводу на тестовій конструкції."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.284ECB887F2F9572.title": "Позначення транспорту"
  "quest.284ECB887F2F9572.quest_desc": [
    "Підпишіть транспорт і його призначення. У великому ангарі зрозумілі назви допомагають не плутати прототипи."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4303B3E2067069C1.title": "Переносний двигун"
  "quest.4303B3E2067069C1.quest_desc": [
    "Створіть білий переносний двигун та перевірте його підключення до конструкції. У цій адаптації колір зафіксований, щоб не вимагати FTB Filter System."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.25807E4BBAF3CA29.title": "Окуляри авіатора"
  "quest.25807E4BBAF3CA29.quest_desc": [
    "Підготуйте спорядження для роботи з повітряними конструкціями. Перевірте додаткові підказки під час огляду вузлів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4BDE4CE34C4FC15F.title": "Паровий вузол Aeronautics"
  "quest.4BDE4CE34C4FC15F.quest_desc": [
    "Ознайомтеся з роботою парового вузла у Ponder. Складіть невелику установку та перевірте потрібні з'єднання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6919C815C1D2A30D.title": "Підшипник пропелера"
  "quest.6919C815C1D2A30D.quest_desc": [
    "Приєднайте пропелер і підведіть привод. Перевірте напрямок тяги до встановлення вузла на літальний апарат."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.773767CAF463E3AF.title": "Керований пальник"
  "quest.773767CAF463E3AF.quest_desc": [
    "Підготуйте кероване джерело нагрівання. Перевірте подавання палива та реакцію на зміну керування."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2931398C209C8E6F.title": "Керування напрямком тяги"
  "quest.2931398C209C8E6F.quest_desc": [
    "Гіроскопічний вузол додає можливості керування пропелером. Випробуйте його на невеликому стенді."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7CA19EC0DA07D194.title": "Керований пропелер"
  "quest.7CA19EC0DA07D194.quest_desc": [
    "З'єднайте пропелер із відповідним приводом. Під час налаштування змінюйте один параметр за раз."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6273EF2472768C8D.title": "Перші пропелери"
  "quest.6273EF2472768C8D.quest_desc": [
    "Підготуйте дерев'яний і андезитовий варіанти. Порівняйте їхню поведінку на однаковій випробувальній конструкції."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.29A914AFAFE68DA8.title": "Бортове обладнання"
  "quest.29A914AFAFE68DA8.quest_desc": [
    "Встановіть гармату на тестову платформу та перевірте її керування. Цей додатковий вузол не потрібний для переходу до етапу 1."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.30E68023426B7F91.title": "Оболонка дирижабля"
  "quest.30E68023426B7F91.quest_desc": [
    "Підготуйте оболонку та спроєктуйте повітряну конструкцію з урахуванням маси. Не розміщуйте весь склад на першому прототипі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2EF9B30B16B2D6FE.title": "Матеріали Краю"
  "quest.2EF9B30B16B2D6FE.quest_desc": [
    "Освойте рецепт порошку каменю Краю. Це додаткова пізня гілка Aeronautics, а не обов'язковий вхід до етапу 1."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.65746034EC53A95B.title": "Суміш левітиту"
  "quest.65746034EC53A95B.quest_desc": [
    "Підготуйте суміш за рецептом JEI. Залиште матеріали Краю для цієї додаткової гілки."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5C469F2C60F211CA.title": "Музика в ангарі"
  "quest.5C469F2C60F211CA.quest_desc": [
    "Знайдіть платівку аддона. Це колекційне додаткове завдання, яке не блокує технологічний перехід."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.138685CAF0CE550A.title": "&#8C86780.7 • &#7FF0FFC&#74E5FFr&#69DAFFe&#5ECFFFa&#53C4FFt&#48B9FFe&#3DAEFF: &#38A3FFO&#3798FFf&#378DFFf&#3682FFr&#3677FFo&#356CFFa&#3561FFd"
  "chapter.138685CAF0CE550A.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.0883FCDA81C0AA49.title": "Переносний двигун"
  "quest.0883FCDA81C0AA49.quest_desc": [
    "Створіть білий переносний двигун та перевірте його підключення до конструкції. У цій адаптації колір зафіксований, щоб не вимагати FTB Filter System."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6EFDAF415805EB8F.title": "Колісний транспорт"
  "quest.6EFDAF415805EB8F.quest_desc": [
    "Підготуйте кріплення та з'єднайте колесо з фізичною конструкцією. Спочатку випробуйте просте шасі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2BB3E25D6705AD2B.title": "Бурильна головка"
  "quest.2BB3E25D6705AD2B.quest_desc": [
    "Зберіть вузол для робочої головки й перевірте його обертання. Випробувальна ділянка має бути вільна від будівель."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.09B81F8C158A38ED.title": "Різальне колесо"
  "quest.09B81F8C158A38ED.quest_desc": [
    "Поєднайте колесо з відповідним приводом. Перевірте напрямок і робочу зону на безпечному прототипі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.47856712B892C51F.title": "Блок промислового заліза"
  "quest.47856712B892C51F.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.15D72E0CC94EDC9C.title": "Малі колеса"
  "quest.15D72E0CC94EDC9C.quest_desc": [
    "Почніть із легкого шасі та малого колеса. Перевірте висоту кріплень і контакт із поверхнею."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1A3AC485FE7CA5CA.title": "Стандартні колеса"
  "quest.1A3AC485FE7CA5CA.quest_desc": [
    "Зберіть базовий комплект коліс. Перед поїздкою перевірте повороти, гальмування та стійкість машини."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5904C217975DE437.title": "Великі колеса"
  "quest.5904C217975DE437.quest_desc": [
    "Перебудуйте шасі під більші колеса. Залиште місце для повороту та руху підвіски."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.74C5ABBE7C0233B1.title": "Важкий позашляховик"
  "quest.74C5ABBE7C0233B1.quest_desc": [
    "Величезні колеса призначені для великих конструкцій. Це додаткова гілка: компактний транспорт теж завершує базові випробування."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.33F01523537DC808.title": "&#8C86780.8 • &#7FF0FFC&#78E9FFo&#71E2FFp&#6ADAFFy&#63D3FFc&#5CCCFFa&#54C5FFt&#4DBEFFs&#46B6FF+ &#3FAFFFт&#38A8FFа &#38A1FFC&#379AFFr&#3793FFe&#378CFFa&#3684FFt&#367DFFe &#3676FFD&#366FFFe&#3568FFc&#3561FFo"
  "chapter.33F01523537DC808.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.4B1C56CE6EB40935.title": "Архітектура фабрики"
  "quest.4B1C56CE6EB40935.quest_desc": [
    "Copycats+ надає блоки з обраною текстурою, Create Deco — промислові декоративні деталі. Create: Dragons Plus є бібліотекою для Enchantment Industry; окремого виробництва для неї немає."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.52B0888F526327E5.title": "Матеріал на вибір"
  "quest.52B0888F526327E5.quest_desc": [
    "Надайте копіювальним блокам вигляд обраного матеріалу. Використайте їх для охайного корпусу майстерні."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.66915998266FF37F.title": "Сходи, панелі та перекриття"
  "quest.66915998266FF37F.quest_desc": [
    "Спробуйте різні форми Copycats+. Переконайтеся, що декоративні блоки не заважають конвеєрам."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.25E6909DF86BCBFC.title": "Декор механічних вузлів"
  "quest.25E6909DF86BCBFC.quest_desc": [
    "Змініть вигляд кінетичних деталей і перевірте передавання обертання після оформлення."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.74BE3550A03BB2D6.title": "Промислові переходи"
  "quest.74BE3550A03BB2D6.quest_desc": [
    "Прокладіть зручний маршрут для обслуговування машин. Залиште доступ до входів і виходів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.14910B3F52EAEC08.title": "Каркас цеху"
  "quest.14910B3F52EAEC08.quest_desc": [
    "Підготуйте опори й огорожі для фабрики. Це оформлення, яке не замінює роботу механізмів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.32DD943ECA627BFC.title": "Освітлення цеху"
  "quest.32DD943ECA627BFC.quest_desc": [
    "Освітіть проходи та робочі зони. Перевірте вигляд промислових ламп на майбутньому фасаді."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.52EACA982FFF55A3.title": "&#8C86780.9 • &#7FF0FFC&#77E8FFr&#6EDFFFe&#66D7FFa&#5ECEFFt&#55C6FFe &#4DBDFFS&#45B5FFl&#3CACFFi&#38A4FFc&#379BFFe &#3793FFa&#378BFFn&#3682FFd &#367AFFD&#3672FFi&#3569FFc&#3561FFe"
  "chapter.52EACA982FFF55A3.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.1F3425964EF20307.title": "Автоматична нарізка"
  "quest.1F3425964EF20307.quest_desc": [
    "Механічний різак автоматизує відповідні операції Farmer’s Delight. Підготуйте інструмент, обертання, подавання продуктів і вихід результату."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.66AA28853AF6513D.title": "Зрошення ферми"
  "quest.66AA28853AF6513D.quest_desc": [
    "Підготуйте воду для зрошувачів та перевірте робочу область. Порівняйте звичайне й підлогове розміщення."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.70A33CD3C2A080E7.title": "Добриво"
  "quest.70A33CD3C2A080E7.quest_desc": [
    "Налагодьте виробництво добрива за рецептом JEI. Перевірте сумісне застосування на випробувальній грядці."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.3F75FC4382C6D0A8.title": "&#8C86780.10 • &#7FF0FFT&#77E8FFo&#6EDFFFm&#66D7FF’&#5ECEFFs &#55C6FFS&#4DBDFFi&#45B5FFm&#3CACFFp&#38A4FFl&#379BFFe &#3793FFS&#378BFFt&#3682FFo&#367AFFr&#3672FFa&#3569FFg&#3561FFe"
  "chapter.3F75FC4382C6D0A8.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.04D03F478CBBA3DD.title": "Серце складу"
  "quest.04D03F478CBBA3DD.quest_desc": [
    "З'єднувач інвентарів об'єднує підключені контейнери в спільне сховище. Поставте його біля скринь і перевірте доступ до предметів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0D2C72BA0554430D.title": "Об'єднання контейнерів"
  "quest.0D2C72BA0554430D.quest_desc": [
    "Декоративні з'єднувальні блоки допомагають поєднувати скрині з мережею. Побудуйте невеликий склад і перевірте його межі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6F26C1598CCD5141.title": "Один термінал для всіх скринь"
  "quest.6F26C1598CCD5141.quest_desc": [
    "Термінал дозволяє шукати, забирати й повертати предмети у спільний склад. Перевірте, що кожна скриня доступна."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6A12D372060CBE70.title": "Складські кабелі"
  "quest.6A12D372060CBE70.quest_desc": [
    "Прокладіть кабель до віддалених контейнерів. Відокремте основну лінію від місць, де згодом з'являться нові машини."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5E10D0010B4688D7.title": "Підключення віддаленої скрині"
  "quest.5E10D0010B4688D7.quest_desc": [
    "Кабельний з'єднувач підключає інвентар до прокладеної лінії. Перевірте появу вмісту скрині в терміналі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.757C00535BCE6C26.title": "Приймання продукції"
  "quest.757C00535BCE6C26.quest_desc": [
    "Складська воронка спрямовує предмети до потрібного контейнера. За потреби обмежте приймання фільтром."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1E833B910ABD7397.title": "Склад із верстаком"
  "quest.1E833B910ABD7397.quest_desc": [
    "Крафтовий термінал використовує ресурси спільного складу. Це зручний ручний крафт; повноцінний автокрафт AE2 з'явиться пізніше."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.607DC4793083D2DA.title": "Бездротовий доступ"
  "quest.607DC4793083D2DA.quest_desc": [
    "Прив'яжіть термінал до мережі й перевірте радіус доступу. Дальність залежить від можливостей установленої версії та її налаштувань."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.69F94BEC02BF5EED.title": "Поліпшений бездротовий доступ"
  "quest.69F94BEC02BF5EED.quest_desc": [
    "Поліпшіть термінал і перевірте вимоги до дальності та міжвимірного доступу. Не припускайте, що він відразу працює всюди."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4C1F4F36621745C6.title": "Вибіркове сортування"
  "quest.4C1F4F36621745C6.quest_desc": [
    "Налаштуйте набір дозволених або заборонених предметів. Встановіть фільтр у сумісний пристрій та перевірте тестову партію."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.1C080FBDFEABA558.title": "&#8C86781.3 • &#7FF0FFE&#7AEBFFx&#76E7FFt&#71E2FFr&#6DDDFFe&#68D9FFm&#64D4FFe &#5FCFFFR&#5ACBFFe&#56C6FFa&#51C2FFc&#4DBDFFt&#48B8FFo&#43B4FFr&#3FAFFFs &#3AAAFF— &#38A6FFп&#38A1FFо&#389DFFт&#3798FFу&#3793FFж&#378FFFн&#378AFFа &#3786FFг&#3681FFе&#367CFFн&#3678FFе&#3673FFр&#366FFFа&#356AFFц&#3566FFі&#3561FFя"
  "chapter.1C080FBDFEABA558.chapter_subtitle": [
    "Етап 1 • Генерація FE, пневматика та автоматизація"
  ]
  "quest.7C4C3C09785571BB.title": "Паливо реактора"
  "quest.7C4C3C09785571BB.quest_desc": [
    "Знайдіть руду й підготуйте єлорієве паливо. Звіряйте допустимі замінники через JEI: ця збірка не використовує рецепти чужого модпаку."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.095D066A1699126E.title": "Графіт"
  "quest.095D066A1699126E.quest_desc": [
    "Переплавте вугілля або деревне вугілля за рецептом мода. Графіт потрібний корпусам і внутрішнім деталям реактора."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.45E2529FBAAAE646.title": "Корпус і скло реактора"
  "quest.45E2529FBAAAE646.quest_desc": [
    "Каркас збирайте з корпусів, а дозволені площини можна закривати реакторним склом. Не змішуйте базові та посилені деталі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6BD9A59F5230C6DD.title": "Контролер базового реактора"
  "quest.6BD9A59F5230C6DD.quest_desc": [
    "Поставте один контролер у допустимій стінці конструкції. У цій збірці він доступний на етапі 0 і не потребує ядерного блока Mekanism."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.603D13470C84AC2F.title": "Паливні та керувальні стрижні"
  "quest.603D13470C84AC2F.quest_desc": [
    "Паливні стрижні розміщуються всередині, а керувальний вузол завершує відповідну колону зверху. Перевірте складання за ігровою книгою."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3B9405455237AEBD.title": "Вихід електроенергії"
  "quest.3B9405455237AEBD.quest_desc": [
    "Енергетичний порт віддає FE споживачам. Підключіть накопичувач або Flux Plug, а потім перевірте реальну передачу енергії."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0C4AB63A850A0127.title": "Перший запуск"
  "quest.0C4AB63A850A0127.quest_desc": [
    "Порт доступу завантажує паливо та вивантажує відпрацьований матеріал. Перед запуском перевірте цілісність реактора і можливість відведення енергії."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.45016B99351D2AD7.title": "Ціаніт: результат роботи"
  "quest.45016B99351D2AD7.quest_desc": [
    "Заберіть ціаніт із відпрацьованого палива. Не викидайте його: він потрібний турбінній гілці."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2C549CE0582910AA.title": "Флюїдизатор"
  "quest.2C549CE0582910AA.quest_desc": [
    "Флюїдизатор — окрема багатоблочна установка для роботи з матеріалами й рідинами Extreme Reactors. Повний набір портів та рецепти звіряйте з книгою і JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.60B5EBCF80D2F94C.title": "Корпус турбіни"
  "quest.60B5EBCF80D2F94C.quest_desc": [
    "Підготуйте корпуси й контролер турбіни. Турбіна потребує пари; наявність базового реактора сама по собі ще не створює паровий контур."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7AB175F347ABB264.title": "Замкнений паровий контур"
  "quest.7AB175F347ABB264.quest_desc": [
    "Підключіть вхід пари, вихід води та енергетичний порт турбіни. Для пари підготуйте відповідний активно охолоджуваний посилений реактор."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.692720AE0E139C2A.title": "Ротор турбіни"
  "quest.692720AE0E139C2A.quest_desc": [
    "Зберіть підшипник, вал і лопаті ротора. Після подавання пари налаштовуйте витрату та швидкість за показниками контролера."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0227EB05FC2CB150.title": "Реактор для виробництва пари"
  "quest.0227EB05FC2CB150.quest_desc": [
    "Підготуйте посилений реактор із рідинними портами. Для парової турбіни потрібні подавання води, відведення пари та повернення конденсату; звірте повну конструкцію з книгою Extreme Reactors."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.10B2AEF4B0B869FA.title": "&#8C86781.4 • &#7FF0FFF&#7AEAFFl&#74E5FFu&#6FDFFFx &#69DAFFN&#64D4FFe&#5ECFFFt&#59C9FFw&#53C4FFo&#4EBEFFr&#48B9FFk&#43B3FFs &#3DAEFF— &#38A8FFм&#38A3FFе&#389DFFр&#3798FFе&#3792FFж&#378DFFа &#3787FFж&#3682FFи&#367CFFв&#3677FFл&#3671FFе&#356CFFн&#3566FFн&#3561FFя"
  "chapter.10B2AEF4B0B869FA.chapter_subtitle": [
    "Етап 1 • Генерація FE, пневматика та автоматизація"
  ]
  "quest.257B01344BB3E808.title": "Пил Flux"
  "quest.257B01344BB3E808.quest_desc": [
    "Отримайте пил Flux за спеціальним способом мода. Відкрийте його рецепт у JEI та виконайте показану взаємодію блоків у світі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2280A4544381A856.title": "Ядро Flux"
  "quest.2280A4544381A856.quest_desc": [
    "Ядра потрібні всій мережі Flux. У цій збірці ядро Flux потребує паровий блок керування — ключ завершення етапу 0."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.519D16E4D12FFA7B.title": "Вхід енергії до мережі"
  "quest.519D16E4D12FFA7B.quest_desc": [
    "Flux Plug забирає FE від джерела або накопичувача. Створіть мережу й виберіть її в налаштуваннях роз'єму."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.52B5A7767A7711E2.title": "Живлення споживачів"
  "quest.52B5A7767A7711E2.quest_desc": [
    "Flux Point віддає FE з мережі до машини. Підключіть пробний споживач і перевірте напрямок передавання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2CDE94A29C14CB6D.title": "Буфер енергії Flux"
  "quest.2CDE94A29C14CB6D.quest_desc": [
    "Підключіть накопичувач до тієї самої мережі. Налаштуйте пріоритети та перевірте заряджання й розряджання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6D41E890FFE132EF.title": "Контролер і заряджання"
  "quest.6D41E890FFE132EF.quest_desc": [
    "Контролер керує додатковими можливостями мережі, включно із заряджанням спорядження. Перевірте вкладки доступу та заряджання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.0DD589F6D6DD938F.title": "&#8C86780.0 • &#7FF0FFГ&#7BECFFо&#78E8FFл&#74E5FFо&#70E1FFв&#6CDDFFн&#69D9FFи&#65D5FFй &#61D2FFм&#5DCEFFа&#5ACAFFр&#56C6FFш&#52C3FFр&#4EBFFFу&#4BBBFFт &#47B7FFд&#43B3FFо &#3FB0FFп&#3CACFFа&#38A8FFр&#38A4FFо&#38A1FFв&#389DFFо&#3799FFг&#3795FFо &#3792FFб&#378EFFл&#378AFFо&#3786FFк&#3683FFа &#367FFFк&#367BFFе&#3677FFр&#3674FFу&#3670FFв&#356CFFа&#3568FFн&#3565FFн&#3561FFя"
  "chapter.0DD589F6D6DD938F.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.1F56346AF61F2E75.title": "Стабільна майстерня"
  "quest.1F56346AF61F2E75.quest_desc": [
    "Налагодьте повторюване виготовлення точних механізмів і подавання компонентів. Машини мають працювати без ручного перенесення кожної деталі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.675A7898161E361D.title": "Керована механіка"
  "quest.675A7898161E361D.quest_desc": [
    "Збережіть кінетичний резерв та додайте захист виробничої гілки. Вивчення всіх варіантів редукторів можна продовжити пізніше."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.61A6F32CE0BCBA30.title": "Електрика Create"
  "quest.61A6F32CE0BCBA30.quest_desc": [
    "Випробуйте обидва електричні аддони Create. Підведіть їхнє живлення до буфера; це FE, а не електрика EU з Modern Industrialization."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.79CEA1AB905A472A.title": "Лінія досвіду"
  "quest.79CEA1AB905A472A.quest_desc": [
    "Підготуйте збирання та зберігання досвіду. Пізні зачарування не обов’язкові для переходу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5EC7F7A95A84753C.title": "Транспортний прототип"
  "quest.5EC7F7A95A84753C.quest_desc": [
    "Підготуйте вузли фізичної платформи, повітряного та колісного приводу. Випробуйте конструкцію на вільному майданчику; ця предметна перевірка сама не вимірює її здатність рухатися."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7222846D7C7BBBB3.title": "Зручний склад"
  "quest.7222846D7C7BBBB3.quest_desc": [
    "Об’єднайте склад і ручний крафт. Бездротові поліпшення можна залишити на потім: цифровий автокрафт AE2 буде в наступному етапі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2A8884CC89B7F965.title": "Додаткова вправа: реактор та Flux"
  "quest.2A8884CC89B7F965.quest_desc": [
    "Після базового генератора можете зібрати реактор і перенести його FE через Flux. Ціаніт отримується під час роботи Extreme Reactors. Ця вправа не блокує електричний ключ."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2EAA89117EF0B5E6.title": "Автоматизована кухня"
  "quest.2EAA89117EF0B5E6.quest_desc": [
    "Підготуйте нарізку продуктів та зрошення ферми. З’єднайте виробництво зі складом, не допускаючи заповнення виходів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.66D70090426B0626.title": "Оформлений цех"
  "quest.66D70090426B0626.quest_desc": [
    "Використайте Copycats+ і Create Deco для доступних проходів та оформлення обладнання. Не перекривайте місця його обслуговування."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4F31880B58294AA4.title": "Етап 1 відкрито"
  "quest.4F31880B58294AA4.quest_desc": [
    "Паровий блок уже виготовлений. Переходьте до групи етапу 1: пневматика, електричні аддони Create, Extreme Reactors, Flux Networks та AE2. Інші бічні глави етапу 0 можна завершити пізніше."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "chapter.0E84C2FF869B1859.title": "&#8C86781.2 • &#7FF0FFP&#7BECFFn&#77E8FFe&#72E3FFu&#6EDFFFm&#6ADBFFa&#66D7FFt&#62D2FFi&#5ECEFFc&#59CAFFC&#55C6FFr&#51C1FFa&#4DBDFFf&#49B9FFt&#45B5FF: &#40B0FFп&#3CACFFо&#38A8FFв&#38A4FFі&#38A0FFт&#379BFFр&#3797FFя &#3793FFт&#378FFFа &#378BFFе&#3787FFл&#3682FFе&#367EFFк&#367AFFт&#3676FFр&#3672FFо&#366EFFн&#3569FFі&#3565FFк&#3561FFа"
  "chapter_group.739786B1D9F69CD4.title": "Етап 2 • Автоматизація та відновлювані ресурси"
  "chapter_group.4C4EB83B4AE6C6DF.title": "Етап 3 • Хімія, антиматерія та MekaSuit"
  "chapter_group.431F6B3590930EA6.title": "&l&#C8AE86&lД&#CAB188&lо&#CDB389&lд&#CFB68B&lа&#D1B88C&lт&#D3BB8E&lк&#D6BD90&lо&#D8C091&lв&#DAC293&lі &#DCC595&lм&#DFC796&lо&#E1CA98&lд&#E3CC99&lи &#E6CF9B&l• &#E8D29D&lК&#EAD49E&lу&#ECD7A0&lх&#EFD9A2&lн&#F1DCA3&lя&#F1DCA3&l, &#EFD9A2&lд&#ECD7A0&lо&#EAD49E&lс&#E8D29D&lв&#E6CF9B&lі&#E3CC99&lд &#E1CA98&lі &#DFC796&lд&#DCC595&lо&#DAC293&lс&#D8C091&lл&#D6BD90&lі&#D3BB8E&lд&#D1B88C&lж&#CFB68B&lе&#CDB389&lн&#CAB188&lн&#C8AE86&lя"
  "chapter.2B3B9FFC6734AA02.title": "&#8C86780.4 • &#7FF0FFВ&#79EAFFо&#74E4FFд&#6EDFFFя&#68D9FFн&#63D3FFа &#5DCDFFп&#57C8FFа&#52C2FFр&#4CBCFFа &#46B6FFC&#41B1FFr&#3BABFFe&#38A5FFa&#389FFFt&#379AFFe &#3794FFд&#378EFFл&#3789FFя &#3683FFм&#367DFFа&#3678FFш&#3672FFи&#356CFFн &#3567FFM&#3561FFI"
  "quest.7F85DABE308B137B.title": "Спільна парова мережа Create та MI"
  "quest.7F85DABE308B137B.quest_desc": [
    "Звичайний водяний резервуар Create з нагріванням знизу працює разом із новим паровим баком. Поставте бак пари поруч, подайте воду та паливо й відводьте готову пару до машин MI. Паровий двигун Create на цьому резервуарі не потрібний: він перемикає його в інший режим."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.17ED3516C52C7E99.title": "Маршрут: латунь → водяна пара → ключ"
  "quest.17ED3516C52C7E99.quest_desc": [
    "Мета — виготовити паровий блок керування. Create нагріває воду, а новий паровий бак передає справжню пару MI до перших машин. Окремий котел MI не є умовою цього маршруту."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.48F238128EE6CEC8.title": "Залізо, мідь та цинк"
  "quest.48F238128EE6CEC8.quest_desc": [
    "Знайдіть руди та переплавте їх. Цей запас є стартовим орієнтиром, а не повним кошторисом фабрики: точні витрати кожного рецепта дивіться у JEI."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.150642360267B92B.title": "Андезитові деталі"
  "quest.150642360267B92B.quest_desc": [
    "Змішайте андезит із залізними або цинковими самородками за рецептом JEI. Збережіть сплав для валів, корпусів і перших машин."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.64FAD16E0A505694.title": "Перші оберти"
  "quest.64FAD16E0A505694.quest_desc": [
    "Розмістіть колесо у потоці води. Валами й шестернями підведіть обертання до робочого місця; підвищуйте швидкість передачею великої та малої шестерень."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.697BE5FBAD2D0F64.title": "Листи для механізмів"
  "quest.697BE5FBAD2D0F64.quest_desc": [
    "Поставте прес над депо та подайте обертання. Пресуйте злитки у листи для чаші, пальника й подальших механізмів."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.664405343AC56253.title": "Нагрівання для латуні"
  "quest.664405343AC56253.quest_desc": [
    "Зробіть порожній пальник, знайдіть пломеня у Незері та впіймайте його пальником. Поверніть пальник у майстерню та підготуйте паливо."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.64AD73D5F8A0DE3D.title": "Міксер над чашею"
  "quest.64AD73D5F8A0DE3D.quest_desc": [
    "Поставте чашу над пальником, а міксер — над чашею. Підведіть потрібну швидкість обертання та ввімкніть нагрівання."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.580B411AF5980267.title": "Виробництво латуні"
  "quest.580B411AF5980267.quest_desc": [
    "Завантажте мідь і цинк у нагріту чашу. Дочекайтеся змішування; кількість матеріалів і режим нагрівання показані у рецепті JEI."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.5277720548F43C50.title": "Латунний корпус"
  "quest.5277720548F43C50.quest_desc": [
    "Зробіть латунний корпус через обробку обтесаної колоди латунню. Один корпус потрібно зберегти для центра фінального рецепта."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.0CD941CDE00DF6E8.title": "Установник для точної механіки"
  "quest.0CD941CDE00DF6E8.quest_desc": [
    "Підключіть установник до обертання. Для послідовного збирання потрібні установники з відповідними деталями над депо або конвеєром."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.6EF3FFFD51D8DEF8.title": "Перші точні механізми"
  "quest.6EF3FFFD51D8DEF8.quest_desc": [
    "Відкрийте послідовне збирання точного механізму в JEI. Виконайте всі цикли встановлення малих шестерень, великих шестерень і залізних самородків на золотий лист. Збережіть два готові механізми."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.31E1118063924D5A.title": "Водяний резервуар Create"
  "quest.31E1118063924D5A.quest_desc": [
    "Зберіть звичайний бак Create з чотирьох блоків, наприклад вертикально. Підведіть воду насосом і трубами. Під нижнім блоком розмістіть заправлений пальник; паровий двигун і свисток до цього резервуара не приєднуйте."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4FAEE165C04F1D1B.title": "Паровий бак — вихід до MI"
  "quest.4FAEE165C04F1D1B.quest_desc": [
    "Зробіть цинковий паровий бак із резервуара Create, чотирьох зливків цинку, двох залізних листів та двох блоків скла. Поставте його впритул до водяного бака збоку або зверху. Нагрітий пальник під водяним резервуаром перетворює воду на пару modern_industrialization:steam."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.18C793BADD0A9ECE.title": "Перевірка водяного та парового контурів"
  "quest.18C793BADD0A9ECE.quest_desc": [
    "Натисніть ПКМ на паровий бак: перевірте запас пари і повідомлення стану. Без води, активного нагрівання або вільного місця виробництво зупиняється. Відводьте пару трубами з механічним насосом Create або налаштованими трубами MI. Це ручне підтвердження перевірки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.09FF620975D15B98.title": "Ручний початок MI"
  "quest.09FF620975D15B98.quest_desc": [
    "Зробіть кувальний молот MI із залізних злитків і важких вагових пластин. Вивчіть його інтерфейс: ним можна підготувати деталі до запуску парових машин."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.047AE07824F05476.title": "Мідь, олово та бронза"
  "quest.047AE07824F05476.quest_desc": [
    "Підготуйте мідний та олов’яний пил за рецептами кувального молота. У верстаку з’єднайте три порції мідного пилу з однією олов’яного — у цій версії це дає три бронзові пилюки. Переплавте пил у злитки."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.21AF089CC9AEF02D.title": "Перші бронзові пластини"
  "quest.21AF089CC9AEF02D.quest_desc": [
    "До запуску компресора робіть пластини через кувальний молот. JEI показує варіанти з інструментом і без нього та їхній вихід. Пластини підуть на корпус, котел і фінальний блок."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.1FBF8EE6FAB59C85.title": "Корпус парової машини"
  "quest.1FBF8EE6FAB59C85.quest_desc": [
    "Зробіть бронзову шестерню та обкладіть її бронзовими пластинами. Рецепт початкового корпуса відновлено: він не потребує майбутнього парового блока керування."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.352566F34995ED40.title": "Пара Create без котла MI"
  "quest.352566F34995ED40.quest_desc": [
    "Підключіть вихід парового бака до парового входу машини MI. Для довгої лінії використовуйте насос Create з обертанням або налаштовані труби MI. Не з’єднуйте вихід пари назад із водяним резервуаром: це різні контури."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6C9C339BC51E1017.title": "Перша машина на парі Create"
  "quest.6C9C339BC51E1017.quest_desc": [
    "Зберіть бронзовий компресор MI та підведіть до нього пару з нового парового бака. Вільно розмістіть машину, налаштуйте потрібні сторони й випробуйте виробництво бронзової пластини. Котел MI для цієї установки не потрібний."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1350ECE7912DC569.title": "Усі складники фінального рецепта"
  "quest.1350ECE7912DC569.quest_desc": [
    "Верхній ряд: бронзова пластина посередині. Середній: точний механізм, латунний корпус, точний механізм. Нижній: мала шестерня посередині. PCB та Flux Core більше не використовуються. Вихід — чотири блоки."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "chapter.0E84C2FF869B1859.chapter_subtitle": [
    "Етап 1 • Генерація FE, пневматика та автоматизація"
  ]
  "chapter.2B3B9FFC6734AA02.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.25F191DD70B08125.title": "Паровий бак Create"
  "quest.25F191DD70B08125.quest_desc": [
    "Паровий бак має 16 000 мВ місткості. За одного активного пальника він видає до 32 мВ/т, витрачаючи воду за налаштованим співвідношенням MI: зараз 1 мВ води на 16 мВ пари. Кілька виходів одного резервуара ділять його потужність. Стан і кількість пари видно по ПКМ."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.0CC6573CD66A8678.title": "&#8C86781.0 • &#7FF0FFВ&#7BECFFі&#76E7FFд &#72E3FFп&#6EDFFFа&#69DAFFр&#65D6FFи &#61D1FFд&#5DCDFFо &#58C9FFе&#54C4FFл&#50C0FFе&#4BBCFFк&#47B7FFт&#43B3FFр&#3EAFFFи&#3AAAFFк&#38A6FFи&#38A2FF: &#389DFFг&#3799FFо&#3795FFл&#3790FFо&#378CFFв&#3788FFн&#3683FFи&#367FFFй &#367BFFм&#3677FFа&#3672FFр&#366EFFш&#356AFFр&#3565FFу&#3561FFт"
  "quest.457026115673D3A8.title": "Манометр і запобіжник"
  "quest.457026115673D3A8.quest_desc": [
    "Додайте манометр та запобіжний модуль. Обмежте компресор редстоуном; звичайна мережа не призначена для тиску понад її межу. Робочий тиск конкретного рецепта дивіться у JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.0EC0739085AE32BE.title": "Інтерфейси барокамери"
  "quest.0EC0739085AE32BE.quest_desc": [
    "Зберіть герметичну оболонку не менш ніж 3×3×3 із порожнім центром. Клапан підключає повітря; два інтерфейси служать для вводу й виводу предметів. Налаштуйте їх фільтри."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.346966B8BE99A6FC.title": "Нафта для електроніки"
  "quest.346966B8BE99A6FC.quest_desc": [
    "Знайдіть нафту й наберіть перше відро. Для безперервної роботи згодом установіть насос; у ранньому запуску достатньо подати нафту вручну."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.3350E99D46556F92.title": "Нафтопереробна колона"
  "quest.3350E99D46556F92.quest_desc": [
    "Поставте контролер знизу, чотири виходи над ним, подайте нафту й нагрівання. Повна колона дає дизель, гас, бензин і LPG. Відводьте всі фракції, щоб не заблокувати перероблення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.4FFC383AB679693F.title": "LPG → розплавлений пластик"
  "quest.4FFC383AB679693F.quest_desc": [
    "У термопневматичній установці переробіть LPG з вугіллям при потрібній температурі: штатний рецепт використовує 100 мВ LPG і вугілля для 1000 мВ пластику. Налаштування тиску, нагрівання та перенесення рідини звірте з JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.67A761C1F2FD18CD.title": "Заготовки PCB"
  "quest.67A761C1F2FD18CD.quest_desc": [
    "Зробіть заготовки в барокамері: пластик, редстоунові смолоскипи та матеріал проводки. Штатний рецепт дає три заготовки при 1,5 бар."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.3F3D41E5C5E0ED5C.title": "Креслення друкованої плати"
  "quest.3F3D41E5C5E0ED5C.quest_desc": [
    "Підключіть планшет Amadron до доступних торгових запасів та придбайте креслення PCB за 8 смарагдів. Воно потрібне для УФ-камери. Це торгова операція мода, а не безкоштовна нагорода квеста."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.4B834078117E6FD4.title": "Ультрафіолетове експонування"
  "quest.4B834078117E6FD4.quest_desc": [
    "Покладіть порожні плати в УФ-камеру та подайте стиснене повітря. Перевірте її прогрес експонування перед травленням; незавершена обробка дає ризик браку."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.30CC5B7BA91E911F.title": "Кислота для травлення"
  "quest.30CC5B7BA91E911F.quest_desc": [
    "Рецепт барокамери: відро пластику, гниле м’ясо, павучі очі та порох при 1 бар. Кількості видно у JEI. Підготуйте кислоту для ванни."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.0F7DD90C3703E34A.title": "Травлення плат"
  "quest.0F7DD90C3703E34A.quest_desc": [
    "Подайте кислоту й нагрівання у травильний бак та обробіть експоновану плату. Отримана незмонтована PCB потребує електронних компонентів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.40C034F5B93C3BBB.title": "Конденсатори й транзистори"
  "quest.40C034F5B93C3BBB.quest_desc": [
    "Зробіть компоненти в барокамері з пластику та проводки. Конденсатор потребує слизу, транзистор — редстоуну. Вони збираються без готової PCB."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.6940CD31C74B8C14.title": "Автоматичне складання плат"
  "quest.6940CD31C74B8C14.quest_desc": [
    "Після першої PCB зберіть складальну лінію. Програма лазера обробляє заготовки без УФ та кислоти; компоненти готової плати все одно потрібні. Кількості машин і програму перевірте у внутрішньому довіднику."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.51264A79F5CDE5C3.title": "Стиснене повітря → FE"
  "quest.51264A79F5CDE5C3.quest_desc": [
    "Динамо витрачає стиснене повітря й виробляє FE. Це альтернативна генерація після PCB. Не замикайте її вихід на компресор, очікуючи безкоштовної енергії."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.3DCC8C15598DA90C.title": "Flux Compressor: FE → повітря"
  "quest.3DCC8C15598DA90C.quest_desc": [
    "Коли FE уже стабільні, Flux Compressor замінює ручне підкладання палива. Підключіть FE, повітряний вихід і обмеження тиску."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.655800FD8CB51513.title": "Пневматична логістика"
  "quest.655800FD8CB51513.quest_desc": [
    "Налаштуйте модулі, мережеві фільтри та напрямки перенесення. Почніть з однієї контрольної доставки компонентів до виробничої лінії."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "chapter.156216B384661DF7.title": "&#8C86781.5 • &#7FF0FFJ&#7BECFFu&#77E8FFs&#73E4FFt &#70E0FFD&#6CDDFFi&#68D9FFr&#64D5FFe &#60D1FFT&#5CCDFFh&#59C9FFi&#55C5FFn&#51C1FFg&#4DBDFFs &#49BAFF— &#45B6FFе&#42B2FFл&#3EAEFFе&#3AAAFFк&#38A6FFт&#38A2FFр&#389EFFи&#379BFFч&#3797FFн&#3793FFа &#378FFFа&#378BFFв&#3787FFт&#3684FFо&#3680FFм&#367CFFа&#3678FFт&#3674FFи&#3670FFз&#356DFFа&#3569FFц&#3565FFі&#3561FFя"
  "quest.5EBA53DFC525FE2C.title": "Перший Primogel"
  "quest.5EBA53DFC525FE2C.quest_desc": [
    "Початковий слиз виготовляється з матеріалів Надсвіту; у цій збірці центральну землю замінює паровий блок керування. Поставте слиз біля ресурсу, що має рецепт Goo Spread у JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.459757DD4C28D398.title": "Залізо → Ferricore"
  "quest.459757DD4C28D398.quest_desc": [
    "Розмістіть залізний блок біля Primogel за схемою Goo Spread. Добудьте перетворену руду й переплавте сировину. Залишайте слизу доступ до потрібних блоків для подальшої роботи."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.1A980384DC32A698.title": "Паливо Primal Coal"
  "quest.1A980384DC32A698.quest_desc": [
    "Перетворіть вугільний блок біля слизу та добудьте поліпшене паливо. Перевірте час горіння в підказці та JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.581242B4E8A99E07.title": "Вугільний генератор FE"
  "quest.581242B4E8A99E07.quest_desc": [
    "Зберіть генератор із Ferricore, доменної печі, вугілля та редстоуну. Подайте паливо й виведіть FE до споживача; це компактна альтернатива обертовому генератору."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.26F114E7DF06F9A1.title": "Передавач енергії"
  "quest.26F114E7DF06F9A1.quest_desc": [
    "Підключіть передавач до джерела FE та налаштуйте цілі заряджання. Дальність, режими й втрати перевіряйте в інтерфейсі мода."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2147E076C2E391D5.title": "Перші інструменти Ferricore"
  "quest.2147E076C2E391D5.quest_desc": [
    "Зробіть інструмент і ключ. Використовуйте ключ для налаштування механізмів та перевіряйте доступні здібності інструмента у його інтерфейсі."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.1D135CF0912F09A0.title": "Автоматичне руйнування"
  "quest.1D135CF0912F09A0.quest_desc": [
    "Налаштуйте область і редстоуновий режим руйнівника. Перевірте, куди надходить здобич, та забезпечте FE там, де їх вимагає пристрій."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.7F26C8FA0E6B800B.title": "Автоматичне встановлення"
  "quest.7F26C8FA0E6B800B.quest_desc": [
    "Підведіть блоки до встановлювача й виберіть напрямок роботи. Поєднайте його з руйнівником для відновлюваної виробничої ділянки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.5A5A0FA34BCBAFA0.title": "Збирання предметів"
  "quest.5A5A0FA34BCBAFA0.quest_desc": [
    "Задайте зону збирання та місце виводу. Перевірте, що колектор підхоплює результати автоматичної добувної ділянки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.3F903DE2ACA7086E.title": "Автоматичний клікер"
  "quest.3F903DE2ACA7086E.quest_desc": [
    "Виберіть взаємодію, предмет і редстоунове керування. Спершу перевірте одну операцію вручну, потім увімкніть цикл."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.7F3B9CA1A8C6CB76.title": "Датчик зворотного зв’язку"
  "quest.7F3B9CA1A8C6CB76.quest_desc": [
    "Виберіть умову спрацювання та керуйте редстоуном автоматичною лінією. Датчик допомагає зупиняти роботу, коли вихід заповнений."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.3FD9F17329212961.title": "Автоматизація рідин"
  "quest.3FD9F17329212961.quest_desc": [
    "Зберіть та встановіть рідину в контрольній точці. Розділяйте резервуари й фільтруйте потрібний тип рідини; перевіряйте місткість і допустимі джерела в інтерфейсі."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.052A1462B33943E4.title": "Робоча автоматична ділянка"
  "quest.052A1462B33943E4.quest_desc": [
    "Ручна перевірка: встановлювач подає блок, руйнівник обробляє його, колектор прибирає здобич, датчик обмежує роботу. Перевірте сталість запасів і живлення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.56A4393B78B4E78D.title": "Наступний матеріал: Blazegold"
  "quest.56A4393B78B4E78D.quest_desc": [
    "Розвивайте слиз і добудьте матеріали Незеру за рецептами Goo Spread. Це додаткова гілка можливостей, а не умова електричного ключа."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.00559FAB827B25E1.title": "Поліпшені робочі блоки"
  "quest.00559FAB827B25E1.quest_desc": [
    "Порівняйте доступні зони, фільтри та витрати FE з простими версіями. Розширюйте виробничу ділянку після стабілізації живлення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.5DD2B2DD912D29DF.title": "Генератор рідкого палива"
  "quest.5DD2B2DD912D29DF.quest_desc": [
    "Підготуйте паливо Just Dire Things за його власним рецептом та подайте в паливний генератор. Рідина MI steam сама по собі не є паливом цього генератора."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.19B70DE7FFB7C74A.title": "Celestigem"
  "quest.19B70DE7FFB7C74A.quest_desc": [
    "Після розвитку попереднього слизу виконайте наступні рецепти Goo Spread та дослідіть потрібний вимір. Звіряйте матеріали з JEI установленої версії."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.0F89FD265B3048E5.title": "Eclipse Alloy"
  "quest.0F89FD265B3048E5.quest_desc": [
    "Розвивайте ресурсну гілку до четвертого слизу та сплаву. Це довгострокова додаткова ціль, яка не затримує перехід до MI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2C1DFEEAA8999FBB.title": "Кристали часу"
  "quest.2C1DFEEAA8999FBB.quest_desc": [
    "Знайдіть рецепт росту кристалів часу та автоматизуйте отримання. Використовуйте пристрої прискорення з огляду на їхні фактичні витрати й обмеження."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.1891CC691C4AF225.title": "Жезл часу"
  "quest.1891CC691C4AF225.quest_desc": [
    "Підготуйте жезл та його ресурс роботи за рецептом мода. Перевірте керування на одному механізмі, перш ніж застосовувати до великої фабрики."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.729FD65CA980E866.title": "Кишенькове заряджання"
  "quest.729FD65CA980E866.quest_desc": [
    "Заряджайте спорядження переносним джерелом. Паливо й підтримувані предмети перевіряйте за підказкою генератора."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.6898A08B278A18B9.title": "Копіювання налаштувань"
  "quest.6898A08B278A18B9.quest_desc": [
    "Скопіюйте перевірений профіль одного механізму на інші сумісні блоки. Перед масовим застосуванням перевірте фільтри й редстоуновий режим."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "chapter.6FF0AE39129AC402.title": "&#8C86781.6 • &#7FF0FFC&#7BECFFh&#77E8FFu&#73E4FFn&#6FE0FFk &#6BDBFFL&#67D7FFo&#63D3FFa&#5FCFFFd&#5ACBFFe&#56C7FFr&#52C3FFs &#4EBFFF— &#4ABBFFр&#46B6FFо&#42B2FFб&#3EAEFFо&#3AAAFFт&#38A6FFа &#38A2FFв&#389EFFі&#379AFFд&#3796FFд&#3792FFа&#378EFFл&#378AFFе&#3786FFн&#3681FFо&#367DFFї &#3679FFф&#3675FFа&#3671FFб&#366DFFр&#3569FFи&#3565FFк&#3561FFи"
  "quest.3FB085B74304C664.title": "Базовий завантажувач чанків"
  "quest.3FB085B74304C664.quest_desc": [
    "Зберіть завантажувач із паровим блоком керування. Відкрийте карту ПКМ та увімкніть лише потрібні чанки. Базовий пристрій може обслуговувати область до 3×3 чанків."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.6BF02FA85E691A0C.title": "Один чанк замість великої зони"
  "quest.6BF02FA85E691A0C.quest_desc": [
    "Розберіть базовий завантажувач за штатним рецептом на одиночні. Для невеликої установки використовуйте один чанк: це зменшує зайве навантаження."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.7D11503853ABB6D1.title": "Межі виробничої установки"
  "quest.7D11503853ABB6D1.quest_desc": [
    "Ручна перевірка: увімкніть показ меж чанків F3+G. Джерело води, генератор, паливо, насос, труби, сховище й споживач мають бути в завантажуваній зоні. Режими суміжних чанків задаються на карті пристрою."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.784891C7940F3054.title": "Перевірка після віддалення"
  "quest.784891C7940F3054.quest_desc": [
    "Запишіть кількість продукції, відійдіть за звичайну дальність симуляції й поверніться. Перевірте приріст і сталість живлення. У закритій одиночній грі сервер не працює, тому продукція за цей час не виробляється."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.18E7382CDA55FF18.title": "Віддалене живлення Flux"
  "quest.18E7382CDA55FF18.quest_desc": [
    "Завантажте зону джерела енергії та зону споживача. Перевірте налаштування мережі Flux, пріоритети й ліміти; сам факт встановлення Flux Point не замінює правильної схеми завантаження."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2B58E03CAA497768.title": "Розширена зона до 5×5"
  "quest.2B58E03CAA497768.quest_desc": [
    "Поліпшуйте завантажувач лише коли фабрика виходить за поточні межі. На карті можна залишити зайві чанки вимкненими."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.39C3BC92EB8A4E78.title": "Гранична зона до 7×7"
  "quest.39C3BC92EB8A4E78.quest_desc": [
    "Найбільша підтримувана зона цього мода — до 7×7 чанків на пристрій. Зберігайте обраними лише робочі ділянки й перевіряйте час серверного тіку після розширення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.14F34730E51294D8.title": "Мета: пара → FE → електричний ключ"
  "quest.14F34730E51294D8.quest_desc": [
    "Вхід — паровий блок керування з етапу 0. Основа маршруту: генератор New Age, стиснене повітря й друкована плата PneumaticCraft. Extreme Reactors, Flux, Just Dire Things і Chunk Loaders розвивають фабрику окремими гілками."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2C8FEACD94E746F1.title": "Окремий паровий привід Create"
  "quest.2C8FEACD94E746F1.quest_desc": [
    "Для обертання генератора побудуйте окремий водяний резервуар Create з нагріванням, двигуном і валом. Не ставте двигун на резервуар, що вже живить цинковий вихід пари MI: на одному баку ці режими не працюють разом."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.4222C9BC3D65F4BA.title": "Магнітне оточення генератора"
  "quest.4222C9BC3D65F4BA.quest_desc": [
    "Підготуйте магнетит New Age. Відкрийте Ponder установленої котушки та зберіть магнітне оточення за її схемою; один лише обертовий блок без магнітів не є повною електростанцією."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.66944E18DE44F406.title": "Котушка і знімання струму"
  "quest.66944E18DE44F406.quest_desc": [
    "Котушка в цій збірці потребує парового блока керування. Подайте обертання та встановіть вугільні щітки за схемою Ponder для знімання FE."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.69F0DB474648CB58.title": "Перший електричний контур"
  "quest.69F0DB474648CB58.quest_desc": [
    "Мідний дріт New Age робиться механічною пилкою з мідного листа. З’єднайте клеми дротом; виведіть FE від щіток до споживача. Кінетична потужність Create і FE — різні величини."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.0BFCC79FACDADDB4.title": "Перевірка перших FE"
  "quest.0BFCC79FACDADDB4.quest_desc": [
    "Ручна перевірка: генератор обертається, щітки знімають енергію, електрична мережа живить пристрій. Перевірте накопичення або витрату FE в його інтерфейсі. Цей прапорець не вимірює FE автоматично."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.6DE64E0E0CFFE217.title": "Енергізатор New Age"
  "quest.6DE64E0E0CFFE217.quest_desc": [
    "Поставте енергізатор, подайте FE і підготуйте оброблення заліза. Розташування робочої поверхні й дальність дивіться в Ponder мода."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2CAB0C5476684358.title": "Заряджене залізо"
  "quest.2CAB0C5476684358.quest_desc": [
    "Зарядіть два залізні зливки. Штатний рецепт витрачає 1000 FE на зливок. Це матеріал майбутнього електричного ключа; аналогова схема MI для нього не потрібна."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.5B30DE344A004B5D.title": "Стиснене залізо"
  "quest.5B30DE344A004B5D.quest_desc": [
    "Перші зливки отримайте вибуховим рецептом PneumaticCraft, а після запуску барокамери перейдіть на безпечне серійне виробництво. Усі деталі конкретного рецепта відкриваються через JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.380DE8EF06025ED7.title": "Компресор і труби"
  "quest.380DE8EF06025ED7.quest_desc": [
    "Паливний компресор теж потребує парового ключа. Зберіть невелику повітряну мережу й подайте паливо. FE не замінює стиснене повітря у звичайних пневматичних пристроях."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.1F58776ECCD81A4D.title": "Керування тиском"
  "quest.1F58776ECCD81A4D.quest_desc": [
    "Додайте манометр, запобіжний модуль і редстоунове обмеження компресора. Не перевищуйте допустимий тиск звичайних труб і машин."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.735535E79356478B.title": "Барокамера з інтерфейсами"
  "quest.735535E79356478B.quest_desc": [
    "Зберіть порожню всередині оболонку щонайменше 3×3×3. Через клапан подайте повітря; інтерфейсами вводьте й виводьте предмети, не розбираючи стінки під тиском. Перевірте збирання в довіднику мода."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.48B24CF5D3004906.title": "Перший запас нафти"
  "quest.48B24CF5D3004906.quest_desc": [
    "Знайдіть нафту та наберіть відро. Подальшу автоматичну подачу можна зробити насосом; перший запуск допускає ручне заповнення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.29A84B98AFD5B32F.title": "Нафта → LPG"
  "quest.29A84B98AFD5B32F.quest_desc": [
    "Побудуйте контролер і чотири виходи вертикально, подайте нафту та нагрівання. Окремо відводьте фракції; переповнений вихід зупиняє лінію. LPG потрібен пластику."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.6ACE21EF60224316.title": "Розплавлений пластик"
  "quest.6ACE21EF60224316.quest_desc": [
    "Подайте LPG та вугілля у нагріту термопневматичну установку. При 373 K або вище штатний рецепт дає 1000 мВ пластику зі 100 мВ LPG і вугілля; робочі режими перевіряйте в JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.54A845435A11A331.title": "Охолодження пластику"
  "quest.54A845435A11A331.quest_desc": [
    "Охолодіть розплавлений пластик у світі або тепловою рамкою. Залиште листи на заготовки плат, конденсатори та транзистори."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.29136AA1FDAE2E2B.title": "Порожні PCB"
  "quest.29136AA1FDAE2E2B.quest_desc": [
    "У барокамері змішайте пластик, матеріал проводки та редстоунові смолоскипи. Для штатного рецепта потрібно 1,5 бар; він дає три заготовки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.4AD6E4C34E5F8BB1.title": "Креслення через Amadron"
  "quest.4AD6E4C34E5F8BB1.quest_desc": [
    "Купіть креслення PCB у системі Amadron за 8 смарагдів. Налаштуйте доступ до торгових запасів і дочекайтеся доставки; креслення використовується у рецепті УФ-камери."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2A065F1ADD0AAD86.title": "Експонування PCB"
  "quest.2A065F1ADD0AAD86.quest_desc": [
    "Обробіть заготовку в УФ-камері зі стисненим повітрям. Дочекайтеся достатнього експонування, перш ніж передавати її на травлення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.3D81C6685562BBD1.title": "Травильна кислота"
  "quest.3D81C6685562BBD1.quest_desc": [
    "У барокамері використайте відро пластику, гниле м’ясо, павучі очі та порох. Штатний рецепт потребує 1 бар. Підготуйте нагрівання для травильного бака."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.061A18C707752C44.title": "Незмонтована плата"
  "quest.061A18C707752C44.quest_desc": [
    "Залийте кислоту в нагрітий травильний бак та обробіть експоновану PCB. Перша плата виготовляється без готової автоматичної складальної лінії."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.77E769CC70F94C83.title": "Електронні компоненти"
  "quest.77E769CC70F94C83.quest_desc": [
    "Окремими рецептами барокамери виготовте конденсатори й транзистори. Пластик і проводка спільні; додаткові матеріали — слиз та редстоун відповідно."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.37D8551020F8969C.title": "Готова PCB"
  "quest.37D8551020F8969C.quest_desc": [
    "На верстаку поєднайте незмонтовану плату з двома транзисторами та двома конденсаторами. Ця плата відкриває точну пневмоелектроніку."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2C15CBBEC7BCA044.title": "Пневмомеханізм"
  "quest.2C15CBBEC7BCA044.quest_desc": [
    "Застосуйте PCB, стиснене залізо й точні механізми Create. Один рецепт дає два пневмомеханізми. У цій гілці не потрібні процесори AE2 чи електричний складальник MI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "chapter.0CC6573CD66A8678.chapter_subtitle": [
    "Етап 1 • Генерація FE, пневматика та автоматизація"
  ]
  "chapter.156216B384661DF7.chapter_subtitle": [
    "Етап 1 • Генерація FE, пневматика та автоматизація"
  ]
