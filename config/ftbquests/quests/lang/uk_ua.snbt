  ]
  "quest.320797B977FE4B37.title": "Алтар третього рівня"
  "quest.320797B977FE4B37.quest_desc": [
    "Додайте наступне кільце й опори за схемою посібника. Перевірте висоти, блоки завершення опор і фактичний рівень алтаря. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2333CFA1286CE0BC.title": "Алтар четвертого рівня"
  "quest.2333CFA1286CE0BC.quest_desc": [
    "Використайте відповідні кров’яні блоки та розширте конструкцію за Modopedia. Після складання перевірте рівень і місткість. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.577174318ED3618B.title": "Кривава куля учня"
  "quest.577174318ED3618B.quest_desc": [
    "Ця сфера відкриває рецепти відповідного рівня й працює з мережею душі власника. Прив’яжіть її та підтримуйте запас мережі; LP у самому алтарі обліковуються окремо."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.42CBA4541EFE7FE4.title": "Таємничий попіл"
  "quest.42CBA4541EFE7FE4.quest_desc": [
    "Арканічний попіл створює алхімічний масив на поверхні. Додавайте каталізатор і основний матеріал у порядку рецепта, залишаючи місце для завершення перетворення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.150E3C383471C893.title": "Ворожильний знак"
  "quest.150E3C383471C893.quest_desc": [
    "Створіть сигіл доступним алхімічним способом і прив’яжіть до своєї мережі душі. Перед застосуванням перевірте витрату LP та умови активації; зміни світу спочатку випробуйте на невеликій ділянці."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6420F910D93B8D1C.title": "Знак води"
  "quest.6420F910D93B8D1C.quest_desc": [
    "Створіть сигіл доступним алхімічним способом і прив’яжіть до своєї мережі душі. Перед застосуванням перевірте витрату LP та умови активації; зміни світу спочатку випробуйте на невеликій ділянці."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4033211073BC65CC.title": "Знак лави"
  "quest.4033211073BC65CC.quest_desc": [
    "Створіть сигіл доступним алхімічним способом і прив’яжіть до своєї мережі душі. Перед застосуванням перевірте витрату LP та умови активації; зміни світу спочатку випробуйте на невеликій ділянці."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.67CE6C34F2386931.title": "Ритуальний віщун"
  "quest.67CE6C34F2386931.quest_desc": [
    "Зберіть ритуал за допомогою віщуна або схеми Modopedia. Перевірте типи ритуальних каменів, прив’язаний кристал, рівень інструмента та запас LP у мережі душі. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.040F397211548A4A.title": "Алтар п’ятого рівня"
  "quest.040F397211548A4A.quest_desc": [
    "Завершіть п’ятий рівень із потрібними маяками та рунами. Шостий рівень і творчі ресурси не потрібні для проходження цієї гілки. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.12AC5EBF7743FCC9.title": "Залізний ключ"
  "quest.12AC5EBF7743FCC9.quest_desc": [
    "Простий ключ використовується для дослідження відповідного підземелля. Спосіб входу та переходів перевірте в новій книзі Modopedia; ключ сам по собі не є порталом."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1529EA2486614068.title": "Посилена руна жертвопринесення"
  "quest.1529EA2486614068.quest_desc": [
    "Руна змінює певну властивість алтаря. Встановіть її замість звичайної руни у правильному місці конструкції та перевірте ефект; швидкість, місткість і передавання LP не є одним параметром. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.097E06D005163B6F.title": "Знак телепозиції"
  "quest.097E06D005163B6F.quest_desc": [
    "Створіть сигіл доступним алхімічним способом і прив’яжіть до своєї мережі душі. Перед застосуванням перевірте витрату LP та умови активації; зміни світу спочатку випробуйте на невеликій ділянці. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3DDBB8363EEB6A14.title": "Демонічні ресурси"
  "quest.3DDBB8363EEB6A14.quest_desc": [
    "Дослідіть доступне підземелля й отримайте демоніт. Орієнтуйтеся на новий посібник порту: схеми порталів та кімнат старих версій можуть відрізнятися."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2757BFF8A54C12E7.title": "Знак Зеленого Гаю"
  "quest.2757BFF8A54C12E7.quest_desc": [
    "Створіть сигіл доступним алхімічним способом і прив’яжіть до своєї мережі душі. Перед застосуванням перевірте витрату LP та умови активації; зміни світу спочатку випробуйте на невеликій ділянці."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6AEB178B4314A98D.title": "Знак кривавої лампи"
  "quest.6AEB178B4314A98D.quest_desc": [
    "Створіть сигіл доступним алхімічним способом і прив’яжіть до своєї мережі душі. Перед застосуванням перевірте витрату LP та умови активації; зміни світу спочатку випробуйте на невеликій ділянці."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4B376CE18A930374.title": "Комплект живої броні"
  "quest.4B376CE18A930374.quest_desc": [
    "Створіть чотири частини живої броні за рецептами алхімічного масиву. Розвивайте потрібні покращення діями персонажа та враховуйте бюджет їх вартості."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.57DAF8A25B2F9652.title": "Перші зачарування й самоцвіти"
  "quest.57DAF8A25B2F9652.quest_desc": [
    "Зачарування та знайдені самоцвіти можна використовувати вже зараз. Розвинені полиці, перековка й рівні світу мають окремі навчальні глави в М3."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
