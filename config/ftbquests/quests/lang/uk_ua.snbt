  ]
  "quest.1C3B52742FF7C748.title": "Досвід як ресурс"
  "quest.1C3B52742FF7C748.quest_desc": [
    "Перевірте рецепт пляшечки досвіду в установленій збірці. Для роботи зачарувальної майстерні організуйте стабільне отримання досвіду й зручне зберігання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.65696F2693DDA3D9.title": "Хиткий повідець Енду"
  "quest.65696F2693DDA3D9.quest_desc": [
    "Ендерський повідець має спеціальну дію з переміщенням істот. Перевірте обмеження цієї версії й сумісні цілі перед використанням у фермі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6AC7DE0EAA9E4767.title": "Повідець Енду"
  "quest.6AC7DE0EAA9E4767.quest_desc": [
