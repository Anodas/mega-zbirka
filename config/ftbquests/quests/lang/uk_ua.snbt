  ]
  "quest.19D6CDC57F146AEA.title": "Ліфтовий крутень"
  "quest.19D6CDC57F146AEA.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0A43DBCF18ECB7BF.title": "Мідний корпус"
  "quest.0A43DBCF18ECB7BF.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4FFBC986102DF594.title": "Резервуар Create"
  "quest.4FFBC986102DF594.quest_desc": [
    "Зберіть резервуар для води або виробничих рідин. Залиште буфер між насосом і споживачами."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.23C50DB7B9B119A6.title": "Труби та насоси"
  "quest.23C50DB7B9B119A6.quest_desc": [
    "Насос задає напрямок руху рідини. Підключіть його до труб і перевірте, чи правильні входи та виходи резервуарів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.76679DD50D175FB3.title": "Пересувний рідинний передавач"
  "quest.76679DD50D175FB3.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7A22CDC2B72DDE7D.title": "Дозатор"
  "quest.7A22CDC2B72DDE7D.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.641D1D739E52571D.title": "Стік для предметів"
  "quest.641D1D739E52571D.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3E0572ECBFB04271.title": "Крутень зі шлангом"
  "quest.3E0572ECBFB04271.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.259928036DE61C06.title": "Альтернатива: обертання парового двигуна"
  "quest.259928036DE61C06.quest_desc": [
    "Для отримання обертання можете залишити штатний паровий двигун Create. На одному резервуарі він не працює разом із новим виходом пари: для паралельних задач побудуйте два окремі водяні резервуари."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5E59B8D9AD0FC6E9.title": "Залізнична станція"
  "quest.5E59B8D9AD0FC6E9.quest_desc": [
    "Поставте станцію біля колії та визначте місце складання поїзда. Залиште достатньо прямої колії для вагонів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.52277DD29A6D7DA0.title": "Колії"
  "quest.52277DD29A6D7DA0.quest_desc": [
    "Прокладіть перший залізничний маршрут. Перед великим будівництвом перевірте повороти, підйоми та простір навколо колії."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.51D968222117A171.title": "Залізничні корпуси"
  "quest.51D968222117A171.quest_desc": [
    "Підготуйте корпуси для поїзда та його обладнання. Для складних деталей знадобиться виробництво міцних листів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7BE1983CDFAD6677.title": "Керування поїздом"
  "quest.7BE1983CDFAD6677.quest_desc": [
    "Встановіть органи керування на зібрану конструкцію. Перевірте напрямок руху на короткій випробувальній колії."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3E69272E2D86DE72.title": "Місце машиніста"
  "quest.3E69272E2D86DE72.quest_desc": [
    "Додайте сидіння до поїзда та з'єднайте блоки суперклеєм. У цій адаптації перевіряється біле сидіння."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.445338EA25495706.title": "Суперклей"
  "quest.445338EA25495706.quest_desc": [
    "Позначте блоки, які мають рухатися разом. Перед складанням перевірте, чи не приклеєні до поїзда станція або навколишня будівля."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2E35841CA1CDFC46.title": "Міцні листи"
  "quest.2E35841CA1CDFC46.quest_desc": [
    "Освойте виробництво міцних листів за рецептом JEI. Вони потрібні залізничній техніці та складним корпусам."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4027020602E96C0D.title": "Залізничні сигнали"
  "quest.4027020602E96C0D.quest_desc": [
    "Розділіть колію на контрольовані ділянки. Випробуйте маршрут двома поїздами без небезпечних перетинів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4C270CEB6A440FB9.title": "Спостерігач колії"
  "quest.4C270CEB6A440FB9.quest_desc": [
    "Визначайте проїзд поїзда та використовуйте сигнал у станційній автоматиці."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1CFD624CEF10AE00.title": "Розклад"
  "quest.1CFD624CEF10AE00.quest_desc": [
    "Налаштуйте станції, очікування й вантажні зупинки. Після зміни складу поїзда перевірте його автоматичний маршрут."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3BD45B6C6926D36D.title": "Підготовка залізничного шляху"
  "quest.3BD45B6C6926D36D.quest_desc": [
    "Каток допомагає обробляти поверхню вздовж маршруту. Спочатку перевірте його налаштування на короткій ділянці."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.537D6AB32885D082.title": "&#8C86780.3 • &#7FF0FFC&#76E6FFr&#6CDDFFe&#63D3FFa&#59CAFFt&#50C0FFe&#46B6FF: &#3DADFFC&#38A3FFo&#379AFFn&#3790FFn&#3787FFe&#367DFFc&#3674FFt&#356AFFe&#3561FFd"
  "chapter.537D6AB32885D082.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.021F9733DD7710B3.title": "Латунний лист"
  "quest.021F9733DD7710B3.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5326B53C6ACB98CC.title": "Латунні редуктори"
  "quest.5326B53C6ACB98CC.quest_desc": [
    "Ознайомтеся з додатковими варіантами передачі обертання. Під час заміни редуктора перевірте напрямок усіх виходів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.405C83269A0B0DA2.title": "Латунний корпус"
  "quest.405C83269A0B0DA2.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2339797F75FF281D.title": "Кінетична батарея"
  "quest.2339797F75FF281D.quest_desc": [
    "Ця батарея зберігає енергію обертання для подальшого використання. Перед перенесенням зарядіть її у відповідній установці."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0D356625DB2351E9.title": "Доступ до інвентарів"
  "quest.0D356625DB2351E9.quest_desc": [
    "Порти та перемички допомагають підключати складські блоки. Перевірте сумісність на окремій скрині перед перебудовою складу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.27B2F4E7629EAD6B.title": "Золотий лист"
  "quest.27B2F4E7629EAD6B.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.08F2BEDCD5A8632C.title": "Керувальна мікросхема"
  "quest.08F2BEDCD5A8632C.quest_desc": [
    "Виготовте мікросхему для автоматики Connected. Її рецепт і подальші застосування доступні в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.46017C8F7084382F.title": "Послідовні імпульси"
  "quest.46017C8F7084382F.quest_desc": [
    "Налаштуйте серію сигналів редстоуну для керування механізмами. Перевіряйте тривалість кожного кроку без навантаження."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5E5D47E4842FF448.title": "Заряджена кінетична батарея"
  "quest.5E5D47E4842FF448.quest_desc": [
    "Отримайте заряджену батарею та випробуйте її як тимчасове джерело обертання. Запас обмежений і потребує відновлення."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4463FB535A2AA083.title": "Порожній вітрогонний каталізатор"
  "quest.4463FB535A2AA083.quest_desc": [
    "Випробуйте цей додатковий вузол на окремій кінетичній лінії. Перевірте напрямок передачі, керувальний сигнал і вплив на навантаження."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
