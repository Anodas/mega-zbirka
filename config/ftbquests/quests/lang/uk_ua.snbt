  "chapter.54C81A814F8FDC8C.title": "&#8C86780.11 • &#7FF0FFT&#7CEDFFi&#78E9FFn&#75E6FFk&#72E3FFe&#6EDFFFr&#6BDCFFs&#68D9FF’ &#65D5FFC&#61D2FFo&#5ECFFFn&#5BCBFFs&#57C8FFt&#54C4FFr&#51C1FFu&#4DBEFFc&#4ABAFFt&#47B7FF: &#44B4FFл&#40B0FFи&#3DADFFв&#3AAAFFа&#38A6FFр&#38A3FFн&#38A0FFя &#389CFFт&#3799FFа &#3796FFр&#3793FFі&#378FFFв&#378CFFн&#3789FFі &#3785FFі&#3682FFн&#367FFFс&#367BFFт&#3678FFр&#3675FFу&#3672FFм&#366EFFе&#356BFFн&#3568FFт&#3564FFі&#3561FFв"
  "quest.1A955AE6FC8C1304.title": "Цемент"
  "quest.1A955AE6FC8C1304.quest_desc": [
    "Цемент — основа всієї ливарні. Змішайте гравій, пісок і глину за рецептом, а потім випаліть його в печі на обпалені цеглини."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.33E338110C832EF6.title": "Обпалена цегла"
  "quest.33E338110C832EF6.quest_desc": [
    "З обпалених цеглин складаються плавильник, баки та стіни плавильні. Заготуйте запас: на першу плавильню їх піде чимало."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.743CA49E440BE219.title": "Верстат і шаблони"
  "quest.743CA49E440BE219.quest_desc": [
    "Верстат зберігає вміст сітки, а шаблони потрібні для перших деталей інструментів. Кам’яні й дерев’яні деталі можна робити без плавильні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4A8FC105C55B4B23.title": "Інженерна станція"
  "quest.4A8FC105C55B4B23.quest_desc": [
    "На станції деталі збираються в готовий інструмент. Кожен матеріал дає свої риси: міцність, швидкість, рівень добування та особливі модифікатори."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0516D53BAA2618A9.title": "Перше кайло"
  "quest.0516D53BAA2618A9.quest_desc": [
    "Зберіть кайло з наконечника, кріплення й держака. Наведіть курсор на інструмент, щоб побачити риси кожного матеріалу."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.539C91AF5335F8F8.title": "Рівні інструментів"
  "quest.539C91AF5335F8F8.quest_desc": [
    "У збірці працює власне доповнення Mega Tinker Leveling. Інструмент отримує досвід за зламані придатні блоки та за реальні удари ближнього бою, максимум 10 рівнів. Кожен рівень додає один слот поліпшення, а прогрес видно в підказці предмета. У творчому режимі досвід не нараховується."
  ]
  "quest.0E2ED8274D342B1E.title": "Зброя для бойового режиму"
  "quest.0E2ED8274D342B1E.quest_desc": [
    "Мечі Tinkers мають профілі Epic Fight: меч б’ється як меч, сікач — як величний меч, кинджал — як кинджал, ручна сокира й колун — як сокири. Їхні удари теж дають досвід інструменту."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4DF33D7BF4809201.title": "Ремонтний набір"
  "quest.4DF33D7BF4809201.quest_desc": [
    "Ремонтний набір з того самого матеріалу, що й головка, відновлює міцність на інженерній станції. Зламаний інструмент не зникає, а лише перестає працювати до ремонту."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6BAB325336CFCBC5.title": "Плавильник і топка"
  "quest.6BAB325336CFCBC5.quest_desc": [
    "Невеликий плавильник на топці розтоплює руду й метали ще до повної плавильні. Паливо кладіть у топку, а метал — у плавильник."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.48817A02D0ECE438.title": "Ливарний стіл і резервуар"
  "quest.48817A02D0ECE438.quest_desc": [
    "Кран переливає рідкий метал на стіл або в резервуар. На столі з формою виходять злитки й деталі, у резервуарі — цілі блоки."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.52A331E924047E70.title": "Золота форма злитка"
  "quest.52A331E924047E70.quest_desc": [
    "Покладіть злиток на ливарний стіл і залийте його золотом — вийде багаторазова форма. Так само робляться форми для деталей інструментів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2F93319602E528BE.title": "Плавильня"
  "quest.2F93319602E528BE.quest_desc": [
    "Зберіть із обпаленої цегли порожнисту споруду з контролером, зливом і баком палива. Плавильня розтоплює багато предметів одночасно та змішує сплави."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6E45973477DDED24.title": "Перші сплави"
  "quest.6E45973477DDED24.quest_desc": [
    "Сплав утворюється сам, коли в плавильні є всі потрібні рідини в правильній пропорції. Склад кожного сплаву дивіться в JEI."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.41563292C36316BE.title": "Кобальт"
  "quest.41563292C36316BE.quest_desc": [
    "Кобальтова руда трапляється в Незері. Для неї потрібне кайло достатнього рівня добування. Кобальтові інструменти дуже швидкі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5BAD40B676F720DA.title": "Маньюлін"
  "quest.5BAD40B676F720DA.quest_desc": [
    "Один із найсильніших металів Tinkers. Рецепт сплаву дивіться в JEI та простежте, щоб у плавильні вистачало кожного компонента."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.09A4077D4B880FCB.title": "Ливарня з випаленої цегли"
  "quest.09A4077D4B880FCB.quest_desc": [
    "Ливарня будується з випаленої цегли незерського цементу. Вона плавить руду з побічними продуктами й підходить для великих об’ємів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0E7F6BDE85F49706.title": "Інженерне ковадло"
  "quest.0E7F6BDE85F49706.quest_desc": [
    "Ковадло потрібне для великих інструментів: кувалди, гірничого молота, коси й колуна. Його верх робиться з блоків металу."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6526397BC6CFD376.title": "Кувалда"
  "quest.6526397BC6CFD376.quest_desc": [
    "Кувалда добуває область 3×3 і дуже повільна без вдалих матеріалів. Великі інструменти теж отримують рівні й слоти поліпшень."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "image.6B6239D85604552B.title": "Кроки 1–12"
  "image.6636411EEEC1E52D.title": "Кроки 13–18"
  "chapter.7B29AB66FD868F27.title": "&#8C8678Д4 • &#C9F57AР&#C1F37Bю&#B9F27Dк&#B2F07Eз&#AAEF80а&#A2ED81к&#9AEC83и&#92EA84, &#8AE886с&#83E787к&#7BE589р&#73E48Aи&#6DE28Cн&#68E08Eі &#64DD90т&#5FDB91а &#5BD993п&#57D795о&#52D497д&#4ED299о&#49D09Bр&#45CE9Cо&#40CB9Eж&#3CC9A0і"
  "quest.0500A64151C5568C.title": "Ранець"
  "quest.0500A64151C5568C.quest_desc": [
    "Ранець відкривається клавішею або правою кнопкою, а поставлений на землю працює як скриня. Його вміст зберігається, навіть якщо ранець зламати."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.40C0FDFC5F45A044.title": "Залізний ранець"
  "quest.40C0FDFC5F45A044.quest_desc": [
    "Поліпшений ранець має більше місця та слотів поліпшень. Вміст переноситься під час поліпшення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.60025D7A50059C08.title": "Золотий ранець"
  "quest.60025D7A50059C08.quest_desc": [
    "Ще більше місця й слотів. Тепер варто ставити кілька поліпшень одночасно."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4AA5A56B7B1F6F8C.title": "Діамантовий ранець"
  "quest.4AA5A56B7B1F6F8C.quest_desc": [
    "Великий ранець для довгих походів та шахт."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2BE2DEDEA6B6F5BC.title": "Незеритовий ранець"
  "quest.2BE2DEDEA6B6F5BC.quest_desc": [
    "Найбільший ранець, стійкий до вогню й лави."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6E45EA31F8367B3E.title": "База покращення"
  "quest.6E45EA31F8367B3E.quest_desc": [
    "З бази робляться всі поліпшення ранця. Вставте готове поліпшення в слот збоку інтерфейсу ранця."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4D51C9F8F6FB96EF.title": "Авто-збір і магніт"
  "quest.4D51C9F8F6FB96EF.quest_desc": [
    "Авто-збір кладе підібрані предмети одразу в ранець, а магніт притягує їх здалеку. Фільтр визначає, що саме брати."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2D97B98FC128716D.title": "Створення та годування"
  "quest.2D97B98FC128716D.quest_desc": [
    "Сітка створення прямо в ранці, а годування саме дає їжу, коли ви голодні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.55DF6E49FDA327C7.title": "Покращення «Стос»"
  "quest.55DF6E49FDA327C7.quest_desc": [
    "Збільшує розмір стосу в кожному слоті ранця. Вищі рівні роблять ранець справжнім складом."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.60DDF8F8B6A531A8.title": "Мідна скриня"
  "quest.60DDF8F8B6A531A8.quest_desc": [
    "Скрині Iron Chests більші за звичайну й поліпшуються далі: мідь, залізо, золото, діамант, кришталь і обсидіан."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0908951E6992A6CF.title": "Залізна скриня"
  "quest.0908951E6992A6CF.quest_desc": [
    "Залізна скриня має 54 слоти та працює з воронками й трубами як звичайна."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.57945ED023F749BB.title": "Поліпшення скрині на місці"
  "quest.57945ED023F749BB.quest_desc": [
    "Застосуйте поліпшення до поставленої скрині: вона зміниться разом із вмістом, і нічого не доведеться перекладати."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7B4D9DC42C04CB2E.title": "Діамантова скриня"
  "quest.7B4D9DC42C04CB2E.quest_desc": [
    "Велика скриня для основного складу бази. Кришталева показує вміст зовні, а обсидіанова стійка до вибухів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4028B5539DD52AE8.title": "Дороговказ"
  "quest.4028B5539DD52AE8.quest_desc": [
    "Дороговкази трапляються в селах і на дорогах, а свій можна створити. Активуйте камінь правою кнопкою, щоб потім телепортуватися до нього з будь-якого іншого."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.57B0FAD2CA010945.title": "Мандрівний камінь"
  "quest.57B0FAD2CA010945.quest_desc": [
    "Мандрівний камінь дозволяє телепортуватися до активованих дороговказів звідусіль. Перенесення витрачає досвід, а після нього камінь перезаряджається."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.53D4060A7F7FE773.title": "Сувій повернення"
  "quest.53D4060A7F7FE773.quest_desc": [
    "Одноразовий сувій повертає до останнього дороговказу, яким ви користувалися. Зручно взяти кілька в небезпечний похід."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.549C02875DDB2FEB.title": "Могила"
  "quest.549C02875DDB2FEB.quest_desc": [
    "Після смерті на місці загибелі з’являється могила з вашими речами. Поверніться до могили й зламайте або відкрийте її, щоб забрати все назад."
  ]
  "quest.167E4A56EE229413.title": "Особиста здобич"
  "quest.167E4A56EE229413.quest_desc": [
    "Lootr робить скрині у спорудах особистими: кожен гравець знаходить у них власну здобич. Не бійтеся відкривати скрині першим у грі з друзями."
  ]
  "quest.3C7C64FF938367B6.title": "Мінікарта та карта світу"
  "quest.3C7C64FF938367B6.quest_desc": [
    "Мінікарта Xaero показує місцевість і мобів, а повна карта світу відкривається клавішею M. Точку на мапі можна поставити клавішею B. Дороговкази автоматично з’являються на картах."
  ]
  "image.2D66015CC362C707.title": "Кроки 1–12"
  "image.59121258049D2655.title": "Кроки 13–19"
  "chapter.11DD0D8E3AA6A1C1.title": "&#8C8678Д5 • &#C9F57AБ&#BEF37Cу&#B4F17Eд&#A9EF80і&#9FED82в&#94EA84н&#89E886и&#7FE688ц&#74E48Aт&#6CE18Cв&#66DE8Fо &#60DB91т&#5AD894а &#54D596д&#4ED299е&#48CF9Bк&#42CC9Eо&#3CC9A0р"
  "quest.04236396EDF15232.title": "Стіл муляра"
  "quest.04236396EDF15232.quest_desc": [
    "Chipped дає сотні варіантів звичайних блоків. Покладіть камінь, цеглу чи інший блок у стіл муляра й виберіть потрібний вигляд — без втрат матеріалу."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2C66CBD0C49A30DF.title": "Стіл теслі"
  "quest.2C66CBD0C49A30DF.quest_desc": [
    "Варіанти дощок, колод та інших дерев’яних блоків."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6B29121B959E84FC.title": "Склодув"
  "quest.6B29121B959E84FC.quest_desc": [
    "Візерунчасте скло та шибки для вікон і вітрин."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.239B375608AAAEEA.title": "Інші верстаки Chipped"
  "quest.239B375608AAAEEA.quest_desc": [
    "Ботанік працює з рослинами й землею, ткацький стіл — з вовною й килимами, алхімічний — з магічними блоками, стіл майстра — з механізмами. Chipped Express додає автоматизацію цих рецептів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7EC70CBF4AEF974A.title": "Різець"
  "quest.7EC70CBF4AEF974A.quest_desc": [
    "Різець Rechiseled перетворює блок на декоративні варіанти, зокрема на ті, що з’єднуються між собою в суцільний візерунок."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.174A5E1705F138AF.title": "Кам’яна будівельна паличка"
  "quest.174A5E1705F138AF.quest_desc": [
    "Паличка розширює поверхню, по якій ви клацаєте, блоками з інвентарю. Так зручно класти довгі стіни, підлоги й мости."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.331A0C3B966E3712.title": "Залізна паличка"
  "quest.331A0C3B966E3712.quest_desc": [
    "Ставить більше блоків за раз і має більше міцності."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2E74702966EC479B.title": "Діамантова паличка"
  "quest.2E74702966EC479B.quest_desc": [
    "Майже вічна паличка з великою площею. У неї можна вставити ядра режимів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.36E343289DF938D5.title": "Ядра паличок"
  "quest.36E343289DF938D5.quest_desc": [
    "Ядро ангела ставить блок у повітрі, а ядро руйнування прибирає цілу поверхню. Перемикайте режими паличкою з затиснутою клавішею."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7C2713F07B66FC58.title": "Тренувальний манекен"
  "quest.7C2713F07B66FC58.quest_desc": [
    "Манекен показує завдану шкоду й DPS. Зручно перевіряти нову зброю, зачарування та прийоми Epic Fight."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0351E6F0F4EF96C7.title": "Рубання дерев"
  "quest.0351E6F0F4EF96C7.quest_desc": [
    "HT’s TreeChop рубає дерево по частинах: кожен удар відрізає шматок, а все дерево падає, коли стовбур закінчиться. Сокира рубає швидше."
  ]
  "quest.2DDBFC74F595BA94.title": "Будування мостів"
  "quest.2DDBFC74F595BA94.quest_desc": [
    "Bridging Mod допомагає ставити блоки на край, на який ви дивитеся: зручно будувати мости й платформи над прірвою без присідання на краю."
  ]
  "image.0A7E71A30D3AAE61.title": "Кроки 1–12"
  "chapter.28327C7D2F8870F9.title": "&#8C8678П1 • &#FFB15CE&#FFA95Ap&#FFA159i&#FF9957c &#FF9155F&#FF8954i&#FF8252g&#FF7A51h&#FF724Ft&#FF6A4D: &#FF624Cб&#FF5A4Aо&#FC564Aй&#F8524Aо&#F54F4Aв&#F14B4Aа &#EE474Aс&#EA434Aи&#E73F4Aс&#E33B4Aт&#E0384Aе&#DC344Aм&#D9304Aа"
  "quest.0B4A076FAA6E5A24.title": "Бойовий режим"
  "quest.0B4A076FAA6E5A24.quest_desc": [
    "Клавіша F перемикає звичайний і бойовий режими. Лівий Alt — ухилення, права кнопка миші — захист, середня — захоплення цілі, K — дерево навичок. Додаткові здібності Nightfall використовують F7–F9, а особливі прийоми — бічні кнопки миші."
  ]
  "quest.5330D2C19EFFCBEA.title": "Кинджал"
  "quest.5330D2C19EFFCBEA.quest_desc": [
    "Швидкі короткі удари. Кинджали можна тримати в обох руках."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6A697034C43A9785.title": "Довгий меч"
  "quest.6A697034C43A9785.quest_desc": [
    "Збалансована зброя з потужними серіями ударів і власною стійкою."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4F7FAB91E2192C34.title": "Величний меч"
  "quest.4F7FAB91E2192C34.quest_desc": [
    "Повільна важка зброя, що б’є широко й збиває супротивників."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6D543A9FE8B63A53.title": "Спис"
  "quest.6D543A9FE8B63A53.quest_desc": [
    "Довга досяжність і уколи, якими зручно тримати ворога на відстані."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4CBAAEF47743F913.title": "Тачі"
  "quest.4CBAAEF47743F913.quest_desc": [
    "Вигнутий меч зі швидкими розрізами."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.15E10391EF300336.title": "Книга вміння"
  "quest.15E10391EF300336.quest_desc": [
    "Книги вмінь трапляються у скарбах і в мобів. Прочитайте книгу, щоб вивчити нове ухилення, захист чи пасивне вміння, і призначте його в меню навичок."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.39A9F905109BB1AE.title": "Камінь здібностей"
  "quest.39A9F905109BB1AE.quest_desc": [
    "Камінь здібностей відкриває вузли дерева навичок. Відкрийте дерево клавішею K і виберіть, яку гілку розвивати."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.38A899D5BE6858C5.title": "Велика сокира Weapons of Miracles"
  "quest.38A899D5BE6858C5.quest_desc": [
    "Weapons of Miracles додає зброю з власними анімаціями й прийомами. Велика сокира — повільна, але руйнівна."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.02EEFFEB19A6EBBC.title": "Бойовий посох"
  "quest.02EEFFEB19A6EBBC.quest_desc": [
    "Посох тримає ворогів на відстані серіями обертових ударів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.465F7E565EC345B6.title": "Навичка зброї"
  "quest.465F7E565EC345B6.quest_desc": [
    "Бойовий досвід розподіляється за категоріями зброї Epic Fight і нараховується лише за реальну шкоду. Вищий рівень відповідної зброї дає до +20% шкоди, а блокування — до −20% витрат витривалості на захист."
  ]
  "quest.09626AE7D97FCA9C.title": "Інструменти Tinkers у бою"
  "quest.09626AE7D97FCA9C.quest_desc": [
    "Мечі, сікачі, кинджали й сокири Tinkers мають власні профілі Epic Fight, а удари ними прокачують інструмент. Зберіть свою зброю в главі Д3."
  ]
  "image.2B52522F2661D74B.title": "Кроки 1–12"
  "chapter.7FE4ABF373C2AF1F.title": "&#8C8678П2 • &#FFB15CС&#FFA259у&#FF9456т&#FF8653і&#FF7750н&#FF684Dк&#FF5A4Aо&#F9534Aв&#F24C4Aи&#EC454Aй &#E63E4Aл&#DF374Aі&#D9304Aс"
  "quest.3FDFAF52D7098E12.title": "Портал у Сутінковий ліс"
  "quest.3FDFAF52D7098E12.quest_desc": [
    "Викопайте яму 2×2, залийте її водою та обставте квітами або рослинами. Киньте у воду алмаз — і відкриється портал. У Сутінковому лісі боси проходяться по черзі: поки ви не переможете попереднього, наступні землі закриті прокляттям."
  ]
  "quest.15499EC3FFADEC42.title": "Наґа"
  "quest.15499EC3FFADEC42.quest_desc": [
    "Перший бос живе на кам’яному дворі в лісі. Тримайтеся подалі від її ривків і бийте, коли вона розвертається."
    "§6Ключовий бос: нагорода в главі П0 — «Сувій ключа: Наґа». Прочитайте його (ПКМ), щоб відкрити книги заклинань Iron’s Spells на 5–8 слотів і книгу початківця Ars Nouveau."
  ]
  "quest.155BC7AD0BF15EE5.title": "Сутінковий ліч"
  "quest.155BC7AD0BF15EE5.quest_desc": [
    "Ліч чекає на вершині високої вежі. Спершу збийте його щити, а потім ухиляйтеся від снарядів і посіпак."
  ]
  "quest.452E299D8CB245CC.title": "Матеріали Сутінкового лісу"
  "quest.452E299D8CB245CC.quest_desc": [
    "Залізне дерево й сталеволист роблять з місцевих ресурсів. З них виходять добрі обладунки й інструменти ще до важких босів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.48F58F3172FFA67C.title": "Гриботавр"
  "quest.48F58F3172FFA67C.quest_desc": [
    "Гриботавр охороняє серце лабіринту в болотистих землях. Мапа лабіринту допоможе знайти шлях."
  ]
  "quest.5E894C5A39190136.title": "Гідра"
  "quest.5E894C5A39190136.quest_desc": [
    "Триголова гідра живе у вогняних болотах. Відрубуйте голови, поки вони відкриті, і захищайтеся від вогню."
    "§6Ключовий бос: нагорода в главі П0 — «Сувій ключа: Гідра». Він відкриває магію 2-го кола: книги Iron’s на 10 слотів, книгу мага Ars, броню шкіл магії Iron’s і стихійну броню Ars Elemental."
  ]
  "quest.5C0703707566481E.title": "Вогняний злиток"
  "quest.5C0703707566481E.quest_desc": [
    "Вогняна кров гідри разом із залізом дає вогняний метал для найкращих обладунків і кайла."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.79A8789BE43163E3.title": "Фантоми лицаря"
  "quest.79A8789BE43163E3.quest_desc": [
    "Фантоми ховаються в глибині фортеці гоблінів. Їх кілька, і з кожним убитим інші стають злішими."
  ]
  "quest.000A40D0404B31B0.title": "Лицарський метал"
  "quest.000A40D0404B31B0.quest_desc": [
    "Уламки обладунків з фортеці переплавляються в лицарський метал."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.516AB9BE3E43B546.title": "Ур-ґаст"
  "quest.516AB9BE3E43B546.quest_desc": [
    "Ур-ґаст живе на вершині темної вежі. Знищіть кармінітові реактори, щоб змусити його спуститися."
  ]
  "quest.2359F96200838DDF.title": "Альфа-єті"
  "quest.2359F96200838DDF.quest_desc": [
    "Альфа-єті ховається в печері серед снігових земель. Ухиляйтеся від падіння бурульок і кинутих брил."
  ]
  "quest.55F979DE5224556D.title": "Снігова королева"
  "quest.55F979DE5224556D.quest_desc": [
    "Королева чекає в крижаному палаці на вершині Авроральних земель. Підготуйте захист від холоду та снарядів."
  ]
  "quest.6D4D43AF3E804576.title": "Стіл розбирання"
  "quest.6D4D43AF3E804576.quest_desc": [
    "Стіл розбирає створені предмети назад на складники та може переносити зачарування."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.35C37A5C52B7B6F2.title": "Амулет життя"
  "quest.35C37A5C52B7B6F2.quest_desc": [
    "Амулет спрацьовує замість смерті: ви виживаєте з частиною здоров’я, а амулет зникає."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "image.42E5A36004C03684.title": "Кроки 1–12"
  "image.3B390FF1B63E2648.title": "Кроки 13–14"
  "chapter.089F6A384EB25134.title": "&#8C8678П3 • &#FFB15CL&#FFA95A_&#FFA159E&#FF9957n&#FF9155d&#FF8954e&#FF8252r&#FF7A51’&#FF724Fs &#FF6A4DC&#FF624Ca&#FF5A4At&#FC564Aa&#F8524Ac&#F54F4Al&#F14B4Ay&#EE474As&#EA434Am&#E73F4A: &#E33B4Aб&#E0384Aо&#DC344Aс&#D9304Aи"
  "quest.4B25C39DB254FEB7.title": "Ока Cataclysm"
  "quest.4B25C39DB254FEB7.quest_desc": [
    "Кожен бос Cataclysm живе у своїй споруді. Особливі ока, що випадають з босів і їхніх слуг, кидаються як око Енду та вказують шлях до наступної споруди. Готуйте найкраще спорядження: це одні з найважчих боїв у збірці."
  ]
  "quest.32BBD68FA990CC7B.title": "Прадавні рештки"
  "quest.32BBD68FA990CC7B.quest_desc": [
    "Велетенський страж Проклятої піраміди в пустелі."
  ]
  "quest.3D8F0C820E42CA92.title": "Провісник"
  "quest.3D8F0C820E42CA92.quest_desc": [
    "Бойова машина зі стародавньої фабрики. Ухиляйтеся від лазерів і ракет."
  ]
  "quest.04A064F9FAAEEE2E.title": "Маледикт"
  "quest.04A064F9FAAEEE2E.quest_desc": [
    "Проклятий воїн із крижаної в’язниці."
  ]
  "quest.4258807F464761AE.title": "Проклятий стопок"
  "quest.4258807F464761AE.quest_desc": [
    "Метал з Маледикта для проклятих обладунків."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6C186FCE6F6ECE2F.title": "Левіятан"
  "quest.6C186FCE6F6ECE2F.quest_desc": [
    "Морське чудовисько з затонулого міста. Підготуйте дихання під водою."
  ]
  "quest.7D294E22892B9049.title": "Скілла"
  "quest.7D294E22892B9049.quest_desc": [
    "Володарка бурі з морської споруди. Захищайтеся від блискавок."
  ]
  "quest.34ED726ECCF96C06.title": "Чорнорогий"
  "quest.34ED726ECCF96C06.quest_desc": [
    "Незеритове чудовисько з кузні душ у Незері. Захищайтеся від лави та вогню."
  ]
  "quest.2DF0057EBE11096A.title": "Іґніс"
  "quest.2DF0057EBE11096A.quest_desc": [
    "Палаючий лицар з вогняної арени в Незері."
    "§6Ключовий бос: нагорода в главі П0 — «Сувій ключа: Іґніс». Він відкриває спорядження 4-го ступеня: очищений обсидіан, сплав затемнення, Ruinfighter і Duskfire."
  ]
  "quest.22A820FBF60A5BC8.title": "Іґнієвий стопок"
  "quest.22A820FBF60A5BC8.quest_desc": [
    "Метал з Іґніса для найкращих вогнестійких обладунків."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.02013EA7D5D5090F.title": "Ендовий сторож"
  "quest.02013EA7D5D5090F.quest_desc": [
    "Страж зруйнованої цитаделі в Енді."
  ]
  "quest.19CA3F70B427DB9B.title": "Горно порожнечі"
  "quest.19CA3F70B427DB9B.quest_desc": [
    "Потужний молот-горно з силою порожнечі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6C6403B7519BD008.title": "Слуги босів"
  "quest.6C6403B7519BD008.quest_desc": [
    "Глибинники з моря та коболетони з пустелі — розминка перед справжніми босами. З них також випадають корисні матеріали."
  ]
  "image.627E1FB4596FB47F.title": "Кроки 1–12"
  "image.29C05B0183564638.title": "Кроки 13–13"
  "chapter.43515C4338FB788E.title": "&#8C8678П4 • &#FFB15CА&#FFAA5Bр&#FFA459т&#FF9D58е&#FF9656ф&#FF9055а&#FF8954к&#FF8252т&#FF7B51и&#FF7550, &#FF6E4Eр&#FF674Dе&#FF614Bл&#FF5A4Aі&#FC574Aк&#F9544Aв&#F6504Aі&#F34D4Aї &#F04A4Aт&#ED474Aа &#EB434Aн&#E8404Aа&#E53D4Aв&#E23A4Aи&#DF364Aч&#DC334Aк&#D9304Aи"
  "quest.350F66E50485587C.title": "Мімік"
  "quest.350F66E50485587C.quest_desc": [
    "Деякі скрині в печерах і підземеллях — це міміки. Перемога над ним дає артефакт."
  ]
  "quest.4A6963DC60FE359F.title": "Хмара в банці"
  "quest.4A6963DC60FE359F.quest_desc": [
    "Подвійний стрибок у повітрі. Артефакти носяться у слотах Curios."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.127E5945FFE5409C.title": "Кросівки"
  "quest.127E5945FFE5409C.quest_desc": [
    "Швидший біг і підйом на блок без стрибка."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.47C18BBCF644BD3B.title": "Звірині кігті"
  "quest.47C18BBCF644BD3B.quest_desc": [
    "Швидші удари та добування."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.04FE6707F0D45D31.title": "Кришталеве серце"
  "quest.04FE6707F0D45D31.quest_desc": [
    "Додаткове здоров’я назавжди, поки серце вдягнене."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.47B6D96449B67631.title": "Реліквії"
  "quest.47B6D96449B67631.quest_desc": [
    "Реліквії знаходяться у скарбах споруд. Вони мають власні рівні: використовуйте реліквію, щоб вона набиралася досвіду й відкривала нові вміння. Опис кожного вміння видно в підказці предмета."
  ]
  "quest.5670618A8F0C8EC8.title": "Чарівне дзеркало"
  "quest.5670618A8F0C8EC8.quest_desc": [
    "Повертає до точки відродження. Рівні зменшують перезарядку."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4380C92B703CD074.title": "Шкіряний пояс"
  "quest.4380C92B703CD074.quest_desc": [
    "Додає слоти для інших аксесуарів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.443BA8CE0645DDD4.title": "Ковзани"
  "quest.443BA8CE0645DDD4.quest_desc": [
    "Швидке ковзання по льоду та таран на розгоні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.52F570A615BF5B5C.title": "Досвід реліквій"
  "quest.52F570A615BF5B5C.quest_desc": [
    "Пляшечка передає досвід реліквії напряму та прискорює відкриття її вмінь."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.26762166A1B7AA81.title": "Навички за діями"
  "quest.26762166A1B7AA81.quest_desc": [
    "Project MMO розвиває 13 навичок від ваших дій: зброя, стрільба, рукопашний бій, блокування, біг, плавання, добування руди, рубання, земляні роботи, рільництво й рибальство. Рівні йдуть до 100 і дають невеликі бонуси. Вимоги до спорядження та втрата досвіду після смерті вимкнені."
  ]
  "quest.1BB17ED1CDCC3A68.title": "Підземелля зомбі"
  "quest.1BB17ED1CDCC3A68.quest_desc": [
    "YUNG’s Better Dungeons перетворює звичайні підземелля на більші споруди з пастками й здобиччю. Знайдіть і увійдіть у підземелля зомбі."
  ]
  "quest.6C7918D3594955BB.title": "Підземелля скелетів"
  "quest.6C7918D3594955BB.quest_desc": [
    "Ще одне велике підземелля, цього разу зі скелетами."
  ]
  "quest.7F2789AE0DFFB806.title": "Павуче підземелля"
  "quest.7F2789AE0DFFB806.quest_desc": [
    "Печера павуків з тенетами та гніздами."
  ]
  "image.2E87243B697D788B.title": "Кроки 1–12"
  "image.6D0D1D8E0ECDAB2C.title": "Кроки 13–14"
  "chapter.1061A9B870AA18A1.title": "&#8C8678М5.1 • &#E3A8FFT&#DFA3FFh&#DB9FFFa&#D89AFFu&#D495FFm&#D091FFc&#CC8CFFr&#C987FFa&#C582FFf&#C17EFFt&#BD79FF: &#BA74FFп&#B670FFе&#B26BFFр&#B86BFCш&#BE6CF8і &#C46CF5д&#CA6CF1о&#D06DEEс&#D66DEAл&#DB6DE7і&#E16DE3д&#E76EE0ж&#ED6EDCе&#F36ED9н&#F96FD5н&#FF6FD2я"
  "quest.5A463EBB988B48A5.title": "Жезл"
  "quest.5A463EBB988B48A5.quest_desc": [
    "Жезл — головний інструмент таумата. Перший жезл робиться із залізних наконечників і дерев’яного стрижня. Він накопичує vis — магічну силу шести первинних аспектів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.200AA26922876F16.title": "Таумономікон"
  "quest.200AA26922876F16.quest_desc": [
    "Застосуйте жезл до книжкової полиці, і вона перетвориться на Таумономікон. У книзі записані всі дослідження; пошук і навігацію додає Thaumcraft Client Tweaks."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.54EE2FD6010DF0AF.title": "Таумометр"
  "quest.54EE2FD6010DF0AF.quest_desc": [
    "Таумометр дворучний: друга рука має бути порожня. Наведіть його на блок або істоту й утримуйте праву кнопку приблизно секунду. Сканування дає аспекти для досліджень; повторне сканування тієї самої цілі нових очок не дає."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.54E9DB2855C7AB74.title": "Стіл досліджень"
  "quest.54E9DB2855C7AB74.quest_desc": [
    "На столі досліджень з’єднуються аспекти, щоб відкрити нові записи Таумономікону."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2C99AB9744A43FF8.title": "Магічний верстак"
  "quest.2C99AB9744A43FF8.quest_desc": [
    "Магічний верстак створює предмети з витратою vis з жезла, що лежить у ньому."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.512BD52E63DF4E34.title": "Тигель"
  "quest.512BD52E63DF4E34.quest_desc": [
    "Застосуйте жезл до казана над вогнем, щоб отримати тигель. Предмети, кинуті в киплячу воду, розчиняються на аспекти, а з них виходить алхімія."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.083615950C29E450.title": "Таум-злиток"
  "quest.083615950C29E450.quest_desc": [
    "Залізо, кинуте в тигель з потрібними аспектами, перетворюється на тауміум — основний метал магії."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.164B1D22684A8325.title": "Первинні кристали"
  "quest.164B1D22684A8325.quest_desc": [
    "Кристали шести первинних аспектів ростуть під землею. Вони потрібні для інфузії й багатьох рецептів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.49155DCE0AA0EC1F.title": "Саліс Мундус"
  "quest.49155DCE0AA0EC1F.quest_desc": [
    "Магічний пил із кристалів, без якого не обійтися в багатьох рецептах."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.679FAF3E30658D63.title": "Нітор та алюментум"
  "quest.679FAF3E30658D63.quest_desc": [
    "Нітор — вічне магічне світло, алюментум — вибухове паливо. Обидва робляться в тиглі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6BA97C482BA619D9.title": "Окуляри одкровення"
  "quest.6BA97C482BA619D9.quest_desc": [
    "Окуляри показують аспекти, вузли аури та вміст банок без таумометра."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.08A034C83CC97162.title": "Магічні дерева"
  "quest.08A034C83CC97162.quest_desc": [
    "Великодерево й сріблодерево ростуть у магічних лісах. З них робляться кращі стрижні жезлів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6983962C00A1408D.title": "Магічне сало"
  "quest.6983962C00A1408D.quest_desc": [
    "З магічного сала робляться свічки, що стабілізують інфузію."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "image.0BBC5D162F7A72BF.title": "Кроки 1–12"
  "image.40E5807F961AE8AF.title": "Кроки 13–13"
  "chapter.262ECB665B117C1B.title": "&#8C8678М5.2 • &#E3A8FFT&#E0A4FFh&#DDA1FFa&#DA9DFFu&#D799FFm&#D496FFc&#D192FFr&#CE8EFFa&#CB8AFFf&#C887FFt&#C583FF: &#C27FFFе&#BF7CFFс&#BC78FFе&#B974FFн&#B671FFц&#B36DFFі&#B46BFEї&#B96BFB, &#BE6CF8і&#C26CF5н&#C76CF3ф&#CC6CF0у&#D06DEDз&#D56DEBі&#DA6DE8я &#DE6DE5т&#E36EE2а &#E86EE0г&#EC6EDDо&#F16EDAл&#F66FD7е&#FA6FD5м&#FF6FD2и"
  "quest.2D4A45ECB9512A3C.title": "Банка для есенції"
  "quest.2D4A45ECB9512A3C.quest_desc": [
    "Банка зберігає один вид есенції. Підпишіть її біркою, щоб вона приймала лише потрібний аспект."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4F0037762D5EDF66.title": "Перегінний куб"
  "quest.4F0037762D5EDF66.quest_desc": [
    "Куб над алхімічною піччю збирає есенцію, яку можна відвести трубами до банок."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.79010D878B57BCCA.title": "Труби для есенцій"
  "quest.79010D878B57BCCA.quest_desc": [
    "Труби з’єднують банки, куби та машини. Клапан і фільтр керують потоком."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.50FBE2034A0763C5.title": "Стіл розщеплення"
  "quest.50FBE2034A0763C5.quest_desc": [
    "Розщеплює предмети на дрібні знання аспектів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3028D888DA426B05.title": "Кращі наконечники"
  "quest.3028D888DA426B05.quest_desc": [
    "Золоті й таумієві наконечники збільшують знижку на vis. Таумієві спершу заряджаються інфузією."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1B051F0083A1B55D.title": "Кращі стрижні"
  "quest.1B051F0083A1B55D.quest_desc": [
    "Стрижень визначає, скільки vis вміщує жезл. Сріблодеревний жезл знадобиться для великих ритуалів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1AF4FC36DB6CBF28.title": "Рунічна матриця"
  "quest.1AF4FC36DB6CBF28.quest_desc": [
    "Алтар інфузії: центральний п’єдестал внизу, матриця на два блоки вище, а по діагональних кутах — магічна кам’яна цегла з магічним каменем зверху. Після дослідження INFUSION застосуйте заряджений жезл до матриці. Предмет кладеться в центр, компоненти — на зовнішні п’єдестали, а есенція береться з банок поруч."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7FEACF8CC5467C98.title": "Інструменти стихій"
  "quest.7FEACF8CC5467C98.quest_desc": [
    "Перший рецепт інфузії: таумієва лопата, два земляні кристали, алмаз і колода великодерева, а також есенції Terra й Fabrico. Свічки поруч стабілізують алтар."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7BAEE05BF550164B.title": "Набалдашники"
  "quest.7BAEE05BF550164B.quest_desc": [
    "Набалдашник на жезлі перетворює vis на заклинання. Сумка набалдашників дозволяє швидко їх міняти."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.00F49FF777288899.title": "Голем"
  "quest.00F49FF777288899.quest_desc": [
    "Голем виконує роботу за ядром: збирає предмети, наповнює чи спорожнює скрині, збирає врожай. Дзвоник големів задає їм точки роботи."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3BEEC7B0ED9B93CC.title": "Таумієві обладунки"
  "quest.3BEEC7B0ED9B93CC.quest_desc": [
    "Міцні обладунки зі знижкою на vis."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.74B42FB23E63D2E5.title": "Вісп"
  "quest.74B42FB23E63D2E5.quest_desc": [
    "Вісп — блукаючий згусток аспекту. З нього випадає кристалічна есенція."
  ]
  "quest.114D383BE35E09F5.title": "Порушення"
  "quest.114D383BE35E09F5.quest_desc": [
    "Заборонені знання накопичують порушення, яке викликає неприємні події. Warp Theory додає способи його очищення, зокрема талісман очищення."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "image.44D3E350EAF17C47.title": "Кроки 1–12"
  "image.59879723EF16A875.title": "Кроки 13–13"
  "chapter_group.15283A8731F6C89A.title": "&l&#C8AE86&lП&#CCB289&lр&#CFB68B&lи&#D3BA8E&lг&#D7BE90&lо&#DAC293&lд&#DEC796&lи &#E2CB98&l• &#E5CF9B&lБ&#E9D39D&lі&#EDD7A0&lй&#F0DBA3&l, &#F0DBA3&lб&#EDD7A0&lо&#E9D39D&lс&#E5CF9B&lи &#E2CB98&lт&#DEC796&lа &#DAC293&lс&#D7BE90&lк&#D3BA8E&lа&#CFB68B&lр&#CCB289&lб&#C8AE86&lи"
  "chapter.6EC10F7B8DD59006.title": "&#8C8678П0 • &#FFB15CБ&#FFA85Aо&#FF9F58с&#FF9656и &#FF8C54т&#FF8353а &#FF7A51к&#FF714Fл&#FF684Dю&#FF5F4Bч&#FD584Aі &#F9534Aп&#F54F4Aр&#F14B4Aо&#ED464Aг&#E9424Aр&#E53D4Aе&#E1394Aс&#DD344Aі&#D9304Aї"
  "chapter.6EC10F7B8DD59006.chapter_subtitle": [
    "Чотири ключові боси дають сувої розблокування: Наґа — книги магії, Гідра — магію 2-го кола й броню магів, Візер — спорядження 3-го ступеня, Іґніс — 4-го. Решта босів розкладені за силою після свого ключа."
  ]
  "quest.2F50CC1F889B4249.title": "Ключ I: Наґа"
  "quest.2F50CC1F889B4249.quest_desc": [
    "Перший бос Сутінкового лісу, кам’яний двір наґи. 120 здоров’я, ривки по колу."
    "§6Нагорода: «Сувій ключа: Наґа» — відкриває книги заклинань Iron’s Spells на 5–8 слотів і книгу початківця Ars Nouveau."
    "§7Нагорода — сувій: ПКМ відкриває рівень назавжди для того, хто його прочитав. Кожен гравець команди забирає свій сувій. Заблоковані предмети не крафтяться, не вдягаються й не працюють; у підказці предмета написано, який сувій потрібен."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.0FFFE3A9A4BBFB02.title": "Сутінковий ліч"
  "quest.0FFFE3A9A4BBFB02.quest_desc": [
    "Вежа ліча. 100 здоров’я; спершу збийте щити. Скипетри."
    "§7Сила: після ключа «Наґа»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.66BBE5A6188162F6.title": "Гриботавр"
  "quest.66BBE5A6188162F6.quest_desc": [
    "Серце лабіринту. 120 здоров’я. Алмазна сокира мінотавра."
    "§7Сила: після ключа «Наґа»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.6733C26A146074D8.title": "Стародавній вартовий"
  "quest.6733C26A146074D8.quest_desc": [
    "Океанічний монумент. 80 здоров’я, втома копання."
    "§7Сила: після ключа «Наґа»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.73676D6245E3EA2E.title": "Багряний претор"
  "quest.73676D6245E3EA2E.quest_desc": [
    "Табір культистів Thaumcraft. 125 здоров’я. Мішок рідкісного луту."
    "§7Сила: після ключа «Наґа»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.34EBFF4BC6D245EE.title": "Ключ II: Гідра"
  "quest.34EBFF4BC6D245EE.quest_desc": [
    "Вогняне болото Сутінкового лісу, після ліча й гриботавра. 360 здоров’я, три голови; відрубуйте відкриті."
    "§6Нагорода: «Сувій ключа: Гідра» — відкриває книги Iron’s на 10 слотів, книгу мага Ars, броню шкіл магії Iron’s і стихійну броню Ars Elemental."
    "§7Нагорода — сувій: ПКМ відкриває рівень назавжди для того, хто його прочитав. Кожен гравець команди забирає свій сувій. Заблоковані предмети не крафтяться, не вдягаються й не працюють; у підказці предмета написано, який сувій потрібен."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.61A4438837141C05.title": "Фантоми лицаря"
  "quest.61A4438837141C05.quest_desc": [
    "Фортеця гоблінів. Шість фантомів по 35. Лицарське спорядження."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.1447872535432413.title": "Ур-ґаст"
  "quest.1447872535432413.quest_desc": [
    "Темна вежа. 250 здоров’я. Кармініт, вогняні сльози."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.106A4DED89EB0E03.title": "Альфа-єті"
  "quest.106A4DED89EB0E03.quest_desc": [
    "Печера снігових земель. 200 здоров’я. Хутро альфа-єті."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.58298A3057580F02.title": "Снігова королева"
  "quest.58298A3057580F02.quest_desc": [
    "Крижаний палац. 200 здоров’я. Лук шукача або трилук."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.29EBF00E78FBA3DB.title": "Король-небіжчик"
  "quest.29EBF00E78FBA3DB.quest_desc": [
    "Катакомби Iron’s. 500 здоров’я, броня 15. Некрономікон, кривавий посох."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.3AF34C5F59B712A5.title": "Прадавні рештки"
  "quest.3AF34C5F59B712A5.quest_desc": [
    "Проклята піраміда в пустелі. 450 здоров’я, броня 12, удар 25."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.09102D42343C449E.title": "Провісник"
  "quest.09102D42343C449E.quest_desc": [
    "Стародавня фабрика. 390 здоров’я, лазери й ракети. Візеритовий блок."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.7B661C067288731E.title": "Левіятан"
  "quest.7B661C067288731E.quest_desc": [
    "Затонуле місто. 400 здоров’я, бій під водою. Кігті хвиль."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.6AD996D7344AEFDD.title": "Маледикт"
  "quest.6AD996D7344AEFDD.quest_desc": [
    "Крижана в’язниця. 420 здоров’я. Проклятий злиток."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.7F16B15415D0F783.title": "Скілла"
  "quest.7F16B15415D0F783.quest_desc": [
    "Морська споруда. 390 здоров’я, блискавки. Сутність бурі."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.735569AFF390D750.title": "Ключ III: Візер"
  "quest.735569AFF390D750.quest_desc": [
    "Призивається гравцем: три черепи візер-скелета на Т з піску душ. 300 здоров’я, броня 4, вибухові черепи."
    "§6Нагорода: «Сувій ключа: Візер» — відкриває книги Iron’s на 12 слотів, книгу архімага Ars, незеритову зброю Epic Fight і WoM, броню незеритового мага та легендарну зброю Iron’s."
    "§7Нагорода — сувій: ПКМ відкриває рівень назавжди для того, хто його прочитав. Кожен гравець команди забирає свій сувій. Заблоковані предмети не крафтяться, не вдягаються й не працюють; у підказці предмета написано, який сувій потрібен."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.6D633D4D3906F3CD.title": "Чорнорогий"
  "quest.6D633D4D3906F3CD.quest_desc": [
    "Кузня душ у Незері. 600 здоров’я, броня 12, удар 25. Пекельна кузня."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.4B2B621EC80B10CD.title": "Дикун-химера"
  "quest.4B2B621EC80B10CD.quest_desc": [
    "Ритуал Ars Nouveau. 1000 здоров’я, три фази."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.002E2E1047152FFA.title": "Потойбічний наглядач"
  "quest.002E2E1047152FFA.quest_desc": [
    "Outer Lands Thaumcraft. 200 здоров’я. Первісна перлина."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.2720205EEB22C822.title": "Потойбічний конструкт"
  "quest.2720205EEB22C822.quest_desc": [
    "Outer Lands Thaumcraft. 250 здоров’я. Первісна перлина."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.62D7A966AB1217DD.title": "Варден"
  "quest.62D7A966AB1217DD.quest_desc": [
    "Давнє місто глибин. 500 здоров’я, удар 30, сліпий — тиша рятує."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.550FC95881C7BF55.title": "Ключ IV: Іґніс"
  "quest.550FC95881C7BF55.quest_desc": [
    "Вогняна арена в Незері. 450 здоров’я, броня 10, удари вогнем і щит — найкраще спорядження III ступеня."
    "§6Нагорода: «Сувій ключа: Іґніс» — відкриває очищений обсидіан, сплав затемнення, Ruinfighter і Duskfire."
    "§7Нагорода — сувій: ПКМ відкриває рівень назавжди для того, хто його прочитав. Кожен гравець команди забирає свій сувій. Заблоковані предмети не крафтяться, не вдягаються й не працюють; у підказці предмета написано, який сувій потрібен."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.0E71CD0F0B82DF84.title": "Ендовий сторож"
  "quest.0E71CD0F0B82DF84.quest_desc": [
    "Зруйнована цитадель в Енді. 333 здоров’я, броня 20. Кулак охорони."
    "§7Сила: після ключа «Іґніс»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.1D69C37211C08185.title": "Дракон Енду"
  "quest.1D69C37211C08185.quest_desc": [
    "Енд. 200 здоров’я; спершу розбийте кристали."
    "§7Сила: після ключа «Іґніс»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.6E06EAB361A50266.title": "Відлуння Тиросу"
  "quest.6E06EAB361A50266.quest_desc": [
    "Перший вогненосець Iron’s. 1000 здоров’я, броня 15. Божественний уламок душі."
    "§7Сила: після ключа «Іґніс»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "chapter.2164B06C5C4E5367.title": "&#8C8678П0.1 • &#FFB15CЗ&#FFAB5Bб&#FFA55Aр&#FF9F58о&#FF9957я &#FF9356т&#FF8D55а &#FF8753б&#FF8152р&#FF7B51о&#FF7550н&#FF6F4Eя&#FF694D: &#FF634Cв&#FF5D4Bі&#FE594Aд &#FB564Aг&#F8534Aі&#F6504Aр&#F34D4Aш&#F14A4Aо&#EE474Aї &#EB444Aд&#E9414Aо &#E63E4Aк&#E33C4Aр&#E1394Aа&#DE364Aщ&#DC334Aо&#D9304Aї"
  "chapter.2164B06C5C4E5367.chapter_subtitle": [
    "Уся зброя й броня збірки за ступенями 0–IV з реальними числами: шкода, швидкість, броня, твердість. Окремо — дальній бій, технічна броня та броня магів. Квести необов’язкові: це довідник, предмет зараховується, щойно потрапить в інвентар."
  ]
  "quest.259C65D1E49B2B34.title": "Зброя 0 • Старт"
  "quest.259C65D1E49B2B34.quest_desc": [
    "Дерево й камінь, перші посохи. Шкода 3–8 — вистачить на звичайних мобів першої ночі."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.33BBD6F5BC2745D2.quest_desc": [
    "§eШкода 5, швидкість 1.6 (8.0 за секунду), міцність 131."
    "Перший нормальний меч."
  ]
  "quest.7BC2A33D50E8D922.quest_desc": [
    "§eШкода 3, швидкість 2.4 (7.2 за секунду), міцність 131."
    "Кинджал Epic Fight: швидкі серії, мало шкоди за удар."
  ]
  "quest.0EA4BA4132A3F9B9.quest_desc": [
    "§eШкода 3, швидкість 1.5 (4.5 за секунду), міцність 131."
    "Посох WoM: довгі комбо з розмахом."
  ]
  "quest.442FB6157E87B62C.quest_desc": [
    "§eШкода 4, швидкість 1 (4.0 за секунду)."
    "Тростина майстра — посох для заклинань Iron’s."
  ]
  "quest.32DAB0D04FA1273A.title": "Зброя I • Залізо"
  "quest.32DAB0D04FA1273A.quest_desc": [
    "Залізо, бронза, залізне дерево й сталеволист Сутінкового лісу. Шкода 6–10, з цим ідуть до Наґи."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.34EDC76C3697BC3C.quest_desc": [
    "§eШкода 6, швидкість 1.6 (9.6 за секунду), міцність 250."
    "База ступеня."
  ]
  "quest.004F660361FCCF0F.quest_desc": [
    "§eШкода 7, швидкість 1.2 (8.4 за секунду), міцність 250."
    "Довгий меч Epic Fight: захват і сильні добивання."
  ]
  "quest.4059B5068B522DD8.quest_desc": [
    "§eШкода 14, швидкість 1.05 (14.7 за секунду), міцність 250."
    "Величний меч: 14 шкоди, але повільний, бити треба з вікна."
  ]
  "quest.61670281AE291E0B.quest_desc": [
    "§eШкода 6, швидкість 1.6 (9.6 за секунду), міцність 512."
    "Залізне дерево з Сутінкового лісу: ремонтується саме."
  ]
  "quest.36BFC147F99644D0.quest_desc": [
    "§eШкода 7, швидкість 1.6 (11.2 за секунду), міцність 131."
    "Сталеволист: зачарований на грабунок."
  ]
  "quest.3CE7B4526C50FDEA.quest_desc": [
    "§eШкода 6, швидкість 1.6 (9.6 за секунду), міцність 375."
    "Бронза Mekanism."
  ]
  "quest.7B723C78FDA111C3.title": "Зброя II • Алмаз"
  "quest.7B723C78FDA111C3.quest_desc": [
    "Алмаз, лицарський метал, вогняний меч, Just Dire Things. Шкода 7–15 — для Гідри й босів Cataclysm першого кола."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.616F12A7550AD474.quest_desc": [
    "§eШкода 7, швидкість 1.6 (11.2 за секунду), міцність 1561."
    "База ступеня."
  ]
  "quest.31F860300F09FAE2.quest_desc": [
    "§eШкода 15, швидкість 1 (15.0 за секунду), міцність 1561."
    "Величний меч Epic Fight: 15 шкоди."
  ]
  "quest.453AF4DB259FBE12.quest_desc": [
    "§eШкода 7, швидкість 1.6 (11.2 за секунду), міцність 512."
    "Лицарський метал: більше шкоди по броньованих."
  ]
  "quest.4B063006FC13BF32.quest_desc": [
    "§eШкода 8, швидкість 1.6 (12.8 за секунду), міцність 1024."
    "Вогняний меч: підпалює ціль."
  ]
  "quest.18668987ADB71731.quest_desc": [
    "§eШкода 6.5, швидкість 2 (13.0 за секунду), міцність 500."
    "Ферікор Just Dire Things."
  ]
  "quest.2D3D2FF6E3B44D4C.quest_desc": [
    "§eШкода 6, швидкість 1.6 (9.6 за секунду), міцність 750."
    "Чорна сталь Cataclysm."
  ]
  "quest.01F55726F44AD5CD.quest_desc": [
    "§eШкода 8, швидкість 1.9 (15.2 за секунду), міцність 1061."
    "Страждання (Iron’s): меч для мага-воїна."
  ]
  "quest.67E92E865EBAD123.title": "Зброя III • Незерит і рідкісне"
  "quest.67E92E865EBAD123.quest_desc": [
    "Незерит, зброя босів Cataclysm, легендарне Iron’s, WoM. Шкода 9–18. Незеритова зброя Epic Fight і WoM та легендарна Iron’s відкриваються сувоєм Візера."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.07EAF01B9AC78927.quest_desc": [
    "§eШкода 8, швидкість 1.6 (12.8 за секунду), міцність 2031."
    "База ступеня."
  ]
  "quest.7B073E83C5E2E61E.quest_desc": [
    "§eШкода 16, швидкість 0.95 (15.2 за секунду), міцність 2031."
    "Незеритовий величний меч: 16 шкоди."
    "§6Заблоковано до «Сувій ключа: Візер» (квест П0)."
  ]
  "quest.55B6EAA89789D380.quest_desc": [
    "§eШкода 12, швидкість 1.3 (15.6 за секунду), міцність 2031."
    "Велика сокира WoM."
    "§6Заблоковано до «Сувій ключа: Візер» (квест П0)."
  ]
  "quest.63A021366CEECC7A.quest_desc": [
    "§eШкода 7, швидкість 2.2 (15.4 за секунду), міцність 2135."
    "Учіґатана WoM: швидкі розрізи."
  ]
  "quest.1098569139E46118.quest_desc": [
    "§eШкода 10, швидкість 1.8 (18.0 за секунду), міцність 2031."
    "Переривач заклинань: 10 шкоди, ламає чари."
    "§6Заблоковано до «Сувій ключа: Візер» (квест П0)."
  ]
  "quest.2F7FE0789EB96A4F.quest_desc": [
    "§eШкода 13, швидкість 1.4 (18.2 за секунду), міцність 2031."
    "Пеклоріз: спис вогню."
    "§6Заблоковано до «Сувій ключа: Візер» (квест П0)."
  ]
  "quest.2651213CEF1AC1BE.quest_desc": [
    "§eШкода 15, швидкість 1.05 (15.8 за секунду)."
    "Душокрай — з Чорнорогого."
  ]
  "quest.068BA42625093166.quest_desc": [
    "§eШкода 10.5, швидкість 1.4 (14.7 за секунду)."
    "Астрапа — спис блискавки Скілли."
  ]
  "quest.287DCECA7EBA9638.quest_desc": [
    "§eШкода 14, швидкість 1.2 (16.8 за секунду)."
    "HF-BLADE (NightFall): 14 шкоди, тачі."
  ]
  "quest.05099FB8F6FC20B8.quest_desc": [
    "§eШкода 16, швидкість 1 (16.0 за секунду)."
    "Меч руїн (NightFall): 16 шкоди."
  ]
  "quest.14F31F63E0174E9C.title": "Зброя IV • Фінал"
  "quest.14F31F63E0174E9C.quest_desc": [
    "Найсильніше: очищений обсидіан, Спалювач, сплав затемнення. Шкода 12–22. Очищений обсидіан і сплав затемнення відкриває сувій Іґніса."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.1BF90E5EEF50CFDA.quest_desc": [
    "§eШкода 12, швидкість 1.6 (19.2 за секунду), міцність 4096."
    "Очищений обсидіан Mekanism: 12 шкоди, міцність 4096."
    "§6Заблоковано до «Сувій ключа: Іґніс» (квест П0)."
  ]
  "quest.2B97816776B30D36.quest_desc": [
    "§eШкода 14, швидкість 1.4 (19.6 за секунду)."
    "Спалювач — з Іґніса."
  ]
  "quest.2989467B3B4D8B6E.quest_desc": [
    "§eШкода 9, швидкість 2 (18.0 за секунду), міцність 2561."
    "Сплав затемнення Just Dire Things."
    "§6Заблоковано до «Сувій ключа: Іґніс» (квест П0)."
  ]
  "quest.7025CE501C4DECDF.quest_desc": [
    "§eШкода 15, швидкість 2.2 (33.0 за секунду), міцність 1561."
    "Ієснієвий ніж Occultism: 15 шкоди й дуже швидкий."
  ]
  "quest.778650085176559E.quest_desc": [
    "§eШкода 21.8, швидкість 1.6 (34.9 за секунду), міцність 2500."
    "Катана тіньового металу (Tainted Magic): 21.8 шкоди."
  ]
  "quest.2DC625E3BDBC4C09.quest_desc": [
    "§eШкода 15.5, швидкість 1.6 (24.8 за секунду), міцність 1561."
    "Коса білоокого (Thaumic Bases)."
  ]
  "quest.43535803DD9B1D85.title": "Дальній бій"
  "quest.43535803DD9B1D85.quest_desc": [
    "Лук → арбалет → луки Сутінкового лісу → гармати Cataclysm і бластер WoM."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.2C44354EC079DE39.quest_desc": [
    "Старт."
  ]
  "quest.7045BE10B7B3F425.quest_desc": [
    "Арбалет: сильний постріл, довга перезарядка."
  ]
  "quest.7DAAAEAAB5FDAA06.quest_desc": [
    "Лук шукача: стріли самі летять у ціль."
  ]
  "quest.7B60B313BE3749AB.quest_desc": [
    "Трилук: три стріли за постріл."
  ]
  "quest.0ABDF4AE7CBD171E.quest_desc": [
    "Лук Енду: міняє вас місцями з ціллю."
  ]
  "quest.65C9DF2B51684234.quest_desc": [
    "§eШкода 7, швидкість 3.45 (24.2 за секунду), міцність 4738."
    "Ендер-бластер WoM."
  ]
  "quest.549489B6631DB35F.quest_desc": [
    "Лазерний ґатлінґ Cataclysm."
  ]
  "quest.4691543F29689013.quest_desc": [
    "Наплічна гармата візера (Cataclysm)."
  ]
  "quest.08710B50CFA6C8FF.title": "Броня 0 • Старт"
  "quest.08710B50CFA6C8FF.quest_desc": [
    "Шкіра, кольчуга, золото — до 12 броні за комплект."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.547D3EF85AC0B1F2.quest_desc": [
    "§eКомплект (4 частини): броня 7, твердість 0."
  ]
  "quest.605D5A4BE22A89DE.quest_desc": [
    "§eКомплект (4 частини): броня 12, твердість 0."
  ]
  "quest.69197F08A8A83D92.quest_desc": [
    "§eКомплект (4 частини): броня 11, твердість 0."
  ]
  "quest.78793C83EB63F3FE.title": "Броня I • Залізо"
  "quest.78793C83EB63F3FE.quest_desc": [
    "15 броні: залізо, бронза, пневматична броня."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.109DC58E3BE7FC7B.quest_desc": [
    "§eКомплект (4 частини): броня 15, твердість 0."
  ]
  "quest.767DCCCB4866BF27.quest_desc": [
    "§eКомплект (4 частини): броня 18, твердість 4."
  ]
  "quest.4C73C66D4306A5EE.quest_desc": [
    "§eКомплект (4 частини): броня 15, твердість 4, відкидання −0.8."
  ]
  "quest.6B5CC73151A1DC3B.quest_desc": [
    "§eКомплект (4 частини): броня 16, твердість 0."
  ]
  "quest.2CA7848A8F1AB8EE.title": "Броня II • Алмаз"
  "quest.2CA7848A8F1AB8EE.quest_desc": [
    "16–24 броні: алмаз, сталь, лицарський метал, вогняна й арктична броня."
    "§7Позначте, коли прочитали; предмети праворуч — приклади ступеня з реальними числами."
  ]
  "quest.1A4C8A4FC8701372.quest_desc": [
    "§eКомплект (4 частини): броня 20, твердість 8."
  ]
  "quest.6228850CF8D9F1DC.quest_desc": [
    "§eКомплект (4 частини): броня 20, твердість 8."
  ]
  "quest.04AFD2630F4098D7.quest_desc": [
    "§eКомплект (4 частини): броня 20, твердість 4."
  ]
  "quest.19E5764373B5DC5F.quest_desc": [
    "§eКомплект (4 частини): броня 24, твердість 6."
  ]
  "quest.71209140AF38B6A7.quest_desc": [
    "§eКомплект (4 частини): броня 16, твердість 8."
