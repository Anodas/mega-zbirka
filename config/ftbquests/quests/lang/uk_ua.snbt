  ]
  "quest.5223352B0435596F.title": "Жезл симетрії"
  "quest.5223352B0435596F.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0F7B59334ADAC626.title": "Конвеєрна стрічка"
  "quest.0F7B59334ADAC626.quest_desc": [
    "Розмістіть два паралельні вали та з'єднайте їх стрічкою. Підведіть обертання, щоб транспортувати предмети між операціями."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2F647E61427A8860.title": "Механічна рука"
  "quest.2F647E61427A8860.quest_desc": [
    "Виберіть точки забору й доставки предметів. Рука зручна для подавання палива та обслуговування компактних виробничих ліній."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7A73608742C27F5B.title": "Сполучник відображення"
  "quest.7A73608742C27F5B.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
