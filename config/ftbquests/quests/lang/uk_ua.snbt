  ]
  "quest.49359C57FB02B76A.title": "Жертовний вівтар"
  "quest.49359C57FB02B76A.quest_desc": [
    "Підготуйте наведені складники й виконайте практичну дію з описаної гілки. Кількості та сумісність перевірте у встановленому рецепті JEI та внутрішньому посібнику мода."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.181F21A6EC6D6A8A.title": "Ars Ocultas: духи в банках"
  "quest.181F21A6EC6D6A8A.quest_desc": [
    "Використайте ритуал утримання Ars для сумісного духа Occultism. У банку можна подавати предмети каналами або помічниками; тип духа визначає операцію. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6BE24E57C6D6C4E1.title": "Як читати схеми пентаклів"
  "quest.6BE24E57C6D6C4E1.quest_desc": [
    "Відтворюйте схему зі словника з правильною висотою й орієнтацією. Не замінюйте колір крейди іншим, якщо рецепт цього не дозволяє. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.214FAAF759AA4914.title": "Початок Blood Magic"
  "quest.214FAAF759AA4914.quest_desc": [
    "Посібник установленого порту створюється зі звичайної книги та скла й відкривається через Modopedia. Старий посібник Patchouli не використовуйте."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4E1B4F11A68604CD.title": "Жертовний ніж"
  "quest.4E1B4F11A68604CD.quest_desc": [
    "Поповніть алтар життєвою есенцією жертовним кинджалом і перевірте запас перед рецептом. Підтримуйте здоров’я та їжу персонажа; власний кинджал і кинджал жертвоприношення мають різне застосування. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.29DADD6AD4E468F9.title": "Чистий сланець"
  "quest.29DADD6AD4E468F9.quest_desc": [
    "Пластини послідовно розвиваються в алтарі. Перевірте потрібний рівень, попередню пластину та запас LP у JEI; місткість і швидкість поповнення алтаря — різні характеристики."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.22BAE0501457303A.title": "Алтар другого рівня"
  "quest.22BAE0501457303A.quest_desc": [
    "Зберіть другий рівень за схемою Modopedia й перевірте його розпізнавання. Руни слід розмістити в конструкції; зберігання їх в інвентарі не підтверджує рівень. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0242D3E4CFBF04F8.title": "Армований сланець"
  "quest.0242D3E4CFBF04F8.quest_desc": [
    "Пластини послідовно розвиваються в алтарі. Перевірте потрібний рівень, попередню пластину та запас LP у JEI; місткість і швидкість поповнення алтаря — різні характеристики."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.43FFE3631B6C966B.title": "Слабка кров'яна куля"
  "quest.43FFE3631B6C966B.quest_desc": [
    "Ця сфера відкриває рецепти відповідного рівня й працює з мережею душі власника. Прив’яжіть її та підтримуйте запас мережі; LP у самому алтарі обліковуються окремо."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.67FA6E8DFE4BADB0.title": "Головний ритуальний камінь"
  "quest.67FA6E8DFE4BADB0.quest_desc": [
    "Зберіть ритуал за допомогою віщуна або схеми Modopedia. Перевірте типи ритуальних каменів, прив’язаний кристал, рівень інструмента та запас LP у мережі душі. Підготуйте всі наведені предмети завдання."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6A15712E1C277F78.title": "Руна жертвопринесення"
  "quest.6A15712E1C277F78.quest_desc": [
    "Руна змінює певну властивість алтаря. Встановіть її замість звичайної руни у правильному місці конструкції та перевірте ефект; швидкість, місткість і передавання LP не є одним параметром."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.614AE1C3AD37F7E2.title": "Жертовний кинджал"
  "quest.614AE1C3AD37F7E2.quest_desc": [
    "Кинджал жертвоприношення використовується з придатними істотами біля алтаря. Перевірте дистанцію й тип цілі; це інший спосіб поповнення, ніж витрачання власного здоров’я."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1DBA02EC97581621.title": "Пекельна кузня"
  "quest.1DBA02EC97581621.quest_desc": [
    "Кузня пекельного полум’я використовує демонічну волю. Підготуйте камінь тартарика з достатнім запасом і перевірте вимогу рецепта, включно з мінімальним порогом волі."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.3C6414DA98859843.title": "Одержимий меч"
  "quest.3C6414DA98859843.quest_desc": [
    "Розумний меч дозволяє розвивати роботу з демонічною волею. Перевірте його взаємодію з каменем тартарика та здобич із супротивників."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1FE07B7117332B27.title": "Дрібний тартарський самоцвіт"
  "quest.1FE07B7117332B27.quest_desc": [
    "Камінь тартарика зберігає демонічну волю й використовується в кузні пекельного полум’я. Рівень каменя обмежує запас; для покращення потрібні відповідна кількість волі та рецепт."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.458DDF505E991BEC.title": "Малий тартарський самоцвіт"
  "quest.458DDF505E991BEC.quest_desc": [
    "Камінь тартарика зберігає демонічну волю й використовується в кузні пекельного полум’я. Рівень каменя обмежує запас; для покращення потрібні відповідна кількість волі та рецепт."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.766A65EF6C41046E.title": "Звичайний тартарський самоцвіт"
  "quest.766A65EF6C41046E.quest_desc": [
