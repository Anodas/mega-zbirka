  "quest.1CBFAC671F0E99FA.quest_desc": [
    "§eКомплект (4 частини): броня 24, твердість 12."
  ]
  "quest.24A01CF969BF2894.quest_desc": [
    "§eКомплект (4 частини): броня 17, твердість 7, відкидання −0.05."
    "Бонуси: мана, реген мани, знижка ціни стихії."
    "§6Заблоковано до «Сувій ключа: Гідра» (квест П0)."
  ]
  "quest.38522EA7DDB52506.title": "Більше реліквій (More Relics)"
  "quest.38522EA7DDB52506.quest_desc": [
    "More Relics додає 29 нових реліквій до мода Relics. Шукайте їх у скарбах споруд — так само, як звичайні реліквії."
    "Як і інші реліквії, вони набирають досвід від використання й відкривають нові вміння. Деякі еволюціонують: виконайте умову з підказки, і реліквія перетвориться на сильнішу."
    "§7Ці квести необов’язкові — предмет зараховується, щойно потрапить в інвентар."
  ]
  "quest.2B1211B6E1286F89.quest_desc": [
    "Ця корона втілює мужність. Її власник успадковує спадщину справжньої легенди й непохитність перед будь-яким випробуванням."
    "§6Навіть не близько:§r Надає викрадення здоров’я, яке залежить від шкоди й відсутнього здоров’я.\n(1-(Поточне здоров’я)/(Максимальне здоров’я)) * Шкода * X"
  ]
  "quest.7970E8A2DE402372.quest_desc": [
    "Рукавиця з величезною залізною кулею, яка змушує тіло власника рухатися разом з ударами. Завдяки цій конструкції вага тіла додає сили кожному удару."
    "§6Важкий удар:§r Ваші атаки завдають додаткову шкоду в розмірі X% максимального здоров’я з невеликою затримкою між спрацьовуваннями."
  ]
  "quest.08DF1701FEC694F9.quest_desc": [
    "Срібне намисто з невеликим опалом. Його традиційно дарують мандрівникам і воїнам, які вирушають у безплідні землі, бажаючи безпеки й захисту."
    "§6Бульбашковий щит:§r Один раз захищає від будь-якої шкоди, після чого відновлюється протягом X с."
  ]
  "quest.5E5A08854806E02E.quest_desc": [
    "Світло-рожевий крем. Посилює зцілення й пахне полуницею."
    "§6Зцілення та зволоження:§r Посилює зцілення з будь-якого джерела в XX."
  ]
  "quest.1811074293C82F84.quest_desc": [
    "Наручне кріплення з двома вигнутими лезами, спрямованими назовні. Доповнює основну зброю, вражаючи ворога, щойно той відволічеться. Такий незвичний стиль люблять розбійники й убивці: він може збити з пантелику навіть досвідченого супротивника."
    "§6Подвійність:§r Ділить кожну атаку на дві частини, що завдають відповідно X% і X% вашої шкоди."
  ]
  "quest.2883DE3DAF9146A6.quest_desc": [
    "Чобіт із гравітумним двигуном для послаблення дії гравітації. Ним часто користувалися астронавти на тренуваннях, доки не відкрили серйозну небезпеку гравітуму для здоров’я."
    "§6Легкі кроки:§r Зменшує силу тяжіння на X%. Шкода від падіння та безпечна висота падіння змінюються відповідно."
  ]
  "quest.395686E391277A1F.quest_desc": [
    "Просте, нічим не примітне намисто. Проте з ним щось не так, наче йому судилося стати чимось більшим."
    "§6Пробудження потенціалу:§r Поки ви носите амулет, думки про зірки Незеру не полишають вас, а їхні образи з’являються у снах. Усередині міцнішає бажання потримати одну з них."
    "§eЕволюція: дайте амулету поглинути зірки Незеру."
  ]
  "quest.678C9F8289E2A693.quest_desc": [
    "З амулета виринають щупальця чистого світла. Вони несамовито звиваються, наче прагнуть дотягнутися до чогось за завісою — до місця, якого відчайдушно шукають."
    "§6Разом ми сягнемо позамежного:§r Амулет тихо гуде, а його шепіт обплітає ваш розум, скеровуючи туди, куди ви неодмінно маєте потрапити."
    "§eЕволюція: відведіть амулет туди, куди він шепоче."
  ]
  "quest.514ECF68C10DC11E.quest_desc": [
    "Амулет цілком розкрив свій потенціал і набув справжньої форми. Тепер між вами наче виник особливий зв’язок."
    "§6Як одне ціле:§r «Створено на небесах» спрямовує у вас свою силу, збільшуючи всі характеристики в XX.\nВлучання у ворога дає Прискорення, яке накопичується до 10 разів. Кожен рівень додає 0.03X до всіх характеристик, крім здоров’я. Між отриманням рівнів діє затримка X с. Якщо деякий час не атакувати, усі рівні зникають."
  ]
  "quest.6B8AA1AA5AB824F4.quest_desc": [
    "Латунна маска забутого тирана. Його душа давно зникла, але маска досі сповнена злоби: вона приваблює неспокійних духів і поневолює їх своїм темним впливом."
    "§6Жалі:§r Ув’язнені в масці душі заважають вам, знижуючи швидкість руху, шкоду та швидкість атаки на X%."
    "§eЕволюція: подорожуйте, вбивайте монстрів і будуйте разом із маскою, щоб звільнити душі."
  ]
  "quest.3BE0AF31DE94E938.quest_desc": [
    "Звільнені душі вириваються з маски, змінюючи її колір і залишаючи дивний отвір посередині. У нього не видно дна, хоча зі зворотного боку маска суцільна."
    "§6Епітафія:§r Викривляє час і простір, повертаючи вас туди, де ви були 10 секунд тому. Відновлення: X с."
  ]
  "quest.53E411FBC1287103.quest_desc": [
    "Доволі важка сфера з невідомого матеріалу, який незворотно стискається під тиском."
    "§6Стиснення:§r Кожне влучання по власнику назавжди стискає сферу, зменшуючи розмір і різко збільшуючи щільність."
    "§eЕволюція: отримуйте удари, а наостанок — звукову атаку Вардена."
  ]
  "quest.6B8C311D49194D76.quest_desc": [
    "Сфера стиснулася в мініатюрну чорну діру. Тепер вона поглинає будь-яку загрозу власнику й спрямовує її на його супротивників."
    "§6Ентропія:§r X% отримуваної шкоди також завдається нападнику.\n\nВідбита шкода не може перевищувати поточне здоров’я власника."
  ]
  "quest.712630A713069354.quest_desc": [
    "Колись ця котушка відновлювала нитки, здатні змінювати реальність. Тепер вона втратила силу й стоїть тиха та порожня — пам’ятка забутого потенціалу."
    "§6Відновлення:§r Щоб повернути котушці здатність відновлювати нитки, які змінюють реальність, носіть її та тримайте в руках потрібні предмети."
    "§eЕволюція: вдягніть котушку й тримайте нитки та зілля регенерації."
  ]
  "quest.3E7C557A599EDD78.quest_desc": [
    "Котушці повернулася колишня сила. Вона знову відновлює шовк, який непомітно змінює реальність, сплітаючи події за задумом ткача."
    "§6Ткач:§r Кожне влучання у ворога вплітає шовк у вашу котушку. Вона вміщує до 10 одиниць шовку.\nКрім того, якщо шовку менше ніж 3, одна одиниця відновлюється кожні X с."
  ]
  "quest.1D9F06BD3575F9C4.title": "Дивні аксесуари (Odd Accessories)"
  "quest.1D9F06BD3575F9C4.quest_desc": [
    "Odd Accessories — 50 химерних аксесуарів для слотів Curios: від гральних кісток до парашута."
    "Найпростіший спосіб їх отримати — «Підозрілий мішок»: випадково трапляється в пригодах і дає випадковий аксесуар. Що робить кожен предмет, написано в його підказці."
    "§7Ці квести необов’язкові — предмет зараховується, щойно потрапить в інвентар."
  ]
  "quest.1196DD6EF1F0B70F.quest_desc": [
    "Дає випадковий аксесуар. Відкрийте кілька — колекція збирається швидко."
  ]
  "quest.3C000B2E2F027775.quest_desc": [
    "Опис ефекту — у підказці предмета."
  ]
  "quest.28095B0EB0A220E6.quest_desc": [
    "Опис ефекту — у підказці предмета."
  ]
  "quest.71D219DF32A0A318.quest_desc": [
    "Коли власника ранять, правець отримують і нападник, і власник."
  ]
  "quest.4883892D86FC6A9D.quest_desc": [
    "Рятує від падіння з висоти."
  ]
  "quest.3AD361BDF7F6E1BC.quest_desc": [
    "Опис ефекту — у підказці предмета."
  ]
  "quest.1BACC310F1F53FFC.quest_desc": [
    "Опис ефекту — у підказці предмета."
  ]
  "quest.1A74EAC1AB68285C.title": "Аксесуари Террарії (Terra Curio)"
  "quest.1A74EAC1AB68285C.quest_desc": [
    "Terra Curio додає 181 аксесуар у стилі Terraria: взуття для бігу й польоту, кульки для подвійного стрибка, щити, емблеми, прилади."
    "Прості аксесуари випадають з мобів і трапляються в скринях споруд — де саме, видно в JEI. У блоці «Майстерня» простіші аксесуари поєднуються в сильніші: наприклад, «Чоботи Гермеса» зрештою перетворюються на «Тераіскрові чоботи»."
    "«Серце демона» з Візера назавжди додає ще один слот аксесуара."
    "§7Ці квести необов’язкові — предмет зараховується, щойно потрапить в інвентар."
  ]
  "quest.27DF9ABDF7561BFC.quest_desc": [
    "Дозволяє власнику робити подвійний стрибок"
    "§7Де взяти: Можна знайти у скринях покинутих шахт і підземель."
  ]
  "quest.316A9CF832B763F4.quest_desc": [
    "Власник може бігати надзвичайно швидко"
    "§7Де взяти: Можна знайти у скринях сільського броняра."
  ]
  "quest.645F03CBE8A520F3.quest_desc": [
    "«Кажуть, вона приносить удачу й відганяє злих духів»"
    "Скасовує шкоду від падіння"
    "§7Де взяти: Можна знайти у скринях пустельних пірамід, міст Енду, пірамід у джунглях і стародавніх міст."
  ]
  "quest.6FF9793A7D3746E8.quest_desc": [
    "Повільно відновлює здоров’я"
    "§7Де взяти: Браслет регенерації може випасти з відьми"
  ]
  "quest.36258E5B530B1DC3.quest_desc": [
    "Подивіться в дзеркало, щоб повернутися додому"
    "§7Крафтиться в майстерні з простіших аксесуарів."
  ]
  "quest.5BD9C43182BF5124.quest_desc": [
    "Дозволяє врізатися у ворога ривком; один раз натисніть клавішу ривка"
    "§7Де взяти: Може випасти зі спустошувача."
  ]
  "quest.0F2525CCD2E31BB6.quest_desc": [
    "Поєднує аксесуари в сильніші. Рецепти — у JEI."
  ]
  "quest.1110671733632FD3.quest_desc": [
    "Дозволяє літати, надзвичайно швидко бігати й краще пересуватися льодом"
    "Дозволяє ходити по воді, меду та лаві"
    "Надає імунітет до блоків вогню та 7 секунд імунітету до лави"
    "Зменшує шкоду від дотику до лави"
    "§7Крафтиться в майстерні з простіших аксесуарів."
  ]
  "quest.4A7F53B84F4D8974.quest_desc": [
    "Дозволяє лазити стінами; для спуску утримуйте клавішу присідання"
    "Подвійне натискання клавіші напрямку дозволяє зробити ривок"
    "Дає шанс ухилитися від атаки"
    "§7Крафтиться в майстерні з простіших аксесуарів."
  ]
  "quest.3C6FE8AB2EEA8A21.quest_desc": [
    "Показує всю інформацію"
    "Дозволяє повертатися додому за бажанням"
    "§7Крафтиться в майстерні з простіших аксесуарів."
  ]
  "quest.6A6F7EFDFC5AD24E.quest_desc": [
    "Назавжди збільшує кількість слотів аксесуарів"
    "Залишилося використань: %s"
    "§7Де взяти: Випадає з візера."
  ]
  "quest.07D5A438F8F10D15.quest_desc": [
    "Дозволяє літати й повільно падати"
    "Утримуйте клавіші присідання та стрибка для горизонтального польоту"
    "«Що більше знаєш»"
    "§7Де взяти: Убийте дракона Енду, вдягнувши елітри"
  ]
  "quest.1B4128469795CC56.quest_desc": [
    "Дозволяє необмежено літати на крилах і ракетних чоботях"
    "§7Де взяти: Убийте візера, вдягнувши елітри"
  ]
  "quest.1D02163695A86261.title": "Якір польоту"
  "quest.1D02163695A86261.quest_desc": [
    "Якір польоту поєднує науку й аспекти: дає політ у чанку, де стоїть."
    "§6Магічний верстак§r (дослідження «Магічний камінь»): у центрі — §eелектричний блок керування§r (фінал етапу 1), з боків 2 перезаряджені залізні злитки New Age, зверху 2 мембрани фантома й повітряний осколок, знизу мідний дріт New Age. Віс: Aer 25, Ordo 15, Ignis 10 — вистачить заряду першого жезла."
    "Поставте якір — і в межах його чанку (16×16 блоків, на будь-якій висоті) кожен гравець літає, як у творчому режимі. Поза чанком політ вимикається, а 6 секунд повільного падіння рятують від удару."
    "§7Кілька якорів — кілька чанків польоту. Інші джерела польоту (творчий режим, MekaSuit тощо) якір не вимикає."
  ]
  "chapter.30E5227074C584CB.title": "&#8C8678П5 • &#FFB15CН&#FF9B58о&#FF8653в&#FF704Eі &#FF5A4Aб&#F6504Aі&#EC454Aо&#E23A4Aм&#D9304Aи"
  "chapter.30E5227074C584CB.chapter_subtitle": [
    "Нові біоми Biomes O’ Plenty та Regions Unexplored."
  ]
  "quest.27F4131DBBB76930.title": "Нові біоми"
  "quest.27F4131DBBB76930.quest_desc": [
    "Biomes O’ Plenty і Regions Unexplored додали понад 140 біомів у верхній світ і Незер."
    "§7Нові біоми з’являються лише в ще не відкритих чанках — вирушайте подалі від бази. Назву біому видно на F3 і в мінікарті."
  ]
  "quest.275F5661DF7F5887.title": "Секвоєвий ліс"
  "quest.275F5661DF7F5887.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.7B8EA496CB039CF9.title": "Лавандове поле"
  "quest.7B8EA496CB039CF9.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.20E3F2252EBBBA38.title": "Містичний гай"
  "quest.20E3F2252EBBBA38.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.1534F8E297B49864.title": "Вулкан"
  "quest.1534F8E297B49864.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.4BFBFFC6999B4623.title": "Кристалічна прірва"
  "quest.4BFBFFC6999B4623.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.09357869A02FDCB3.title": "Гай гліцинії"
  "quest.09357869A02FDCB3.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.1B19CEB38FBF1A91.title": "Савана баобабів"
  "quest.1B19CEB38FBF1A91.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.623DA0BA9F7C8D8F.title": "Біошрумові печери"
  "quest.623DA0BA9F7C8D8F.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.6A8B8EDA04DAD0DA.title": "Призмове провалля"
  "quest.6A8B8EDA04DAD0DA.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.3E4EFA4C907A20C5.title": "Шпилі"
  "quest.3E4EFA4C907A20C5.quest_desc": [
    "Знайдіть цей біом."
  ]
  "quest.695E188B2F5AB378.title": "Залізний лицар"
  "quest.695E188B2F5AB378.quest_desc": [
    "Mowzie’s Mobs: спить у підземній залі. 40 здоров’я, але сокира б’є до 30 — бийте в спину між замахами. Шолом і сокира тисячі металів."
    "§7Сила: після ключа «Наґа»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.64DE09659CF30ED6.title": "Кригопащ"
  "quest.64DE09659CF30ED6.quest_desc": [
    "Mowzie’s Mobs: спить у снігових біомах і прокидається, коли підійти. 250 здоров’я, крижане дихання й крижані кулі — від магії рятує перекат. Крижаний кристал."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.5DE469A344AFDCFD.title": "Умвуті, сонячний птах"
  "quest.5DE469A344AFDCFD.quest_desc": [
    "Mowzie’s Mobs: на троні в селі умвутан (савана) зі своїм племенем. 150 здоров’я, сонячні удари й промінь — їх блок не тримає, лише перекат. Сонячний лик."
    "§7Сила: після ключа «Гідра»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.647E2C660F6BCF56.title": "Нічний ліч"
  "quest.647E2C660F6BCF56.quest_desc": [
    "Bosses of Mass Destruction: вежа в холодних краях; зірка душ, що випадає після багатьох убивств, вказує шлях. 300 здоров’я, сині вогняні кулі й комети — від них перекат."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.04D76122900CF1AE.title": "Рукавиця Незеру"
  "quest.04D76122900CF1AE.quest_desc": [
    "Bosses of Mass Destruction: арена з чорного каменю в Незері. 250 здоров’я; прокидається від удару. Палаюче око."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.02521E70B5E875FE.title": "Пустотний цвіт"
  "quest.02521E70B5E875FE.quest_desc": [
    "Bosses of Mass Destruction: глибоко в печерах верхнього світу. 350 здоров’я, нерухомий: шипи з-під землі й лепестки-леза (блокуються), спори (перекат). Пустотний шип."
    "§7Сила: після ключа «Візер»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
  "quest.39B688B135389AD4.title": "Обсидиліт"
  "quest.39B688B135389AD4.quest_desc": [
    "Bosses of Mass Destruction: обсидіанова споруда в Енді. 300 здоров’я, стовпи й хвилі з землі. Обсидіанове серце."
    "§7Сила: після ключа «Іґніс»."
    "§7Квест рахує перемогу над босом; достатньо, щоб його здолала ваша команда."
  ]
