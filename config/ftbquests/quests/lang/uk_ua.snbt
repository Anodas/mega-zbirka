  ]
  "quest.74A272D96F742708.title": "Наповнена кирка"
  "quest.74A272D96F742708.quest_desc": [
    "Цей інструмент призначений для доступу до ресурсів Іншосвіту. Перевірте необхідний рівень добування й умови зору; звичайний вигляд руди може відрізнятися від того, що бачить підготовлений маг."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.25F7C426362F6F65.title": "Ритуальна сумка учня"
  "quest.25F7C426362F6F65.quest_desc": [
    "Ритуальна сумка полегшує роботу зі складниками. Перевірте місткість і спосіб вибору рецепта; потрібні предмети та правильний пентакль вона не створює сама."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.4012752069D7B702.title": "Відновлення ритуальної крейди"
  "quest.4012752069D7B702.quest_desc": [
    "Перевірте доступний спосіб ремонту крейди у словнику та JEI. Не витрачайте останній зразок потрібного кольору без запасу складників. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.0C0A83D4E8AB06AB.title": "Ритуал: Постійне ув’язнення Севіри"
  "quest.0C0A83D4E8AB06AB.quest_desc": [
    "Підготуйте наведені складники для відповідного пентакля зі словника духів. Правильно розкладіть крейду, свічки та чаші, додайте потрібну зв’язану книгу й виконайте ритуал. Наявність складників не підтверджує його запуск."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.495CF9471869CECE.title": "Вітеритовий пил"
  "quest.495CF9471869CECE.quest_desc": [
    "Отримайте складники й виконайте відповідне перетворення або ритуал зі словника духів. Звірте крейду, чаші, свічки та прив’язану книгу; результат визначається рецептом пентакля, а не лише набором предметів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.689BA270452677FE.title": "Майстерна ритуальна сумка"
  "quest.689BA270452677FE.quest_desc": [
    "Ритуальна сумка полегшує роботу зі складниками. Перевірте місткість і спосіб вибору рецепта; потрібні предмети та правильний пентакль вона не створює сама."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.2719B941FFCE0D84.title": "Ремонт предметів духами"
  "quest.2719B941FFCE0D84.quest_desc": [
    "Оберіть ритуал ремонту й перевірте його вимоги. Випробуйте його на доступному пошкодженому інструменті, перш ніж використовувати цінне спорядження. Підтвердження цієї практичної дії виконується вручну."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5DC798C1F31F1537.title": "Ритуал: Відкритий наказовий виклик Абраса"
  "quest.5DC798C1F31F1537.quest_desc": [
    "Підготуйте наведені складники для відповідного пентакля зі словника духів. Правильно розкладіть крейду, свічки та чаші, додайте потрібну зв’язану книгу й виконайте ритуал. Наявність складників не підтверджує його запуск."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
