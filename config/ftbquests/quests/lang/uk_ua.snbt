{
  "chapter.7CB5B3768E42CE0D.title": "&#8C86780.1 • &#7FF0FFC&#79EAFFr&#73E4FFe&#6DDEFFa&#67D8FFt&#61D2FFe&#5CCCFF: &#56C6FFм&#50C0FFе&#4ABAFFх&#44B4FFа&#3EAEFFн&#38A8FFі&#38A2FFч&#389CFFн&#3796FFа &#3790FFм&#378AFFа&#3684FFй&#367FFFс&#3679FFт&#3673FFе&#366DFFр&#3567FFн&#3561FFя"
  "chapter.7CB5B3768E42CE0D.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.0E2F817B7040B1B9.title": "Маршрут інженера"
  "quest.0E2F817B7040B1B9.quest_desc": [
    "Почніть із латуні, обертання та пари Create/MI. Вкладка 0.0 покроково веде до парового блока керування — ключа етапу 1. Транспорт, декор, кухня й інші довідкові гілки не є умовою переходу."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.076FA6C74127A609.title": "Андезитовий сплав"
  "quest.076FA6C74127A609.quest_desc": [
    "Не викидайте андезит: його сплав із залізом або цинком є основою механізмів Create. Підготуйте запас для майстерні."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.04B51425CDCE8296.title": "Передавання обертання"
  "quest.04B51425CDCE8296.quest_desc": [
    "Вали передають обертання між механізмами. Стежте за напрямком, швидкістю та загальним навантаженням мережі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.50E92E21727B8F74.title": "Водяне колесо"
  "quest.50E92E21727B8F74.quest_desc": [
    "Вода приводить колесо в рух. Підключіть його до валів і не перевищуйте доступне навантаження мережі."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.29DAE33BF15EE67D.title": "Механічний прес"
  "quest.29DAE33BF15EE67D.quest_desc": [
    "Прес робить листи на депо або конвеєрі. Автоматизуйте подавання злитків та відведення готових деталей."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.25DA48C18076CC3D.title": "Міксер і чаша"
  "quest.25DA48C18076CC3D.quest_desc": [
    "Міксер працює над чашею. Для частини рецептів потрібні достатня швидкість і нагрівання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.400B45CC05A1C8D9.title": "Латунна майстерня"
  "quest.400B45CC05A1C8D9.quest_desc": [
    "Поєднайте мідь і цинк у нагрітій чаші. Латунь відкриває точну механіку та розумну логістику."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.430AA5B5EC9C014B.title": "Механічний установник"
  "quest.430AA5B5EC9C014B.quest_desc": [
    "Установник виконує дії з предметом на конвеєрі. Він потрібний для послідовного збирання точних механізмів."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.27010EF06B5CD3E2.title": "Точний механізм"
  "quest.27010EF06B5CD3E2.quest_desc": [
    "Побудуйте лінію послідовного збирання. Перевірте порядок операцій у JEI та відокремлюйте готові механізми від незавершених."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6878BA134F9E3A28.title": "Перше стиснене залізо"
  "quest.6878BA134F9E3A28.quest_desc": [
    "Після завершення етапу 0 підготуйте стиснене залізо. Початковий вибуховий рецепт дивіться в JEI; робіть його подалі від майстерні."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2A59F5B37AD711D0.title": "Стиснене повітря"
  "quest.2A59F5B37AD711D0.quest_desc": [
    "Побудуйте компресор і пневматичну мережу. Стежте за тиском, паливом та допустимим навантаженням труб."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7AB9EEF6E72F5D93.title": "Барокамера"
  "quest.7AB9EEF6E72F5D93.quest_desc": [
    "Зберіть герметичну барокамеру з потрібними клапанами. Повну схему та вимоги до тиску дивіться в керівництві PneumaticCraft."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.50F003EB49E445B0.title": "Перевірка тиску"
  "quest.50F003EB49E445B0.quest_desc": [
    "Перед запуском перевірте запобіжні механізми та робочий тиск. Це ручне підтвердження перевірки, а не автоматичний датчик."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7D0518DDFA0B15B5.title": "Пластикові листи"
  "quest.7D0518DDFA0B15B5.quest_desc": [
    "Охолодіть розплавлений пластик: вилийте відро у світі та дочекайтеся затвердіння або застосуйте теплову рамку. Пластикові листи потрібні заготовкам і компонентам плат."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.615FAE454EC92365.title": "Готова друкована плата"
  "quest.615FAE454EC92365.quest_desc": [
    "На незмонтовану PCB встановіть два конденсатори та два транзистори за рецептом верстака. Для першої плати автоматична лазерна лінія не потрібна."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.39F8A5E12C50DB85.title": "Пневмомеханізм для електричного ключа"
  "quest.39F8A5E12C50DB85.quest_desc": [
    "Поєднайте стиснене залізо, два точні механізми Create та готову PCB. Рецепт дає два пневмомеханізми; один потрібен фінальному електричному блоку керування."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.31A02A3593821C05.title": "Ядра мережі"
  "quest.31A02A3593821C05.quest_desc": [
    "Ядра потрібні всій мережі Flux. У цій збірці ядро Flux потребує паровий блок керування — ключ завершення етапу 0."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6F90D8D380F7AAAF.title": "Робоча мережа Flux"
  "quest.6F90D8D380F7AAAF.quest_desc": [
    "З’єднайте генератор через Flux Plug, а споживача — через Flux Point. Оберіть одну мережу на обох блоках та перевірте статистику передачі FE."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.548E11CCDEF68697.title": "&#8C86782.1 • &#7FF0FFA&#7AEBFFE&#75E6FF2&#70E1FF: &#6BDCFFм&#67D7FFе&#62D2FFр&#5DCDFFе&#58C8FFж&#53C3FFа&#4EBEFF, &#49B9FFп&#44B4FFр&#3FAFFFо&#3AAAFFц&#38A6FFе&#38A1FFс&#379CFFо&#3797FFр&#3792FFи &#378DFFй &#3788FFа&#3683FFв&#367EFFт&#3679FFо&#3675FFк&#3670FFр&#356BFFа&#3566FFф&#3561FFт"
  "chapter.548E11CCDEF68697.chapter_subtitle": [
    "Латунь і пар — етап 0; електричні технології — етап 1."
  ]
  "quest.130C474A3A5D0336.title": "Паровий блок керування — ключ етапу 1"
  "quest.130C474A3A5D0336.quest_desc": [
    "Виготовте чотири парові блоки за новим рецептом. Це фінальний виробничий ресурс етапу 0: він потрібний початковим пристроям електричних гілок, Flux, реакторам, компресору PneumaticCraft і ключовим машинам AE2."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.0A38048275CDF5D6.title": "Кувальний молот MI"
  "quest.0A38048275CDF5D6.quest_desc": [
    "Зробіть ручний кувальний молот MI із заліза. Він дає початковий шлях до пилу, пластин та інших деталей без готової парової машини."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.7FA288ABCDDFA232.title": "Бронзові пластини"
  "quest.7FA288ABCDDFA232.quest_desc": [
    "Підготуйте бронзу з міді й олова. Перші пластини зробіть у кувальному молоті; після запуску парового компресора переходьте до серійної обробки."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.330B3CC229D9585D.title": "Парові корпуси MI"
  "quest.330B3CC229D9585D.quest_desc": [
    "Зберіть корпус із бронзових пластин і бронзової шестерні. Початкові парові корпуси більше не потребують парового блока керування."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.17091C2B0BCD9467.title": "Альтернатива: котел Modern Industrialization"
  "quest.17091C2B0BCD9467.quest_desc": [
    "Штатний котел MI залишено як альтернативне джерело пари. Для головної лінії етапу 0 достатньо нового парового бака біля нагрітого водяного резервуара Create."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7105FE5E7FD90B9C.title": "Парова переробка"
  "quest.7105FE5E7FD90B9C.quest_desc": [
    "Подайте пару до бронзового подрібнювача. Налаштуйте сторони вводу та виводу й залиште місце для відпрацьованої пари відповідно до підказок машини."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.647BE3B61F17BA19.title": "Пластини на пару"
  "quest.647BE3B61F17BA19.quest_desc": [
    "Підключіть бронзовий компресор до парової мережі. Автоматизуйте виготовлення пластин для подальших механізмів."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.272BE4F28D5AF5DE.title": "Кварц AE2"
  "quest.272BE4F28D5AF5DE.quest_desc": [
    "Після електричного блока керування переходьте до кварцу, процесорів і ME-логістики. Установник та енергоприймач AE2 тепер використовують електричний ключ."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.6EFFAA26D234B2BD.title": "Флюїкс"
  "quest.6EFFAA26D234B2BD.quest_desc": [
    "Виготовте кристали флюїксу за доступним рецептом JEI. Підготуйте їх для висікача, кабелів та ME-пристроїв."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.67CC26C7693EA9C3.title": "Висікач"
  "quest.67CC26C7693EA9C3.quest_desc": [
    "Зберіть висікач із електричним блоком керування та підведіть FE до доступної грані. Налаштуйте автоматичне подавання потрібних пресів і матеріалів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.11C2F61C4339520F.title": "Три процесори AE2"
  "quest.11C2F61C4339520F.quest_desc": [
    "Виготовте логічний, обчислювальний та інженерний процесори. Це продукція етапу 2; електричний ключ етапу 1 їх не вимагає."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2DEFA27A54DECCA3.title": "Живлення ME-мережі"
  "quest.2DEFA27A54DECCA3.quest_desc": [
    "Підключіть FE до енергоприймача AE2. Канали та внутрішня енергія мережі належать AE2; перевірте стан її пристроїв."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.50F85B3F816525CA.title": "Цифрове сховище"
  "quest.50F85B3F816525CA.quest_desc": [
    "Установіть дисковод та комірку, приєднайте їх до ME-кабелю й живлення."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.1DD489F02460AE82.title": "Робоче місце ME"
  "quest.1DD489F02460AE82.quest_desc": [
    "Підключіть термінал виготовлення. Перевірте доступ до предметів сховища та роботу каналів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.5819F2C3B79E75F5.title": "Перший автокрафт"
  "quest.5819F2C3B79E75F5.quest_desc": [
    "Підключіть постачальник шаблонів та молекулярний складальник, закодуйте шаблон і замовте пробний предмет."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.13273C51D45AB46B.title": "Бічна гілка: паровий кар’єр"
  "quest.13273C51D45AB46B.quest_desc": [
    "Після розвитку парової промисловості підготуйте кар’єр. Це додаткова ціль, а не вимога для парового блока керування."
    "§7Предмети не витрачаються. Рецепт відкривається натисканням на предмет завдання в JEI."
  ]
  "quest.3F5C63AFE78620F4.title": "Шаблони зовнішніх машин"
  "quest.3F5C63AFE78620F4.quest_desc": [
    "Підключіть машини MI, IF і Mekanism постачальниками шаблонів. Оброблення відрізняється від рецептів молекулярного складальника: мережа повинна отримати очікуваний результат назад."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.7F985CE6038D3C91.title": "&#8C86782.3 • &#7FF0FFM&#7AEAFFI&#74E5FF: &#6FDFFFе&#69DAFFл&#64D4FFе&#5ECFFFк&#59C9FFт&#53C4FFр&#4EBEFFи&#48B9FFч&#43B3FFн&#3DAEFFи&#38A8FFй &#38A3FFз&#389DFFа&#3798FFв&#3792FFо&#378DFFд &#3787FFі &#3682FFк&#367CFFа&#3677FFр&#3671FF’&#356CFFє&#3566FFр&#3561FFи"
  "chapter.7F985CE6038D3C91.chapter_subtitle": [
    "Mega zbirka • Промислова прогресія"
  ]
  "quest.3BC1C245CA16C215.title": "Базова електроніка MI"
  "quest.3BC1C245CA16C215.quest_desc": [
    "Електричний ключ уже виготовлено в етапі 1. Підготуйте аналогові схеми ручними рецептами; для них не потрібен готовий електричний складальний цех."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.4A54739A5E5CA224.title": "Електродвигуни MI"
  "quest.4A54739A5E5CA224.quest_desc": [
    "Підготуйте магнітні стрижні, дроти та кабелі. Двигун MI належить наступному виробничому рівню й більше не потрібний для створення ключа, що відкриває цей рівень."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.0EE4217029FF5189.title": "Електричний блок керування"
  "quest.0EE4217029FF5189.quest_desc": [
    "Фінал етапу 1: мідний дріт New Age зверху, два заряджені залізні зливки обабіч пневмомеханізму, паровий блок керування знизу. Рецепт дає чотири електричні блоки. Вони відкривають електричний MI та AE2 етапу 2; проходити всі додаткові гілки для цього не потрібно."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI. Ручна перевірка позначається окремо."
  ]
  "quest.2C9DF4C44DAA1D7C.title": "Первый электрический корпус"
  "quest.2C9DF4C44DAA1D7C.quest_desc": [
    "Корпуса всех электрических уровней MI теперь используют электрический блок управления, включая рецепты сборщика."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.4C2CB85CB556B735.title": "От пара к электричеству"
  "quest.4C2CB85CB556B735.quest_desc": [
    "LV-турбина превращает пар в EU. По умолчанию EU и FE не взаимозаменяемы: развивайте собственную сеть MI."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.009B4902524AD794.title": "Электрическая печь"
  "quest.009B4902524AD794.quest_desc": [
    "Подключите питание правильного уровня и автоматизируйте плавку."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.75958755EE2E18D0.title": "Электрическая переработка"
  "quest.75958755EE2E18D0.quest_desc": [
    "Электрическая линия заменяет паровые ручные операции. Подведите вход, выход и постоянное питание."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.382B91B7285E3430.title": "Провода для завода"
  "quest.382B91B7285E3430.quest_desc": [
    "Проволочный станок готовит массовое производство проводов. Сравните эффективность ручных и машинных рецептов."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.762984A970376CA4.title": "Сборочный цех"
  "quest.762984A970376CA4.quest_desc": [
    "Перенесите компоненты на автоматическую сборку. Изменённые рецепты корпусов в сборщике также требуют блоки управления."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.3A25B79BBCDBE384.title": "Алюминий"
  "quest.3A25B79BBCDBE384.quest_desc": [
    "Освойте цепочку производства алюминия. Этот материал нужен бурам и следующему поколению компонентов."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.7BDB4D94DD38FD48.title": "Электронные схемы"
  "quest.7BDB4D94DD38FD48.quest_desc": [
    "Автоматизируйте платы, транзисторы и диоды. Эти схемы понадобятся переходу к Mekanism."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.49CC1FBB3F992783.title": "Промышленный бур"
  "quest.49CC1FBB3F992783.quest_desc": [
    "Произведите алюминиевый бур. Один бур расходуется на восемь промышленных блоков Mekanism."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.769B2B4DA34790E0.title": "Электрический карьер"
  "quest.769B2B4DA34790E0.quest_desc": [
    "Улучшите паровой карьер и обеспечьте достаточную мощность. Продукцию направьте в AE2."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "quest.1677A4CA0E6D001B.title": "Разрешение на тяжёлую промышленность"
  "quest.1677A4CA0E6D001B.quest_desc": [
    "Промышленные блоки создаются из продукции электрического MI. Они нужны металлургическому наполнителю и стальному корпусу Mekanism."
    "§7Предметные задания не расходуют предметы. Заберите машину в инвентарь для зачёта."
  ]
  "chapter.53D6DF5FC26E86C8.title": "&#8C86782.5 • &#7FF0FFM&#7BECFFe&#77E8FFk&#73E4FFa&#6FE0FFn&#6BDCFFi&#67D8FFs&#63D4FFm&#5FD0FF: &#5CCCFFм&#58C8FFа&#54C4FFш&#50C0FFи&#4CBCFFн&#48B8FFи&#44B4FF, &#40B0FFф&#3CACFFа&#38A8FFб&#38A4FFр&#38A0FFи&#389CFFк&#3798FFи &#3794FFт&#3790FFа &#378CFFа&#3788FFт&#3684FFо&#3681FFм&#367DFFн&#3679FFи&#3675FFй &#3671FFс&#366DFFп&#3569FFл&#3565FFа&#3561FFв"
  "chapter.53D6DF5FC26E86C8.chapter_subtitle": [
    "Mega zbirka • Промислова прогресія"
  ]
  "quest.20193AD763DF31CD.title": "Металургійний наповнювач"
  "quest.20193AD763DF31CD.quest_desc": [
    "Металургійний наповнювач виготовляє сплави. Для початку потрібен промисловий блок Mekanism; інфузійні матеріали подаються окремо від основних предметів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.683CFD092F8D81CD.title": "Базові схеми"
  "quest.683CFD092F8D81CD.quest_desc": [
    "Поєднуйте осмій і редстоун у наповнювачі. Автоматизуйте подачу редстоуну й виведення схем; не змішуйте цю лінію з вуглецем для сталі."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.26B7D9868BAB4B66.title": "Сталеві корпуси"
  "quest.26B7D9868BAB4B66.quest_desc": [
    "Сталь отримується через збагачене залізо та його повторне насичення вуглецем із подальшим виплавленням. Рецепт корпуса містить промисловий блок Mekanism."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6B357C4D027B3D36.title": "Камера збагачення"
  "quest.6B357C4D027B3D36.quest_desc": [
    "Подвоєння придатних руд і збагачення реагентів виконуються без складної газової лінії. Для конкретної сировини вихід перевіряйте у JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.19F109B35C7CE6FF.title": "Дробарка"
  "quest.19F109B35C7CE6FF.quest_desc": [
    "Налаштуйте предметні боки та автоматичний вихід. Вона потрібна для пилів, біопалива та підготовки матеріалів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.224DABFFE021EB59.title": "Осмієвий компресор"
  "quest.224DABFFE021EB59.quest_desc": [
    "Подавайте осмій окремим ресурсним входом. Компресор виготовляє очищений обсидіан і світлокамінь за рецептами JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7476650BF48BC50F.title": "Збагачений сплав і просунуті схеми"
  "quest.7476650BF48BC50F.quest_desc": [
    "Виділіть наповнювач із редстоуном для збагаченого сплаву та схеми наступного рівня. Шаблони AE2 мають враховувати всі складники."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2F1F40D69D53AE2B.title": "Очищення руд із киснем"
  "quest.2F1F40D69D53AE2B.quest_desc": [
    "Подайте кисень у камеру очищення. Ланцюг очищення → дроблення → збагачення → виплавлення збільшує вихід придатної сировини; точні співвідношення залежать від форми руди."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2C0A05313A437537.title": "Електроліз: вода, кисень і водень"
  "quest.2C0A05313A437537.quest_desc": [
    "Розділяйте воду на кисень і водень. Налаштуйте обидва виходи й режими надлишку, щоб заповнений побічний резервуар не зупиняв виробництво."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.66EFE4CA345691FD.title": "Хімічна ін’єкція та оброблення руд"
  "quest.66EFE4CA345691FD.quest_desc": [
    "Підготуйте хлороводень для ін’єкційної камери. Ця гілка використовує хімічні трубопроводи й належить етапу 3."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.15A754FE33E182CF.title": "Посилений сплав та елітні схеми"
  "quest.15A754FE33E182CF.quest_desc": [
    "Посилюйте збагачений сплав алмазним реагентом. Окремий наповнювач запобігає змішуванню реагентів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.52CA9C821A8DBB38.title": "Цифровий шахтар — скінченні поклади"
  "quest.52CA9C821A8DBB38.quest_desc": [
    "Налаштуйте фільтри, радіус, висоту, живлення й вивід. Digital Miner добуває наявні блоки світу: після вичерпання зони його слід перенести. Для відновлюваної руди використовуйте лазери IF."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.49126C017B9E47C2.title": "Герметична реакційна камера"
  "quest.49126C017B9E47C2.quest_desc": [
    "Налаштуйте окремі входи предметів, рідини й хімікатів та обидва виходи. Перевірте режим боків і вільне місце для побічного продукту."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0864CCB7C6BCBA52.title": "Поліетилен HDPE"
  "quest.0864CCB7C6BCBA52.quest_desc": [
    "Отримайте субстрат та етилен із біопалива, води й водню. Переведіть етилен у рідину й завершіть рецепт HDPE з киснем і субстратом. Точні витрати показує JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.041AF5E76F2741D6.title": "Атомний сплав та абсолютні схеми"
  "quest.041AF5E76F2741D6.quest_desc": [
    "Завершення сплавів етапу 2: застосуйте обсидіановий реагент до посиленого сплаву, потім виготовте абсолютні схеми. Ядерні матеріали для цих сплавів не потрібні."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.03F7366AB7214286.title": "Ядерний блок керування — перехід до етапу 3"
  "quest.03F7366AB7214286.quest_desc": [
    "Виготовте блок із атомного сплаву, двох інженерних процесорів, абсолютної схеми та просунутого каркаса IF. Рецепт дає чотири штуки й не вимагає компонентів етапу 3."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.0ED1F53EF50DC0E9.title": "&#8C86783.2 • &#7FF0FFM&#7BECFFe&#77E8FFk&#73E4FFa&#70E0FFn&#6CDDFFi&#68D9FFs&#64D5FFm&#60D1FF: &#5CCDFFр&#59C9FFе&#55C5FFа&#51C1FFк&#4DBDFFт&#49BAFFо&#45B6FFр&#42B2FFи&#3EAEFF, &#3AAAFFт&#38A6FFу&#38A2FFр&#389EFFб&#379BFFі&#3797FFн&#3793FFи &#378FFFт&#378BFFа &#3787FFа&#3684FFн&#3680FFт&#367CFFи&#3678FFм&#3674FFа&#3670FFт&#356DFFе&#3569FFр&#3565FFі&#3561FFя"
  "chapter.0ED1F53EF50DC0E9.chapter_subtitle": [
    "Mega zbirka • Промислова прогресія"
  ]
  "quest.2B9FE67CA985FCFF.title": "Підготовка ядерного майданчика"
  "quest.2B9FE67CA985FCFF.quest_desc": [
    "Виділіть місце, забезпечте стабільне живлення, охолодження, зберігання відходів та кероване вимкнення. Спочатку перевірте побічні продукти й логіку зупинки."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.33E2352D547F455D.title": "Радіаційний захист"
  "quest.33E2352D547F455D.quest_desc": [
    "Підготуйте повний захисний комплект. Працюйте з радіоактивними відходами через правильні машини та трубопроводи."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5A93442F069B427A.title": "Реактор поділу"
  "quest.5A93442F069B427A.quest_desc": [
    "Зберіть реактор із портами, паливними збірками й керуванням. Перед подачею розщеплюваного палива перевірте охолодження та вихід відходів."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6761DAC203418B79.title": "Зберігання ядерних відходів"
  "quest.6761DAC203418B79.quest_desc": [
    "Підключіть радіоактивні відходи до правильного сховища або перероблення. Не розбирайте заповнені радіоактивні ємності."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2CEC344C324C6C6E.title": "Промислова турбіна"
  "quest.2CEC344C324C6C6E.quest_desc": [
    "Зберіть ротор, лопаті, комплекс обертання та виходи. Забезпечте достатню пропускну здатність пари й повернення конденсату."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1D1B779113D92A30.title": "Полоній"
  "quest.1D1B779113D92A30.quest_desc": [
    "Сонячний нейтронний активатор переробляє ядерні відходи за потрібних умов. У реакційній камері виготовте гранулу полонію за рецептом JEI."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3BA676A56255C67A.title": "Плутоній"
  "quest.3BA676A56255C67A.quest_desc": [
    "Ізотопна центрифуга дає плутонієву гілку перероблення відходів. Завершіть рецепт гранули й відводьте відпрацьований побічний продукт."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.205D9EC8B3336726.title": "MekaSuit: шолом"
  "quest.205D9EC8B3336726.quest_desc": [
    "Виготовте шолом із полонієвими компонентами й зарядіть. Додавайте модулі через станцію модифікації."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5636A512F5CFD97A.title": "MekaSuit: нагрудник"
  "quest.5636A512F5CFD97A.quest_desc": [
    "Нагрудник є основою гравітаційного польоту. Заряд і сам модуль польоту знадобляться окремо."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6D8C04849934ADA5.title": "MekaSuit: поножі"
  "quest.6D8C04849934ADA5.quest_desc": [
    "Виготовте та зарядіть поножі. Модулі пересування встановлюються через станцію модифікації."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.533739EED7BDBE6A.title": "MekaSuit: черевики"
  "quest.533739EED7BDBE6A.quest_desc": [
    "Завершіть основний комплект і перевірте енергію кожної частини. Сам комплект ще не додає гравітаційний політ."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.459E0FAA11AA4BBB.title": "Модульний інструмент Meka-Tool"
  "quest.459E0FAA11AA4BBB.quest_desc": [
    "Підготуйте інструмент, енергію та потрібні модулі видобутку. Режими налаштовуються окремо."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.429DE1A5BF2B07A5.title": "Термоядерний реактор — потужність для SPS"
  "quest.429DE1A5BF2B07A5.quest_desc": [
    "Підготуйте дейтерій, тритій, паливну капсулу та лазерне запалювання. Ця гілка підсилює живлення заводу; SPS можна живити й іншими достатньо потужними джерелами."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4D9AF1415EFEF276.title": "SPS: перетворення полонію"
  "quest.4D9AF1415EFEF276.quest_desc": [
    "Зберіть надкритичний фазообертач, надзаряджені котушки й енергетичні порти. Подайте полоній та стабільну енергію; виведіть антиматерію."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.65C8C2ED7022CB1A.title": "Перша гранула антиматерії"
  "quest.65C8C2ED7022CB1A.quest_desc": [
    "Перетворіть антиматерію в гранули через реакційну камеру за встановленим рецептом. Підготуйте три гранули для базового гравітаційного модуля."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2634BE9CE8673B82.title": "Безперервний завод антиматерії"
  "quest.2634BE9CE8673B82.quest_desc": [
    "Організуйте стабільне паливо, охолодження, відходи, полоній та енергію. Після виходу на режим переконайтеся, що установка не зупиняється від заповнення побічного виходу."
    "§7Предмети не витрачаються. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter_group.378CFB2DB8C23918.title": "&l&#C8AE86&lТ&#D1B88D&lе&#DBC393&lх&#E4CD9A&lн&#EDD8A1&lо&#EDD8A1&lл&#E4CD9A&lо&#DBC393&lг&#D1B88D&lі&#C8AE86&lї"
  "chapter_group.413CA3DBEF7C8F32.title": "Етап 1 • Від пари до електрики"
  "quest.6D24C3EED000EEEB.title": "Велика шестерня"
  "quest.6D24C3EED000EEEB.quest_desc": [
    "Поєднайте велику й малу шестерні та перевірте зміну швидкості. Підвищення обертів збільшує навантаження машин."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.503751789FD56ABE.title": "Андезитовий корпус"
  "quest.503751789FD56ABE.quest_desc": [
    "Обробіть обтесану колоду андезитовим сплавом. Корпуси потрібні більшості ранніх машин Create."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.297AD0770F50B9CC.title": "Конвеєрна стрічка"
  "quest.297AD0770F50B9CC.quest_desc": [
    "Розмістіть два паралельні вали та з'єднайте їх стрічкою. Підведіть обертання, щоб транспортувати предмети між операціями."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4C3ACCC6AF9A7F1D.title": "Вітрила"
  "quest.4C3ACCC6AF9A7F1D.quest_desc": [
    "Закріпіть вітрила на конструкції вітряка. Спочатку залиште достатньо простору для збирання та обертання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.35AF46E4E4630A1D.title": "Вітряний млин"
  "quest.35AF46E4E4630A1D.quest_desc": [
    "Приєднайте до підшипника конструкцію з вітрилами та активуйте її. Кількість робочих вітрил впливає на можливості приводу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.79BFFB147F96DBBD.title": "Радіальне шасі"
  "quest.79BFFB147F96DBBD.quest_desc": [
    "Шасі об'єднує блоки рухомої конструкції. Налаштуйте з'єднання та використайте суперклей там, де він потрібен."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6404292EB47C9E91.title": "Жорна"
  "quest.6404292EB47C9E91.quest_desc": [
    "Подайте обертання та завантажте сировину. Жорна готують борошно й інші матеріали; доступні операції дивіться в JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.7E2F7A3E688FFFFB.title": "Механічний бур"
  "quest.7E2F7A3E688FFFFB.quest_desc": [
    "Бур може ламати блоки стаціонарно або на рухомій конструкції. Спробуйте автоматичний генератор каменю."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.52B4E46952A0E240.title": "Редуктор"
  "quest.52B4E46952A0E240.quest_desc": [
    "Редуктор розводить обертання між горизонтальними осями. Перевірте напрямок виходів перед підключенням машин."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.55AEC6A82BDCF83E.title": "Вертикальний редуктор"
  "quest.55AEC6A82BDCF83E.quest_desc": [
    "Перенесіть обертання між різними рівнями майстерні. Вертикальні передачі допомагають уникнути зайвих валів навколо машин."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0F45DA98A98F5FB3.title": "Рухома майстерня"
  "quest.0F45DA98A98F5FB3.quest_desc": [
    "Підшипник обертає зібрану конструкцію. Підготуйте шасі, клей і вільний простір для механічної ферми."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.47C752A2F76A1E3A.title": "Лінійне шасі"
  "quest.47C752A2F76A1E3A.quest_desc": [
    "Лінійне шасі допомагає збирати довгі рухомі машини. Перевіряйте, які блоки потрапляють до конструкції."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.64E21F24A15CE277.title": "Конструкція на вагонетці"
  "quest.64E21F24A15CE277.quest_desc": [
    "Збирач дозволяє закріпити конструкцію на вагонетці. Випробуйте невеликий прототип перед встановленням дорогого обладнання."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.75CC02DBB9450F19.title": "Тунелі для конвеєра"
  "quest.75CC02DBB9450F19.quest_desc": [
    "Тунелі спрямовують потік предметів над стрічками. Побудуйте розгалуження та перевірте, куди потрапляє продукція."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.00CF30F8382961F9.title": "Портальна каретка"
  "quest.00CF30F8382961F9.quest_desc": [
    "Каретка рухається вздовж відповідного вала та переносить приєднану конструкцію. Визначте кінцеві положення руху."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.236168507EECC2A9.title": "Напрямна каретки"
  "quest.236168507EECC2A9.quest_desc": [
    "Напрямна визначає маршрут портальної каретки. З'єднайте секції та подайте обертання потрібного напрямку."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.050338D2DFF64718.title": "Кероване зчеплення"
  "quest.050338D2DFF64718.quest_desc": [
    "Цей блок приєднує або від'єднує частину конструкції. Перевірте роботу сигналу редстоуну на простому макеті."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2FD71B9B6C5469D1.title": "Запас стисненого повітря Create"
  "quest.2FD71B9B6C5469D1.quest_desc": [
    "Зарядіть повітряний балон обертанням. Це спорядження Create, а не пневматична мережа PneumaticCraft."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.1858734C3C96DD8B.title": "Підводні роботи"
  "quest.1858734C3C96DD8B.quest_desc": [
    "Шолом разом із зарядженим балоном допомагає працювати під водою. Перед зануренням перевірте запас повітря."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.5840C18AB6EEA921.title": "Водолазні черевики"
  "quest.5840C18AB6EEA921.quest_desc": [
    "Зберіть водолазний комплект для підводного будівництва. Перевірте його дію в безпечному мілкому місці."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.72B50AB04E3FAFB8.title": "Механічний поршень"
  "quest.72B50AB04E3FAFB8.quest_desc": [
    "Поршень переміщує приєднану конструкцію вздовж своєї осі. Обмежте хід і залиште місце для її повернення."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.37E6E004C63748DF.title": "Будівництво за схемою"
  "quest.37E6E004C63748DF.quest_desc": [
    "Підготуйте креслення та матеріали для схематичної гармати. Перевірте область будівництва перед запуском."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.2300C402988EF858.title": "Велике водяне колесо"
  "quest.2300C402988EF858.quest_desc": [
    "Велике колесо дає більший запас навантаження за меншої швидкості. Для швидких машин використайте передачу шестернями."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.52A6EB53632EF49A.title": "Незеритовий шолом"
  "quest.52A6EB53632EF49A.quest_desc": [
    "Поліпшене водолазне спорядження потребує дорогих матеріалів. Для небезпечного середовища перевіряйте вимоги до всього комплекту."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0D4A70F3EB2BFB80.title": "Незеритові черевики"
  "quest.0D4A70F3EB2BFB80.quest_desc": [
    "Завершіть поліпшення спорядження та вивчіть його підказки. Ця бічна гілка не потрібна для переходу до етапу 1."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.3C299A1B19470D83.title": "Поліпшений балон"
  "quest.3C299A1B19470D83.quest_desc": [
    "Поліпшіть балон і відновіть запас повітря. Не випробовуйте новий комплект у лаві без перевірки всіх його частин."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.594F5E0CCF357D9E.title": "Нотатки майстра"
  "quest.594F5E0CCF357D9E.quest_desc": [
    "Планшет допомагає вести списки й переносити налаштування сумісних блоків. Запишіть план майбутнього заводу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.6B3029835DC85CEF.title": "Ручний привід"
  "quest.6B3029835DC85CEF.quest_desc": [
    "Рукоятка підходить для коротких операцій і перевірки напрямку обертання. Для постійного виробництва побудуйте автоматичний привід."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.4358FE1B637C18E7.title": "Пакування вантажів"
  "quest.4358FE1B637C18E7.quest_desc": [
    "Пакувальник збирає предмети в пакунки. Підключіть його до складу й організуйте зрозумілі адреси доставки."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.14C4C91FBDEDEFE1.title": "Ланцюговий конвеєр"
  "quest.14C4C91FBDEDEFE1.quest_desc": [
    "Налаштуйте маршрут перевезення пакунків. Відведіть окрему ділянку для навантаження й розвантаження."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "chapter.0DB57B8AB456839B.title": "&#8C86780.2 • &#7FF0FFC&#7AEBFFr&#74E5FFe&#6FE0FFa&#6ADBFFt&#65D5FFe&#5FD0FF: &#5ACBFFл&#55C5FFа&#50C0FFт&#4ABBFFу&#45B5FFн&#40B0FFь&#3BABFF, &#38A5FFр&#38A0FFі&#379BFFд&#3796FFи&#3790FFн&#378BFFи &#3786FFт&#3681FFа &#367BFFп&#3676FFо&#3671FFї&#356CFFз&#3566FFд&#3561FFи"
  "chapter.0DB57B8AB456839B.chapter_subtitle": [
    "Етап 0 • Реальна водяна пара Create для машин MI"
  ]
  "quest.7FFC96D907B180D6.title": "Латунний корпус"
  "quest.7FFC96D907B180D6.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.00390E102B157A24.title": "Механічний автокрафт"
  "quest.00390E102B157A24.quest_desc": [
    "З'єднайте механічні верстаки в потрібну сітку. Налаштуйте напрямки передачі деталей і вихід готового предмета."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.0E35F29AE82C8168.title": "Подовжений хват"
  "quest.0E35F29AE82C8168.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.77B1020E360B4F4D.title": "Подрібнювальні колеса"
  "quest.77B1020E360B4F4D.quest_desc": [
    "Поставте пару коліс і подайте протилежне обертання. Завантажуйте сировину між ними та збирайте результат знизу."
    "§7Предмети не витрачаються. Візьміть їх до інвентарю для зарахування. Натисніть на предмет завдання, щоб відкрити рецепт у JEI."
  ]
  "quest.708CF77862F7B00D.title": "Картопляна гармата"
  "quest.708CF77862F7B00D.quest_desc": [
    "Розмістіть пристрій у невеликій випробувальній схемі. Для способу підключення використовуйте Ponder, а для матеріалів і операцій — JEI."
