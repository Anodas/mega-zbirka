  ]
  "quest.158A1E15F19019AD.title": "Arcana: якість зачарувань"
  "quest.158A1E15F19019AD.quest_desc": [
    "Arcana впливає на якість набору пропонованих зачарувань. Враховуйте її разом з Eterna та Quanta й не забувайте про вимоги окремих рецептів."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.7ADE91C2392B0A66.title": "Quanta: мінливість результату"
  "quest.7ADE91C2392B0A66.quest_desc": [
    "Quanta змінює розкид можливих результатів. Для точного наповнення дотримуйтеся зазначеного діапазону; більша випадковість не завжди корисна."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.66C7A22C666A046B.title": "Просякнуте дихання дракона"
  "quest.66C7A22C666A046B.quest_desc": [
    "Отримайте цей матеріал через доступні рецепти або перероблення спорядження. Його застосування у розвитку афіксів, самоцвітів і зачаровування перевірте у JEI та Хроніці тіней."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.70DFADE3BF57BBCA.title": "Аметистова брунька"
  "quest.70DFADE3BF57BBCA.quest_desc": [
    "Підготуйте наведені складники й виконайте практичну дію з описаної гілки. Кількості та сумісність перевірте у встановленому рецепті JEI та внутрішньому посібнику мода."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.5F64D6A283904527.title": "Уламок відлуння"
  "quest.5F64D6A283904527.quest_desc": [
    "Підготуйте наведені складники й виконайте практичну дію з описаної гілки. Кількості та сумісність перевірте у встановленому рецепті JEI та внутрішньому посібнику мода."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.1258563CFBAE49D2.title": "Том утилізації"
  "quest.1258563CFBAE49D2.quest_desc": [
    "Том демонтажу дозволяє повернути частину зачарувань. Ознайомтеся з шансами, кількістю збережених чар і долею вихідного предмета; спочатку випробуйте на непотрібному спорядженні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.10A1F7F0B92F384F.title": "Томи зачарувань"
  "quest.10A1F7F0B92F384F.quest_desc": [
    "Томи приймають визначені групи зачарувань. Використовуйте відповідний том для броні, зброї чи інструментів, щоб звузити можливі результати."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.25EDDA4D61400368.title": "Том відмінної утилізації"
  "quest.25EDDA4D61400368.quest_desc": [
    "Том демонтажу дозволяє повернути частину зачарувань. Ознайомтеся з шансами, кількістю збережених чар і долею вихідного предмета; спочатку випробуйте на непотрібному спорядженні."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.6844B30BA17CFBDC.title": "Том вилучення"
  "quest.6844B30BA17CFBDC.quest_desc": [
    "Цей том призначений для певної групи зачарувань або їх вилучення. Перевірте призначення в підказці, подайте сумісний предмет і врахуйте витрати та обмеження операції."
    "§7Предмети завдань не витрачаються. Натисніть на предмет, щоб переглянути рецепт або застосування в JEI."
  ]
  "quest.137184CF4032512D.title": "Том: Шоломи"
  "quest.137184CF4032512D.quest_desc": [
